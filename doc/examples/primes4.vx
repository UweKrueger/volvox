const max_prim := 10000

const max_idx := (max_prim >> 7)

global primes = vec[u64]{}

for i in 0 .. max_idx
	primes.push 0UL
end

n_primes_found = 0

def is_prime(i int) bool
	j = i >> 1
	idx = j >> 6
	mask = 1UL << (j % 64)
	return (primes[idx] & mask) == 0
end

def flag_non_prime(i int)
	j = i >> 1
	idx = j >> 6
	mask = 1UL << (j % 64)
	primes[idx] |= mask
end

echo 2
n_primes_found++

n = 3
while n <= max_prim
	if is_prime n
		echo n
		n_primes_found++
		f = 3 * n
		while f <= max_prim
			flag_non_prime f
			f += n + n
	end end
	n += 2
end

echo "found $n_primes_found primes"
