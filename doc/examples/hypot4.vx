import file
from math import hypot
from error import strerror

# open file for output possibly overwriting existing file
outfile = file.create "results.txt"
if outfile.err != 0
	fecho 2, "Error creating new file \"results.txt\":",
	"${strerror(outfile.err)}"
	exit 1
end

for a in 0.0 .. 10.0
	for b in 0.0 .. 10.0
		c = hypot(a, b)
		outfile.write "$a² + $b² = $c²\n"
end end

return 0
