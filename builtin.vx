type complex {
	real
	imag f64
}

# c32 cannot be declared in the same way is this would not match the ABI of C11 complex float
# it is a compiler builtin, instead

inline fn complex(r real, i real)
	this.real = r
	this.imag = i
end

inline fn c32(r f32, i f32)
	this = r + i * 1fi
end

cdecl __divdc3(ar real, ai real, br real, bi real) complex
cdecl __divsc3(ar f32, ai f32, br f32, bi f32) c32

inline fn complex/(d complex) complex
	return __divdc3(this.real, this.imag, d.real, d.imag)
end

inline fn c32/(d c32) c32
	return __divsc3(this.real, this.imag, d.real, d.imag)
end

inline fn complex/(d f64) complex
	q = 1 / d
	return complex(q * this.real, q * this.imag)
end

inline fn complex/(d imaginary) complex
	q = 1i / d
	return complex(q * this.imag, -q * this.real)
end

inline fn c32/(d f32) c32
	q = 1f / d
	return c32(q * this.real, q * this.imag)
end

inline fn c32/(d j32) c32
	q = 1fi / d
	return c32(q * this.imag, -q * this.real)
end

inline fn f64/(c complex) complex
	return complex(this, 0) / c
end

inline fn f32/(c c32) c32
	return c32(this, 0) / c
end

inline fn imaginary/(c complex) complex
	return complex(0, this / 1i) / c
end

inline fn j32/(c c32) c32
	return c32(0, this / 1fi) / c
end

inline fn complex*(c f64) complex
	return complex{
		real: c * this.real
		imag: c * this.imag
	}
end

inline fn f64*(c complex) complex
	return c * this
end

inline fn complex*(i imaginary) complex
	return complex(-(i / 1i) * this.imag, (i / 1i) * this.real)
end

inline fn imaginary*(c complex) complex
	return c * this
end

inline fn complex*(c complex) complex
	return complex(this.real * c.real - this.imag * c.imag,
		this.real * c.imag + this.imag * c.real)
end

inline fn c32*(f f32) c32
	return c32(this.real * f, this.imag * f)
end

inline fn f32*(c c32) c32
	return c * this
end

inline fn c32*(i j32) c32
	return c32(-(i / 1fi) * this.imag, (i / 1fi) * this.real)
end

inline fn j32*(c c32) c32
	return c * this
end

inline fn c32*(c c32) c32
	return c32(this.real * c.real - this.imag * c.imag,
		this.real * c.imag + this.imag * c.real)
end

inline fn complex+(c complex) complex
	return complex(this.real + c.real, this.imag + c.imag)
end

inline fn complex-(c complex) complex
	return complex(this.real - c.real, this.imag - c.imag)
end

inline fn complex+(r real) complex
	return complex(this.real + r, this.imag)
end

inline fn complex-(r real) complex
	return complex(this.real - r, this.imag)
end

inline fn complex+(i imaginary) complex
	return complex(this.real, this.imag + i / 1i)
end

inline fn complex-(i imaginary) complex
	return complex(this.real, this.imag - i / 1i)
end

inline fn real+(c complex) complex
	return complex(this + c.real, c.imag)
end

inline fn real-(c complex) complex
	return complex(this - c.real, -c.imag)
end

inline fn imaginary+(c complex) complex
	return complex(c.real, this / 1i + c.imag)
end

inline fn imaginary-(c complex) complex
	return complex(-c.real, this / 1i - c.imag)
end

inline fn c32+(c c32) c32
	return c32(this.real + c.real, this.imag + c.imag)
end

inline fn c32-(c c32) c32
	return c32(this.real - c.real, this.imag - c.imag)
end

inline fn c32+(r f32) c32
	return c32(this.real + r, this.imag)
end

inline fn c32-(r f32) c32
	return c32(this.real - r, this.imag)
end

inline fn c32+(i j32) c32
	return c32(this.real, this.imag + i / 1if)
end

inline fn c32-(i j32) c32
	return c32(this.real, this.imag - i / 1if)
end

inline fn f32+(c c32) c32
	return c32(this + c.real, c.imag)
end

inline fn f32-(c c32) c32
	return c32(this - c.real, -c.imag)
end

inline fn j32+(c c32) c32
	return c32(c.real, this / 1if + c.imag)
end

inline fn j32-(c c32) c32
	return c32(-c.real, this / 1if - c.imag)
end

# unary operators

inline fn c32-() c32
	return c32(-this.real, -this.imag)
end

inline fn c32+() c32
	return this
end

inline fn complex-() complex
	return complex(-this.real, -this.imag)
end

inline fn complex+() complex
	return this
end

cdecl(cabsf) abs(c c32) f32
cdecl(cabs) abs(c complex) real

cdecl(cpow) __cpow(b complex, e complex) complex
cdecl(cpowf) __cpow(b c32, e c32) c32

inline fn complex^(e int) complex
	if e < 16
		b = this
		i = u8(e)
		if i & 1
			p = b
		else
			p = 1+0i
		end
		b = b * b
		if i & 2
			p = p * b
		end
		b = b * b
		if i & 4
			p = p * b
		end
		b = b * b
		if i & 8
			p = p * b
		end
		return p
	else
		return __cpow(this, complex(e, 0))
end end

inline fn c32^(e int) c32
	if e >= 0 && e < 16
		b = this
		i = u8(e)
		if i & 1
			p = b
		else
			p = 1f+0fi
		end
		b = b * b
		if i & 2
			p = p * b
		end
		b = b * b
		if i & 4
			p = p * b
		end
		b = b * b
		if i & 8
			p = p * b
		end
		return p
	else
		return __cpow(this, c32(f32(e), 0))
end end

inline fn complex^(e f64) complex
	return __cpow(this, complex(e, 0))
end

inline fn c32^(e f32) c32
	return __cpow(this, c32(e, 0))
end

inline fn complex^(e j64) complex
	return __cpow(this, 0 + e)
end

inline fn c32^(e j32) c32
	return __cpow(this, 0 + e)
end

inline fn complex^(e complex) complex
	return __cpow(this, e)
end

inline fn c32^(e c32) c32
	return __cpow(this, e)
end
