type complex {
	real
	imag f64
}

# the following declaration is only used for the MSVC-ABI
# type __c32 union {
# 	cplx [2]f32
# 	u64
# }

cdecl __divdc3(ar real, ai real, br real, bi real) complex

fn complex/(d complex) complex
	global __OS_Idx
	if __OS_Idx == 8 # os.isWindows
		if abs(d.real) > abs(d.imag)
			q = d.imag / d.real
			div = d.real + q*d.imag
			return complex{
				real: (this.real + q*this.imag) / div
				imag: (this.imag - q*this.real) / div
			}
		else
			q = d.real / d.imag
			div = q*d.real + d.imag
			printf("q: %f, div: %f\n", q, div)
			return complex{
				real: (q*this.real + this.imag) / div
				imag: (q*this.imag - this.real) / div
			}
		end
	else
		return __divdc3(this.real, this.imag, d.real, d.imag)
end end

fn complex*(c f64) complex
	return complex{
		real: c * this.real
		imag: c * this.imag
	}
end

fn f64*(d complex) complex
	return d * this
end

fn int*(d complex) complex
	return d * f64 this
end

