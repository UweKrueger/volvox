inline fn abs(x i8) i8
	return if x < 0; -x else x end
end

inline fn abs(x i16) i16
	return if x < 0; -x else x end
end

inline fn abs(x i32) i32
	return if x < 0; -x else x end
end

inline fn abs(x i64) i64
	return if x < 0; -x else x end
end

