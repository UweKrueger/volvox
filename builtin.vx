inline fn __i32_pow(b i32, e i32) i32
	if e < 0
		if b == 1
			return 1 .
		if b == -1
			if e & 1
				return -1 .
			return 1 .
		return 0 .
	r := 1
	while e != 0
		if (e & 1) != 0
			r *= b .
		e >>= 1
		b *= b .
	return r
