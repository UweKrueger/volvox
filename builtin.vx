inline def panic(s string)
	_printstr(2, s)
	abort
end

inline def panicn(s string)
	_printstrn(2, s)
	abort
end

inline def _abort_if_negative(res ssize_t)
	if res < 0
		__printerr
		abort
end end

inline def _write(fd int, buf cstring, count size_t) ssize_t
	if __Environment_Idx == 2
		# Windows write only allows writing < 2^31 bytes
		# a loop would not be atomic, so there is no real workaround
		if (count >= (1UL << 32))
			panicn "write on Windows only allows buffer size < 2^32\n"
		end
		return __write_windows(fd, buf, u32(count))
	else
		return __write_posix(fd, buf, count)
end end

