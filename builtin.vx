type complex {
	real
	imag f64
}

# c32 cannot be declared in the same way is this would not match the ABI of C11 complex float
# it is a compiler builtin, instead

inline def complex(r real, i real)
	this.real = r
	this.imag = i
end

inline def c32(r f32, i f32)
	this = r + i * 1fi
end

cdecl __divdc3(ar real, ai real, br real, bi real) complex
cdecl __divsc3(ar f32, ai f32, br f32, bi f32) c32

inline def complex/(d complex) complex
	return __divdc3(this.real, this.imag, d.real, d.imag)
end

inline def c32/(d c32) c32
	return __divsc3(this.real, this.imag, d.real, d.imag)
end

inline def complex/(d f64) complex
	q = 1 / d
	return complex(q * this.real, q * this.imag)
end

inline def complex/(d imaginary) complex
	q = 1i / d
	return complex(q * this.imag, -q * this.real)
end

inline def c32/(d f32) c32
	q = 1f / d
	return c32(q * this.real, q * this.imag)
end

inline def c32/(d j32) c32
	q = 1fi / d
	return c32(q * this.imag, -q * this.real)
end

inline def f64/(c complex) complex
	return complex(this, 0) / c
end

inline def f32/(c c32) c32
	return c32(this, 0) / c
end

inline def imaginary/(c complex) complex
	return complex(0, this / 1i) / c
end

inline def j32/(c c32) c32
	return c32(0, this / 1fi) / c
end

inline def complex*(c f64) complex
	return complex{
		real: c * this.real
		imag: c * this.imag
	}
end

inline def f64*(c complex) complex
	return c * this
end

inline def complex*(i imaginary) complex
	return complex(-(i / 1i) * this.imag, (i / 1i) * this.real)
end

inline def imaginary*(c complex) complex
	return c * this
end

inline def complex*(c complex) complex
	return complex(this.real * c.real - this.imag * c.imag,
		this.real * c.imag + this.imag * c.real)
end

inline def c32*(f f32) c32
	return c32(this.real * f, this.imag * f)
end

inline def f32*(c c32) c32
	return c * this
end

inline def c32*(i j32) c32
	return c32(-(i / 1fi) * this.imag, (i / 1fi) * this.real)
end

inline def j32*(c c32) c32
	return c * this
end

inline def c32*(c c32) c32
	return c32(this.real * c.real - this.imag * c.imag,
		this.real * c.imag + this.imag * c.real)
end

inline def complex+(c complex) complex
	return complex(this.real + c.real, this.imag + c.imag)
end

inline def complex-(c complex) complex
	return complex(this.real - c.real, this.imag - c.imag)
end

inline def complex+(r real) complex
	return complex(this.real + r, this.imag)
end

inline def complex-(r real) complex
	return complex(this.real - r, this.imag)
end

inline def complex+(i imaginary) complex
	return complex(this.real, this.imag + i / 1i)
end

inline def complex-(i imaginary) complex
	return complex(this.real, this.imag - i / 1i)
end

inline def real+(c complex) complex
	return complex(this + c.real, c.imag)
end

inline def real-(c complex) complex
	return complex(this - c.real, -c.imag)
end

inline def imaginary+(c complex) complex
	return complex(c.real, this / 1i + c.imag)
end

inline def imaginary-(c complex) complex
	return complex(-c.real, this / 1i - c.imag)
end

inline def c32+(c c32) c32
	return c32(this.real + c.real, this.imag + c.imag)
end

inline def c32-(c c32) c32
	return c32(this.real - c.real, this.imag - c.imag)
end

inline def c32+(r f32) c32
	return c32(this.real + r, this.imag)
end

inline def c32-(r f32) c32
	return c32(this.real - r, this.imag)
end

inline def c32+(i j32) c32
	return c32(this.real, this.imag + i / 1if)
end

inline def c32-(i j32) c32
	return c32(this.real, this.imag - i / 1if)
end

inline def f32+(c c32) c32
	return c32(this + c.real, c.imag)
end

inline def f32-(c c32) c32
	return c32(this - c.real, -c.imag)
end

inline def j32+(c c32) c32
	return c32(c.real, this / 1if + c.imag)
end

inline def j32-(c c32) c32
	return c32(-c.real, this / 1if - c.imag)
end

# unary operators

inline def c32-() c32
	return c32(-this.real, -this.imag)
end

inline def c32+() c32
	return this
end

inline def complex-() complex
	return complex(-this.real, -this.imag)
end

inline def complex+() complex
	return this
end

cdecl(cabsf) abs(c c32) f32
cdecl(cabs) abs(c complex) real

cdecl(cpow) ___cpow(b complex, e complex) complex
cdecl(cpowf) ___cpow(b c32, e c32) c32
cdecl(__cpow) ____cpow(b complex, e complex) complex
cdecl(__cpowf) ____cpow(b c32, e c32) c32

inline def __cpow(b complex, e complex) complex
	if __Environment_Idx == 2 && __LLVM_JIT
		return ____cpow(b, e)
	else
		return ___cpow(b, e)
end end

inline def __cpow(b c32, e c32) c32
	if __Environment_Idx == 2 && __LLVM_JIT
		return ____cpow(b, e)
	else
		return ___cpow(b, e)
end end

inline def complex^(e int) complex
	if e < 16
		b = this
		i = u8(e)
		if i & 1
			p = b
		else
			p = 1+0i
		end
		b = b * b
		if i & 2
			p = p * b
		end
		b = b * b
		if i & 4
			p = p * b
		end
		b = b * b
		if i & 8
			p = p * b
		end
		return p
	else
		return __cpow(this, complex(e, 0))
end end

inline def c32^(e int) c32
	if e >= 0 && e < 16
		b = this
		i = u8(e)
		if i & 1
			p = b
		else
			p = 1f+0fi
		end
		b = b * b
		if i & 2
			p = p * b
		end
		b = b * b
		if i & 4
			p = p * b
		end
		b = b * b
		if i & 8
			p = p * b
		end
		return p
	else
		return __cpow(this, c32(f32(e), 0))
end end

inline def complex^(e f64) complex
	return __cpow(this, complex(e, 0))
end

inline def c32^(e f32) c32
	return __cpow(this, c32(e, 0))
end

inline def complex^(e j64) complex
	return __cpow(this, 0 + e)
end

inline def c32^(e j32) c32
	return __cpow(this, 0 + e)
end

inline def complex^(e complex) complex
	return __cpow(this, e)
end

inline def c32^(e c32) c32
	return __cpow(this, e)
end

type __vec {
	__ptr voidptr
	__size size_t
	__cap size_t
}

def ~__vec
	if bool(this.__ptr)
		# TODO: call destructors for elements
		__free this.__ptr
end end

def __vec(_elem_sz size_t)
	if bool(this.__ptr)
		# copy constructor
		this.__cap = this.__size
		mem_sz = this.__size * _elem_sz
		old_ptr = this.__ptr = __malloc mem_sz
		if !bool(this.__ptr)
			err_printf("vec: unable to allocate memory for %zd elements of size %zd\n", this.__cap, _elem_sz)
			abort
		end
		__memcpy(this.__ptr, old_ptr, mem_sz)
end end

def __vec(_elem_sz size_t, _cap size_t)
	this.__ptr = __malloc(_elem_sz * _cap)
	if bool(this.__ptr)
		this.__cap = _cap
	else
		err_printf("vec: unable to allocate memory for %zd elements of size %zd\n", _cap, _elem_sz)
		abort
end end

inline def __vec.size size_t
	return this.__size
end

inline def __vec.cap size_t
	return this.__cap
end

inline def __vec.__push(_elem_sz size_t, &_elem_ptr voidptr)
	if this.__cap <= this.__size
		this.__cap = this.__cap + this.__cap / 2 + 8 * _elem_sz
		this.__ptr = __realloc(this.__ptr, _elem_sz * this.__cap)
	end
	__memcpy(voidptr(size_t(this.__ptr) + _elem_sz * this.__size++), &_elem_ptr, _elem_sz)
end

inline def __vec.__insert(_elem_sz size_t, &_elem_ptr voidptr, index size_t)
	if (_range_check)
		if (index > this.__size)
			err_printf("vec.insert: insertion index %zd exceeds size %zd\n", index, this.__size)
			abort
	end end
	if this.__cap <= this.__size
		this.__cap = this.__cap + this.__cap / 2 + 8
		this.__ptr = __realloc(this.__ptr, _elem_sz * this.__cap)
	end
	elem_ptr = voidptr(size_t(this.__ptr) + _elem_sz * index)
	elem_ptr_end = voidptr(size_t(elem_ptr) + _elem_sz)
	upper_block_sz = (this.__size - index) * _elem_sz
	__memmove(elem_ptr_end, elem_ptr, upper_block_sz)
	this.__size++
	__memcpy(elem_ptr, &_elem_ptr, _elem_sz)
end

inline def __vec.__pop(_elem_sz size_t)
	if this.__size == 0
		err_printf("vec: pop_back not possible as vec is empty\n")
		abort
	end
	# TODO: call destructor
	this.__size--
end

inline def __vec.__remove(_elem_sz size_t, index size_t)
	elem_ptr = voidptr(size_t(this.__ptr) + _elem_sz * index)
	elem_ptr_end = voidptr(size_t(elem_ptr) + _elem_sz)
	upper_block_sz = (this.__size - index - 1) * _elem_sz
	# TODO: call destructor
	__memmove(elem_ptr, elem_ptr_end, upper_block_sz)
	this.__size--
end

type __closure {
	__fn_ptr voidptr
	__captureds_ptr voidptr
}

def __closure # copy constructor
	if bool(this.__fn_ptr)
		sz = size_t(0)
		# 1st element of captureds-block is its size
		__memcpy(&sz, this.__fn_ptr, sizeof(size_t))
		orig_ptr = this.__fn_ptr
		this.__fn_ptr = __malloc sz
		__memcpy(this.__fn_ptr, orig_ptr, sz)
end end

def ~__closure
	if bool(this.__fn_ptr)
		__free this.__fn_ptr
end end
