inline def echo(...) int
	return __builtin_print(1, false, true, va_args)
end

inline def echoc(...) int
	return __builtin_print(1, true, true, va_args)
end

inline def echon(s cstring) int
	return int(_write(1, s, _strlen(s)))
end

inline def echon(...) int
	return __builtin_print(1, false, false, va_args)
end

inline def eecho(...) int
	return __builtin_print(2, false, true, va_args)
end

inline def eechon(s cstring) int
	return int(_write(2, s, _strlen(s)))
end

inline def eechon(...) int
	return __builtin_print(2, false, false, va_args)
end

# create POSIX/Windows Threads - returns -1 on error, 0 on detach and handle for joinable
cdecl __create_thread(f voidptr, arg voidptr, detached bool) voidptr
cdecl __join_thread(thr voidptr, ctrl_blk voidptr) voidptr
# Windows (non Mingw) specific thread functions
cdecl __get_thread_return_idx(adr voidptr) u32

type __thread_control_block {
	# reference_counter int - not part of type but of shared object
	eventfd_or_pipe_read int
	pipe_write int
}

inline def ~__thread_control_block
	if __OS_Idx != 8 # not Windows
		__close(this.eventfd_or_pipe_read)
		if __OS_Idx != 2 && __OS_Idx != 3 && __OS_Idx != 5
			# all except FreeBSD, Linux, NetBSD
			__close(this.pipe_write)
end end end

type __thread { # LLVM type - FullType is call return type with A_thread
	&control_block __thread_control_block
	handle voidptr
}

