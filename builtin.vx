# Functions that are available without loading any module
# some are implemented in clib of std-libc, some are inline
# and some are hard coded

# use this to trigger informative messages
const _verbose := __VERBOSE
const _range_check := true

# compile builtins
cdecl __load_size(adr voidptr) size_t
cdecl __store_size(adr voidptr, val size_t) size_t

cdecl __string_dup(s voidptr) voidptr
cdecl(malloc) ___malloc(n_bytes size_t) voidptr
cdecl __jit_malloc(n_bytes size_t) voidptr
cdecl(realloc) ___realloc(buf voidptr, n_bytes size_t) voidptr
cdecl __jit_realloc(buf voidptr, n_bytes size_t) voidptr
cdecl(free) ___free(buf voidptr)
cdecl __jit_free(buf voidptr)
cdecl(printf) _printf(s cstring, ...) int

inline def __free(buf voidptr)
	if __LLVM_JIT && __Environment_Idx == 2
		__jit_free buf
	else
		___free buf
end end

inline def __malloc(n_bytes size_t) voidptr
	if __LLVM_JIT && __Environment_Idx == 2
		return __jit_malloc(n_bytes)
	else
		return ___malloc(n_bytes)
end end

inline def __realloc(buf voidptr, n_bytes size_t) voidptr
	if __LLVM_JIT && __Environment_Idx == 2
		return __jit_realloc(buf, n_bytes)
	else
		return ___realloc(buf, n_bytes)
end end

# for debugging purposes
cdecl ___wrnum(p voidptr, z size_t, l size_t)

type string {
	voidptr
}

def ~string
	if bool(this.voidptr)
		cap = __load_size(voidptr(size_t(this.voidptr) + (__OS_Bitwidth>>3)))
		if cap != 0
			len = __load_size(this.voidptr)
			buf = voidptr((size_t(this.voidptr) - len) & !size_t((__OS_Bitwidth>>3)-1))
			# ___wrnum(this.voidptr, cap, len)
			__free(buf)
end end end

def string
	if bool(this.voidptr)
		# _printf "Got String\n"
		cap = __load_size(voidptr(size_t(this.voidptr) + (__OS_Bitwidth>>3)))
		if cap != 0
			this.voidptr = __string_dup(this.voidptr)
end end end

def string(p voidptr)
	this.voidptr = p
	# _printf "Made String from voidptr\n"
end

cdecl __string_add(l voidptr, r voidptr) voidptr
cdecl __string_add_assign(&b voidptr, r voidptr)
cdecl __string_mult(n size_t, r voidptr) voidptr
cdecl __string_add_c_assign(&b voidptr, r cstring)
cdecl __string_mult_assign(&b voidptr, f size_t)
# cdecl __string_make_writable(&s voidptr) voidptr
cdecl strcmp(s1 cstring, s2 cstring) int
cdecl strncmp(s1 cstring, s2 cstring, len size_t) int

inline def string+(s string) string
	r = string(__string_add(this.voidptr, s.voidptr))
	return r
end

inline def string+=(s string)
	__string_add_assign(this.voidptr, s.voidptr)
end

inline def string*(f size_t) string
	r = string(__string_mult(f, this.voidptr))
	return r
end

inline def size_t*(s string) string
	r = string(__string_mult(this, s.voidptr))
	return r
end

inline def string+=(s cstring)
	__string_add_c_assign(this.voidptr, s)
end

inline def string*=(f size_t)
	__string_mult_assign(this.voidptr, f)
end

inline def string.size size_t
	return __load_size(this.voidptr)
end

inline def string.len size_t; return this.size - 1; end

inline def string.cmp(s cstring) int
	return strcmp(cstring voidptr((size_t(this.voidptr) - this.size) & !size_t((__OS_Bitwidth>>3)-1)), s)
end

inline def string<(s cstring) bool
	return this.cmp(s) < 0
end

inline def string==(s cstring) bool
	return this.cmp(s) == 0
end

inline def string>(s cstring) bool
	return this.cmp(s) > 0
end

inline def cstring==(s string) bool; return s == this; end
inline def string!=(c cstring) bool; return !(this == c); end
inline def cstring!=(s string) bool; return s != this; end
inline def cstring>(s string) bool; return s < this; end
inline def cstring<(s string) bool; return s > this; end
inline def string<=(s cstring) bool; return !(s > this); end
inline def string>=(s cstring) bool; return !(s < this); end
inline def cstring>=(s string) bool; return !(s < this); end
inline def cstring<=(s string) bool; return !(s > this); end

