pub def TimeStamp.timespec timespec
	ts = timespec {
		sec: this.u64 / 10000000 - epoch_offset
		nsec: ssize_t((this.u64 % 10000000) * 100)
	}
	return ts
end

def TimeStamp.timespec32 timespec32
	ts32 = timespec32 {
		sec: i32(this.u64 / 10000000 - epoch_offset)
		nsec: i32((this.u64 % 10000000) * 100)
	}
	return ts32
end

pub def timespec.time_t time_t
	return time_t{ i64: this.sec }
end

pub def TimeStamp.time_t time_t
	return time_t{ i64: this.u64 / 10000000 - epoch_offset }
end

# Structure to store real time with 1s precision used on all OSs
# In POSIX the fields as named 'tm_sec', 'tm_min', ...
# We cut the 'tm_' from field elements that have a "human expected" meaning
# Others are prefixed with '_' and virtual attributes are provided
#
type tm {
	sec int      # normally 0..59, may be 60 for leap seconds
	min int      # 0..59
	hour int     # 0..23
	day int      # 1..31
	_mon int     # 0..11
	_year int    # year - 1900, e.g. 123 for 2023
	wday int     # 0..6, 0 = Sunday
	yday int     # normally 0..364, 365 in leap years
	isdst int    # 0/1 to indicate daylight saving time
	# the following are extensions that are not available on all systems
	_gmtoff ssize_t # offset to GMT in seconds
	_zone cstring # time zone name
}

# access methods that adjust field elements to human expected values
#
pub def tm.mon int
	return this._mon + 1
end

pub def tm.mon(m int) int
	old = this._mon = m - 1
	return old + 1
end

pub def tm.year int
	return this._year + 1900
end

pub def tm.year(m int) int
	old = this._year = m - 1900
	return old + 1900
end

cdecl(gmtime_r) gmtime_r32(&t i32, &res tm) voidptr
cdecl(gmtime_r) gmtime_r64(&t i64, &res tm) voidptr
cdecl __gmtime_r50(&t i64, &res tm) voidptr
cdecl __gmtime64_r(&t i64, &res tm) voidptr
cdecl _gmtime64_s(&res tm, &t i64) int
cdecl(localtime_r) localtime_r32(&t i32, &res tm) voidptr
cdecl(localtime_r) localtime_r64(&t i64, &res tm) voidptr
cdecl _localtime64_s(&res tm, &t i64) int
cdecl __localtime_r50(&t i64, &res tm) voidptr
cdecl __localtime64_r(&t i64, &res tm) voidptr

pub inline def time_t.gm tm
	res = tm{}
	if os.isWindows
		_gmtime64_s(res, this.i64)
		return res
	end
	if arch.bitwidth == 32
		if os.isNetBSD
			__gmtime_r50(this.i64, res)
			return res
		elif os.isLinux
			__gmtime64_r(this.i64, res)
			return res
		elif os.isFreeBSD || os.isHaiku
			t = i32(this.i64)
			gmtime_r32(t, res)
			return res
	end end
	gmtime_r64(this.i64, res)
	return res
end

pub inline def time_t.local tm
	res = tm{}
	if os.isWindows
		_localtime64_s(res, this.i64)
		return res
	end
	if arch.bitwidth == 32
		if os.isNetBSD
			__localtime_r50(this.i64, res)
			return res
		elif os.isLinux
			__localtime64_r(this.i64, res)
			return res
		elif os.isFreeBSD || os.isHaiku
			t = i32(this.i64)
			localtime_r32(t, res)
			return res
	end end
	localtime_r64(this.i64, res)
	return res
end

pub inline def timespec.gm tm
	return this.time_t.gm
end

pub inline def timespec.local tm
	return this.time_t.local
end

pub inline def TimeStamp.gm tm
	return this.time_t.gm
end

pub inline def TimeStamp.local tm
	return this.time_t.local
end

pub inline def gm tm
	return time.gm
end

pub inline def local tm
	return time.local
end

cdecl strftime(buf cstring, sz size_t, format cstring, &ts tm) size_t

pub def tm.strf(format string) string
	size_guess = 2 * format.size + (arch.bitwidth >> 2) + 128
	buf = cstring(__malloc(size_guess))
	sz = strftime(buf, size_guess, format, this)
	if (sz > 0)
		return __transformcstr2volvox(buf, size_guess)
	else
		__free voidptr buf
		return ""
end end

pub def tm.str string
	return this.strf("%F %T")
end

pub def tm.date_str string
	return this.strf("%F")
end

pub def tm.time_str string
	return this.strf("%T")
end
