
pub fn TimeStamp.unix() timespec
	ts := timespec {
		sec: ssize_t(this.u64 / 10000000 - epoch_offset)
		nsec: ssize_t((this.u64 % 10000000) * 100)
	}
	return ts


# structure to store real time with 1s precision used on all OSs
# in C all fields are called 'tm_sec'_t, 'tm_min', ...
# we use these names only for elements that are not directly used
#
type tm {
	sec int   # normally 0..59, may be 60 for leap seconds
	min int   # 0..59
	hour int  # 0..23
	day int   # 1..31
	tm_mon int   # 0..11
	tm_year int  # year - 1900, e.g. 123 for 2023
	wday int  # 0..6, 0 = Sunday
	yday int  # normally 0..364, 365 in leap years
	isdst int # 0/1 to indicate daylight saving time
	gmtoff ssize_t # extensions on some systems
	zone cstring
}

# access methods that adjust field elements to human expected values

pub fn tm.month() int
	return this.tm_mon + 1

pub fn tm.month(m int) int
	old := this.tm_mon = m - 1
	return old + 1

pub fn tm.year() int
	return this.tm_year + 1900

pub fn tm.year(m int) int
	old := this.tm_year = m - 1900
	return old + 1900

cdecl fn gmtime_r(&t ssize_t, &res tm) voidptr
cdecl fn _gmtime64_s(&res tm, &t i64) int
cdecl fn _gmtime32_s(&res tm, &t i32) int
cdecl fn localtime_r(&t ssize_t, &res tm) voidptr
cdecl fn _localtime64_s(&res tm, &t i64) int
cdecl fn _localtime32_s(&res tm, &t i32) int

pub inline fn timespec.gm() tm
	res := tm{}
	if os.isWindows
		if os.bitwidth == 32
			t := i32(this.sec)
			_gmtime32_s(res, t)
		else
			t := i64(this.sec)
			_gmtime64_s(res, t) .
	else
		t := this.sec
		gmtime_r(t, res) .
	return res

pub inline fn timespec.local() tm
	res := tm{}
	if os.isWindows
		if os.bitwidth == 32
			t := i32(this.sec)
			_localtime32_s(res, t)
		else
			t := i64(this.sec)
			_localtime64_s(res, t) .
	else
		t := this.sec
		localtime_r(t, res) .
	return res
