pub fn TimeStamp.timespec timespec
	ts := timespec {
		sec: ssize_t(this.u64 / 10000000 - epoch_offset)
		nsec: ssize_t((this.u64 % 10000000) * 100)
	}
	return ts

pub fn timespec.time_t time_t
	return time_t{ sec: this.sec }

pub fn TimeStamp.time_t time_t
	return time_t{ sec: ssize_t(this.u64 / 10000000 - epoch_offset) }

# Structure to store real time with 1s precision used on all OSs
# In POSIX the fields as named 'tm_sec', 'tm_min', ...
# We cut the 'tm_' from field elements that have a "human expected" meaning
# Others are prefixed with '_' and virtual attributes are provided
#
type tm {
	sec int      # normally 0..59, may be 60 for leap seconds
	min int      # 0..59
	hour int     # 0..23
	day int      # 1..31
	_mon int     # 0..11
	_year int    # year - 1900, e.g. 123 for 2023
	wday int     # 0..6, 0 = Sunday
	yday int     # normally 0..364, 365 in leap years
	isdst int    # 0/1 to indicate daylight saving time
	# the following are extensions that are not available on all systems
	_gmtoff ssize_t # offset to GMT in seconds
	_zone cstring # time zone name
}

# access methods that adjust field elements to human expected values
#
pub fn tm.mon int
	return this._mon + 1

pub fn tm.mon(m int) int
	old := this._mon = m - 1
	return old + 1

pub fn tm.year int
	return this._year + 1900

pub fn tm.year(m int) int
	old := this._year = m - 1900
	return old + 1900

cdecl fn gmtime_r(&t ssize_t, &res tm) voidptr
cdecl fn _gmtime64_s(&res tm, &t i64) int
cdecl fn _gmtime32_s(&res tm, &t i32) int
cdecl fn localtime_r(&t ssize_t, &res tm) voidptr
cdecl fn _localtime64_s(&res tm, &t i64) int
cdecl fn _localtime32_s(&res tm, &t i32) int

pub inline fn time_t.gm tm
	res := tm{}
	if os.isWindows
		if arch.bitwidth == 32
			t32 := i32(this.sec)
			_gmtime32_s(res, t32)
		else
			t64 := i64(this.sec)
			_gmtime64_s(res, t64) .
	else
		t := this.sec
		gmtime_r(t, res) .
	return res

pub inline fn time_t.local tm
	res := tm{}
	if os.isWindows
		if arch.bitwidth == 32
			t := i32(this.sec)
			_localtime32_s(res, t)
		else
			t := i64(this.sec)
			_localtime64_s(res, t) .
	else
		t := this.sec
		localtime_r(t, res) .
	return res

pub inline fn timespec.gm tm
	return this.time_t.gm

pub inline fn timespec.local tm
	return this.time_t.local

pub inline fn TimeStamp.gm tm
	return this.time_t.gm

pub inline fn TimeStamp.local tm
	return this.time_t.local

pub inline fn gm tm
	return time.gm

pub inline fn local tm
	return time.local
