# Windows timestamp in 0.1µs resolution
#
type FILETIME {
	dwLowDateTime u32
	dwHighDateTime u32
}
cdecl fn GetSystemTimePreciseAsFileTime(&time FILETIME)

# Unix timestamp in 1ns resolution
#
type timespec {
	sec time_t  # seconds
    nsec ssize_t # nanoseconds, 'long' in C, but on non-Windows this is equal to 'ssize_t'
}
cdecl fn clock_gettime(clockid int, &tp timespec) int

const CLOCK_REALTIME ::= 0
const CLOCK_MONOTONIC ::= if os.isLinux
		4 # CLOCK_MONOTONIC_RAW
	elif os.isOpenBSD
		5 # CLOCK_UPTIME
	elif os.isNetBSD
		3 # CLOCK_MONOTONIC
	elif os.isFreeBSD | os.isDragonFly
		7 # CLOCK_UPTIME_PRECISE
	else
		0 . # fallback if ID is unknown

# In Volvox time intervals are be measured in ticks which are 1n intervals on Unix
# and whatever QueryPerformanceFrequency() reports on Windows.

cdecl fn QueryPerformanceFrequency(&f i64) bool
cdecl fn QueryPerformanceCounter(&ticks i64) bool

# for calculations a constexpr might be handy on Unix systems
const ufrequency ::= 1000000000i64

fn get_system_tick_frequency() i64
	if os.isWindows
		f := 0i64
		if !QueryPerformanceFrequency(f)
			panic("fatal: cannot probe system tick frequency\n") .
		return f
	else
		return ufrequency

pub const tick_frequency := get_system_tick_frequency()

# monotonic timestamps are of type timespec on Unix and LARGE_INTEGER on Windows
# to avoid the clumsy structures Volvox timestamps are i64 on all systems and represent
# the number of ticks since program start. To calculate them we need the (system dependent)
# timestamp when the program has started

type common_timestamp union {
	i64
	timespec
}

fn get_common_timestamp() common_timestamp
	_tmp_ts := common_timestamp{}
	if os.isWindows
		if !QueryPerformanceCounter(_tmp_ts.i64)
			panic("fatal: cannot query system performance counter\n") .
	else
		if clock_gettime(CLOCK_MONOTONIC, _tmp_ts.timespec) != 0
			panic("fatal: cannot query CLOCK_MONOTONIC\n") . .
	return _tmp_ts

const program_start_common_timestamp := get_common_timestamp()

inline fn nanoseconds_since_start(ts timespec) i64
	sec := ts.sec.i64 - program_start_common_timestamp.timespec.sec.i64
	nsec := ts.nsec - program_start_common_timestamp.timespec.nsec
	if nsec < 0
		nsec += ufrequency
		sec--
	elif nsec >= ufrequency
		nsec -= ufrequency
		sec++ .
	return sec * ufrequency + nsec

# read a timestamp as ticks since program start
#
pub inline fn get() i64
	t := 0i64
	tsx := timespec{}
	if os.isWindows
		if !QueryPerformanceCounter(t)
			panic("fatal: cannot query system performance counter\n") .
		return t - program_start_common_timestamp.i64
	else
		if clock_gettime(CLOCK_MONOTONIC, tsx) != 0
			panic("fatal: cannot query CLOCK_MONOTONIC\n") .
		return nanoseconds_since_start(tsx)

# calculate difference of two timestamps as float in seconds
#
pub inline fn diff(finish i64, start i64) f64
	return f64(i64(finish - start) / tick_frequency)

# calculate elapsed time since start
#
pub inline fn elapsed(start i64) f64
	return diff(get(), start)

# calculate elapsed time since program start
#
pub inline fn elapsed() f64
	return f64(get() / tick_frequency)
