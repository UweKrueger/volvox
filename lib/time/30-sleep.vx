
cdecl fn Sleep(ms u32)
cdecl fn nanosleep(&rqtp timespec, &rmtp timespec) int
cdecl fn clock_nanosleep(clockid int, flags int, &rqtp timespec, &rmtp timespec) int

const EINTR ::= 4

# duration in 100ns ticks
#
type Duration {
	i64
}

pub fn Duration(seconds f64)
	this.i64 = i64(seconds * 10000000)
	return

pub inline fn Duration.timespec timespec
	return timespec{
		sec: ssize_t(this.i64 / 10000000)
		nsec: 100 * ssize_t(this.i64 % 10000000)
	}

pub fn sleep(t Duration)
	if t.i64 <= 0
		return
	if os.isWindows
		Sleep(u32(t.i64 / 10000))
	else
		ts := t.timespec
		t_remaining := timespec{}
		sw := false
		repeat
			if sw
				if os.isOpenBSD
					res := nanosleep(t_remaining, ts)
				else
					res := clock_nanosleep(CLOCK_MONOTONIC, 0, t_remaining, ts)
			else
				if os.isOpenBSD
					res := nanosleep(ts, t_remaining)
				else
					res := clock_nanosleep(CLOCK_MONOTONIC, 0, ts, t_remaining) .
				sw = !sw
		until res != EINTR .
	return

pub inline fn sleep(t int)
	sleep(Duration{ i64: t * 10000000 })
	return

pub inline fn sleep(t f64)
	sleep(Duration(t))
	return
