
cdecl fn Sleep(ms u32)
cdecl fn nanosleep(&rqtp timespec, &rmtp timespec) int
pub cdecl fn clock_nanosleep(clockid int, flags int, &rqtp timespec, &rmtp timespec) int
cdecl(clock_nanosleep) fn clock_nanosleep32(clockid int, flags int, &rqtp timespec32, &rmtp timespec32) int

from error import EINTR

# duration in 100ns ticks
#
type Duration {
	i64
}

pub fn Duration(seconds f64)
	this.i64 = i64(seconds * 10000000)
end

pub inline fn Duration.timespec timespec
	return timespec{
		sec: this.i64 / 10000000
		nsec: 100 * i32(this.i64 % 10000000)
	}
end

inline fn Duration.timespec32 timespec32
	return timespec32{
		sec: i32(this.i64 / 10000000)
		nsec: 100 * i32(this.i64 % 10000000)
	}
end

pub fn sleep(t Duration)
	global CLOCK_MONOTONIC, EINTR
	if t.i64 <= 0
		return
	end
	if os.isWindows
		Sleep(u32(t.i64 / 10000))
	elif arch.bitwidth == 32 && (os.isFreeBSD || os.isHaiku)
		ts32 = t.timespec32
		t_remaining32 = timespec32{}
		sw = false
		repeat
			if sw
				res = clock_nanosleep32(CLOCK_MONOTONIC, 0, t_remaining32, ts32)
			else
				res = clock_nanosleep32(CLOCK_MONOTONIC, 0, ts32, t_remaining32)
			end
		until res != EINTR
	else
		ts = t.timespec
		t_remaining = timespec{}
		sw = false
		repeat
			if sw
				if os.isOpenBSD
					res = nanosleep(t_remaining, ts)
				else
					res = clock_nanosleep(CLOCK_MONOTONIC, 0, t_remaining, ts)
				end
			else
				if os.isOpenBSD
					res = nanosleep(ts, t_remaining)
				else
					res = clock_nanosleep(CLOCK_MONOTONIC, 0, ts, t_remaining)
				end
				sw = !sw
			end
		until res != EINTR
	end
end

pub inline fn sleep(t int)
	sleep(Duration{ i64: t * 10000000 })
end

pub inline fn sleep(t f64)
	sleep(Duration(t))
end
