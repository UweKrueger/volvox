import arch
import arch.os

# On most systems there are at least two clocks - earch for a different porpose
# 1. a "real time" clock that shows wall clock time
#   - time is stored as UTC - you may call '.local()' to get the representation for your timezone
#   - the time might "jump" if the system clock is set
#   -> use this clock when you want to know what time it is
# 2. a "monotonic" clock that continues without jumps
#   - was started at some arbitrary point of time in the past (often when the systems was booted)
#   -> use this clock to measure time intervals or durations

# Unix timestamp in 1ns resolution
#
type timespec {
	sec ssize_t  # seconds
    nsec ssize_t # nanoseconds
}

# "REALTIME" and "MONOTONIC" clocks on Unix systems

pub const CLOCK_REALTIME ::= if os.isHaiku
		-1
	else
		0
	end

pub const CLOCK_MONOTONIC ::= if os.isLinux
		1
	elif os.isOpenBSD || os.isNetBSD
		3
	elif os.isFreeBSD || os.isDragonFly
		4
	else
		0 # fall back to CLOCK_REALTIME if no MONOTONIC clock is known
	end

# Unix function to get precise time from a specific clock
#
pub cdecl fn clock_gettime(clockid int, &tp timespec) int

# In Volvox time intervals are be measured in "ticks" which are 1n intervals on Unix
# and whatever QueryPerformanceFrequency() reports on Windows.

# Windows function to get tick frequency of monotonic clock
#
cdecl fn QueryPerformanceFrequency(&f i64) bool

# Windows function to read monotonic clock
#
pub cdecl(QueryPerformanceCounter) fn _QueryPerformanceCounter(&ticks i64) bool

# for calculations a constexpr might be handy on Unix systems
const ufrequency ::= 1000000000

fn get_system_tick_frequency() int
	global ufrequency
	if os.isWindows
		f = 0i64
		if !QueryPerformanceFrequency(f)
			panic("fatal: cannot probe system tick frequency\n")
		end
		return int(f)
	else
		return ufrequency
	end

pub const tick_frequency = get_system_tick_frequency()
pub const tick_period = 1.0f64 / tick_frequency

# monotonic timestamps are of type 'timespec' on Unix and 'LARGE_INTEGER' on Windows
# to avoid the clumsy timespec structure, Volvox timestamps are i64 on all systems and represent
# the number of ticks since program start. To calculate them we need the (system dependent)
# timestamp when the program has started as a base

type common_timestamp union {
	i64
	timespec
}

fn get_common_timestamp() common_timestamp
	global CLOCK_MONOTONIC
	_tmp_ts = common_timestamp{}
	if os.isWindows
		if !_QueryPerformanceCounter(_tmp_ts.i64)
			panic("fatal: cannot query system performance counter\n")
		end
	else
		if clock_gettime(CLOCK_MONOTONIC, _tmp_ts.timespec) != 0
			panic("fatal: cannot query CLOCK_MONOTONIC\n")
		end
	end
	return _tmp_ts

const program_start_common_timestamp = get_common_timestamp()

# difference of two timespec values in ns
#
pub inline fn timespec_diff(&finish timespec, &start timespec) timespec
	global ufrequency
	res = timespec {
		sec: finish.sec - start.sec
		nsec : finish.nsec - start.nsec
	}
	if res.nsec < 0
		res.nsec += ufrequency
		res.sec--
	end
	return res

pub inline fn timespec_sum(t1 timespec, t2 timespec) timespec
	global ufrequency
	res = timespec{
		sec: t1.sec + t2.sec
		nsec: t1.nsec + t2.nsec
	}
	if res.nsec >= ufrequency
		res.nsec -= ufrequency
		res.sec++
	end
	return res

inline fn nanoseconds_since_start(ts timespec) i64
	global ufrequency, program_start_common_timestamp
	d = timespec_diff(ts, program_start_common_timestamp.timespec)
	return i64(ufrequency) * d.sec + d.nsec

# read a timestamp as ticks since program start
#
pub inline fn get() i64
	global CLOCK_MONOTONIC, program_start_common_timestamp
	if os.isWindows
		t = 0i64
		if !_QueryPerformanceCounter(t)
			panic("fatal: cannot query system performance counter\n")
		end
		return t - program_start_common_timestamp.i64
	else
		tsx = timespec{}
		if clock_gettime(CLOCK_MONOTONIC, tsx) != 0
			panic("fatal: cannot query CLOCK_MONOTONIC\n")
		end
		return nanoseconds_since_start(tsx)
	end

# calculate difference of two timestamps as float in seconds
#
pub inline fn diff(finish i64, start i64) f64
	global tick_period
	return f64(i64(finish - start)) * tick_period

# Windows timestamp in 0.1µs resolution
#
type FILETIME {
	dwLowDateTime u32
	dwHighDateTime u32
}

# time in 100ns ticks since January 1, 1601 00:00:00 UTC
#
type TimeStamp {
	u64
}

# Microsoft discourages from treating FILETIME as u64 because of different alignment constraints,
# i.e. if you get a FILETIME value from the system it might have 32 bit alignment.
# However, here we provides the allocation space ourselves and we always pass this
# allocation by reference to get a value from the system. So we can make sure
# it's always aligned like a 64 bit type.

type _TimeStamp union {
	FILETIME
	TimeStamp
}

# seconds of January 1, 1970 since January 1, 1601
#
pub const epoch_offset ::= 11644473600

cdecl fn GetSystemTimePreciseAsFileTime(&time FILETIME)

# get 0.1µs ticks since January 1, 1601 (in field u64)
#
pub inline fn now() TimeStamp
	global CLOCK_REALTIME, epoch_offset
	ft = _TimeStamp{}
	if os.isWindows
		GetSystemTimePreciseAsFileTime(ft.FILETIME)
	else
		ts = timespec{}
		clock_gettime(CLOCK_REALTIME, ts)
		# calculate "(1e7 * ts.sec + epoch_offset) + ts.nsec / 100" avoiding division
		ft.TimeStamp.u64 = 10000000 * (u64(ts.sec) + epoch_offset) + ((u64(ts.nsec) * 42949673) >> 32)
	end
	return ft.TimeStamp


cdecl(time) fn _time(nn size_t) ssize_t
cdecl fn _time64(nn size_t) i64
cdecl fn _time32(nn size_t) i32

type time_t {
	sec ssize_t
}

pub inline fn time() time_t
	t = time_t{}
	if os.isWindows
		if arch.bitwidth == 32
			t.sec = ssize_t(_time32(0))
		else
			t.sec = ssize_t(_time64(0))
		end
	else
		t.sec = _time(0)
	end
	return t
