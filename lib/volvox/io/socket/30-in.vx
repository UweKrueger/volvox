struct IpSocket {
	handle ssize_t
	err u32
}

import arch

pub inline def htons(x u16) u16
	if arch.isLittleEndian
		return (x >> 8) | (x << 8)
	else
		return x
	end
end

pub inline def htonl(x u32) u32
	if arch.isLittleEndian
		return (x >> 24) | ((x & 0xff0000) >> 8) | ((x & 0xff00) << 8) | (x << 24)
	else
		return x
	end
end

union in_addr {
	__s4_addr [4]u8
	u32
}

struct sockaddr_in {
	sin_family u16
	sin_port u16
	sin_addr in_addr
	sin_zero [8]u8
}

pub inline def tcp IpSocket
	s = IpSocket{}
	if os.isWindows
		s.handle = win_socket(AF_INET, SOCK_STREAM, 0)
		if s.handle == -1
			s.err = u32(WSAGetLastError())
		end
	else
		s.handle = socket(AF_INET, SOCK_STREAM, 0)
		if s.handle == -1
			s.err = GetLastError
		end
	end
	return s
end

pub inline def udp IpSocket
	s = IpSocket{}
	if os.isWindows
		s.handle = win_socket(AF_INET, SOCK_DGRAM, 0)
		if s.handle == -1
			s.err = u32(WSAGetLastError)
		end
	else
		s.handle = socket(AF_INET, SOCK_DGRAM, 0)
		if s.handle == -1
			s.err = GetLastError
		end
	end
	return s
end

pub const in_any       := in_addr{ __s4_addr: { 0, 0, 0, 0 } }
pub const in_broadcast := in_addr{ __s4_addr: { 255, 255, 255, 255 } }
pub const in_none      := in_addr{ __s4_addr: { 255, 255, 255, 255 } }
pub const in_loopback  := in_addr{ __s4_addr: { 127, 0, 0, 1 } }
