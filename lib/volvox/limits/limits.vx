# max and min values for different types
# all values are defined "untyped"

# unsigned types (only max values are defined - min value is always 0)
#
pub const u64_max := 0xffffffffffffffff
pub const u32_max := 0xffffffff
pub const u16_max := 0xffff
pub const u8_max  := 0xff

# signed int types max and min values
#
pub const i64_max := 0x7fffffffffffffff
pub const i64_min := -1 - i64_max
pub const i32_max := 0x7fffffff
pub const i32_min := -1 - i32_max
pub const int_max := i32_max
pub const int_min := i32_min
pub const i16_max := 0x7fff
pub const i16_min := -1 - i16_max
pub const i8_max := 0x7f
pub const i8_min := -1 - i8_max

# float type limits - min values refer to minimum positive non-denormal numbers
#
pub const f64_min := 0x1p-1022
pub const f64_max := 0x1.fffffffffffffp+1023

# difference between smallest number >1 and 1 or the steps betwenn consecutive
# numbers in the interval [1.0; 2.0)
# it is NOT the difference between ANY consecutive numbers nor the smallest representable float number
#
pub const f64_epsilon := 0x1.0000000000001 - 1

# 32 bit floats
#
pub const f32_min := 0x1p-126
pub const f32_max := 0x1.fffffp+127
pub const f32_epsilon := 0x1.000002p0 - 1
