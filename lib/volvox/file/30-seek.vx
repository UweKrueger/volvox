# POSIX seek functions using off_t = int64_t
cdecl fseeko(f voidptr, offset i64, whence int) int
cdecl ftello(f voidptr) i64

# Linux 32 versions
cdecl fseeko64(f voidptr, offset i64, whence int) int
cdecl ftello64(f voidptr) i64

# Windows version
cdecl _fseeki64(f voidptr, offset i64, origin int) int
cdecl _ftelli64(f voidptr)

pub const SEEK_SET := 0
pub const SEEK_CUR := 1
pub const SEEK_END := 2

inline def __fseek(f voidptr, offset i64, whence int) int
	if os.isWindows
		return _fseeki64(f, offset, whence)
	elif arch.bitwidth == 32 && os.isLinux
		return fseeko64(f, offset, whence)
	else
		return fseeko(f, offset, whence)
end	end

pub def File.seek(offset i64, whence int) bool
	if __fseek(this.voidptr, offset, whence) == 0
		return true
	end
	this.err = GetLastError
	return false
end

pub def File.seek_set(offset i64) bool
	return this.seek(offset, SEEK_SET)
end

pub def File.seek_cur(offset i64) bool
	return this.seek(offset, SEEK_CUR)
end

pub def File.seek_end(offset i64) bool
	return this.seek(offset, SEEK_END)
end

pub def File.tell i64
	if os.isWindows
		return _ftelli64(this.voidptr)
	elif arch.bitwidth == 32 && os.isLinux
		return ftello64(this.voidptr)
	else
		return ftello(this.voidptr)
end	end
