const pub e := 2.7182818284590452354

pub cdecl cbrt(x f64) f64
pub cdecl erf(x f64) f64
pub cdecl erfc(x f64) f64
pub cdecl exp(x f64) f64
pub cdecl exp2(x f64) f64
pub cdecl expm1(x f64) f64
pub cdecl ilogb(x f64) i32
pub cdecl j0(x f64) f64
pub cdecl j1(x f64) f64
pub cdecl jn(n i32, x f64) f64
pub cdecl ldexp(x f64) f64
pub cdecl lgamma(x f64) f64
pub cdecl tgamma(x f64) f64
pub cdecl log(x f64) f64
pub cdecl log1p(x f64) f64
pub cdecl log2(x f64) f64
pub cdecl logb(x f64) f64
pub cdecl sqrt(x f64) f64
pub cdecl y0(x f64) f64
pub cdecl y1(x f64) f64
pub cdecl yn(n i32, x f64) f64

pub cdecl(cbrtf) cbrt(x f32) f32
pub cdecl(erff) erf(x f32) f32
pub cdecl(erfcf) erfc(x f32) f32
pub cdecl(expf) exp(x f32) f32
pub cdecl(exp2f) exp2(x f32) f32
pub cdecl(expm1f) expm1(x f32) f32
pub cdecl(ilogbf) ilogb(x f32) i32
pub cdecl(j0f) j0(x f32) f32
pub cdecl(j1f) j1(x f32) f32
pub cdecl(jnf) jn(n i32, x f32) f32
pub cdecl(ldexpf) ldexp(x f32) f32
pub cdecl(lgammaf) lgamma(x f32) f32
pub cdecl(tgammaf) tgamma(x f32) f32
pub cdecl(logf) log(x f32) f32
pub cdecl(log1pf) log1p(x f32) f32
pub cdecl(log2f) log2(x f32) f32
pub cdecl(logbf) logb(x f32) f32
pub cdecl(sqrtf) sqrt(x f32) f32
pub cdecl(y0f) y0(x f32) f32
pub cdecl(y1f) y1(x f32) f32
