# constants describing the platform the program is running on

# true: we are running inside JIT engine - false: native code compile
#
pub const isJIT ::= __LLVM_JIT

# size in bits for pointers and size_t
#
pub const bitwidth ::= __OS_Bitwidth

# byte order big/little endian
#
pub const isLittleEndian ::= __ARCH_LITTLE_ENDIAN
pub const isBigEndian ::= !__ARCH_LITTLE_ENDIAN
