# This is a fixed-increment version of Java 8's SplittableRandom generator
# See http://dx.doi.org/10.1145/2714064.2660195 and 
# http://docs.oracle.com/javase/8/docs/api/java/util/SplittableRandom.html

# It is a very fast generator passing BigCrush, and it can be useful if
# for some reason you absolutely want 64 bits of state.

import arch.os

# OS specific functions to get 8 "really" random bytes to seed this RND
#
cdecl fn getrandom(&buf u64, n size_t, flags u32) ssize_t
cdecl fn arc4random_buf(&buf u64, n size_t)
type FILETIME {
	dwLowDateTime u32
	dwHighDateTime u32
}
cdecl fn GetSystemTimePreciseAsFileTime(&time FILETIME)

x0 = 0u64
t = FILETIME{}
if os.isLinux || os.isFreeBSD || os.isDragonFly || os.isNetBSD
	getrandom(x0, 8, 0)
elif os.isOpenBSD
	arc4random_buf(x0, 8)
elif os.isWindows
	# in principle RtlGenRandom() or CryptGenRandom() would be the
	# Windows functions that correspond to getrandom(), however those
	# would require linking against advapi32.dll which would be an
	# overshoot just to get 8 random bytes. Let's use a sub-microsecond
	# clock instead...
	GetSystemTimePreciseAsFileTime(t)
	# switch low/high parts for x0 to get more randomness in high bits
	x0 = t.dwHighDateTime | (t.dwLowDateTime << 32)
end

atomic x = x0 + 0x9e3779b97f4a7c15u64 # The state can be seeded with any value.

pub fn splitmix64 u64
	global x
	z = (x += 0x9e3779b97f4a7c15)
	z = (z >< (z >> 30)) * 0xbf58476d1ce4e5b9
	z = (z >< (z >> 27)) * 0x94d049bb133111eb
	return z >< (z >> 31)
