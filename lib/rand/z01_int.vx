pub inline fn i64
	this = i64(u64)
end

pub inline fn u32
	this = u32(u64)
end

pub inline fn i32
	this = i32(u64)
end

pub inline fn int
	this = int(u64)
end

pub inline fn u16
	this = u16(u64)
end

pub inline fn i16
	this = i16(u64)
end

pub inline fn u8
	this = u8(u64)
end

pub inline fn i8
	this = i8(u64)
end

# overloaded function that take a maximum value

pub inline fn n(max u64) u64
	mask = max
	mask |= (mask >> 1)
	mask |= (mask >> 2)
	mask |= (mask >> 4)
	mask |= (mask >> 8)
	mask |= (mask >> 16)
	mask |= (mask >> 32)
	repeat
		res = u64 & mask
	until res <= max
	return res
end

pub inline fn n(max u32) u32
	mask = max
	mask |= (mask >> 1)
	mask |= (mask >> 2)
	mask |= (mask >> 4)
	mask |= (mask >> 8)
	mask |= (mask >> 16)
	repeat
		res = u32(u64) & mask
	until res <= max
	return res
end

pub inline fn n(max u16) u16
	mask = max
	mask |= (mask >> 1)
	mask |= (mask >> 2)
	mask |= (mask >> 4)
	mask |= (mask >> 8)
	repeat
		res = u16(u64) & mask
	until res <= max
	return res
end

pub inline fn n(max u8) u8
	mask = max
	mask |= (mask >> 1)
	mask |= (mask >> 2)
	mask |= (mask >> 4)
	repeat
		res = u8(u64) & mask
	until res <= max
	return res
end

# The functions above take an unsigned argument, i.e. none of
# them would be selected in case of a signed argument.
# The functions below are simple wrappers for these cases -
# they take a (non-negative) signed argument 'max' value
# a return a random signed value in the range 0..max (both including).

pub inline fn n(max i64) i64
	return i64(u64(max))
end

pub inline fn n(max i32) i32
	return i32(n(u32(max)))
end

pub inline fn n(max i16) i16
	return i16(n(u16(max)))
end

pub inline fn n(max i8) i8
	return i8(n(u8(max)))
end

pub inline fn i64(min i64, max i64)
	delta = u64(max - min)
	this = min + n(delta)
end

pub inline fn i32(min i32, max i32)
	delta = u32(max - min)
	this = min + n(delta)
end

pub inline fn i16(min i16, max i16)
	delta = u16(max - min)
	this = min + n(delta)
end

pub inline fn i8(min i8, max i8)
	delta = u8(max - min)
	this = min + n(delta)
end
