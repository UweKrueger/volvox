pub inline def i64
	this = i64(u64)
end

pub inline def u32
	this = u32(u64)
end

pub inline def i32
	this = i32(u64)
end

pub inline def int
	this = int(u64)
end

pub inline def u16
	this = u16(u64)
end

pub inline def i16
	this = i16(u64)
end

pub inline def u8
	this = u8(u64)
end

pub inline def i8
	this = i8(u64)
end

# overloaded function that take a maximum value

# we overload builtin conversions so save them before
inline def _u64(i u64) u64
	return u64(i)
end

pub inline def u64(max u64)
	mask = max
	mask |= (mask >> 1)
	mask |= (mask >> 2)
	mask |= (mask >> 4)
	mask |= (mask >> 8)
	mask |= (mask >> 16)
	mask |= (mask >> 32)
	repeat
		res = u64 & mask
	until res <= max
	this = res
end

inline def _u32(i u64) u32
	return u32(i)
end

pub inline def u32(max u32)
	mask = max
	mask |= (mask >> 1)
	mask |= (mask >> 2)
	mask |= (mask >> 4)
	mask |= (mask >> 8)
	mask |= (mask >> 16)
	repeat
		res = _u32(u64) & mask
	until res <= max
	this = res
end

inline def _u16(i u64) u16
	return u16(i)
end

pub inline def u16(max u16)
	mask = max
	mask |= (mask >> 1)
	mask |= (mask >> 2)
	mask |= (mask >> 4)
	mask |= (mask >> 8)
	repeat
		res = _u16(u64) & mask
	until res <= max
	this = res
end

inline def _u8(i u64) u8
	return u8(i)
end

pub inline def u8(max u8)
	mask = max
	mask |= (mask >> 1)
	mask |= (mask >> 2)
	mask |= (mask >> 4)
	repeat
		res = _u8(u64) & mask
	until res <= max
	this = res
end

# The functions above take an unsigned argument, i.e. none of
# them would be selected in case of a signed argument.
# The functions below are simple wrappers for these cases -
# they take a (non-negative) signed argument 'max' value
# a return a random signed value in the range 0..max (both including).

inline def _i64(u u64) i64
	return i64(u)
end

pub inline def i64(max i64)
	this = _i64(u64(max))
end

inline def _i32(u u32) i32
	return i32(u)
end

pub inline def i32(max i32)
	this = _i32(u32(max))
end

inline def _i16(u u16) i16
	return i16(u)
end

pub inline def i16(max i16)
	this = _i16(u16(max))
end

inline def _i8(u u8) i8
	return i8(u)
end

pub inline def i8(max i8)
	this = _i8(u8(max))
end

pub inline def i64(min i64, max i64)
	this = min + u64(max - min)
end

pub inline def i32(min i32, max i32)
	this = min + u32(max - min)
end

pub inline def i16(min i16, max i16)
	this = min + u16(max - min)
end

pub inline def i8(min i8, max i8)
	this = min + u8(max - min)
end
