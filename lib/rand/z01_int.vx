pub inline def i64
	this = i64(u64)
end

pub inline def u32
	this = u32(u64)
end

pub inline def i32
	this = i32(u64)
end

pub inline def int
	this = int(u64)
end

pub inline def u16
	this = u16(u64)
end

pub inline def i16
	this = i16(u64)
end

pub inline def u8
	this = u8(u64)
end

pub inline def i8
	this = i8(u64)
end

# overloaded function that take a maximum value
# these functions shadow builtin explicit conversions so
# we have to create aliases to those conversions first

inline def _u64(i u64) u64
	return u64(i)
end

pub inline def u64(max_value u64)
	mask = max_value
	mask |= (mask >> 1)
	mask |= (mask >> 2)
	mask |= (mask >> 4)
	mask |= (mask >> 8)
	mask |= (mask >> 16)
	mask |= (mask >> 32)
	repeat
		res = u64 & mask
	until res <= max_value
	this = res
end

inline def _u32(i u64) u32
	return u32(i)
end

pub inline def u32(max_value u32)
	mask = max_value
	mask |= (mask >> 1)
	mask |= (mask >> 2)
	mask |= (mask >> 4)
	mask |= (mask >> 8)
	mask |= (mask >> 16)
	repeat
		res = _u32(u64) & mask
	until res <= max_value
	this = res
end

inline def _u16(i u64) u16
	return u16(i)
end

pub inline def u16(max_value u16)
	mask = max_value
	mask |= (mask >> 1)
	mask |= (mask >> 2)
	mask |= (mask >> 4)
	mask |= (mask >> 8)
	repeat
		res = _u16(u64) & mask
	until res <= max_value
	this = res
end

inline def _u8(i u64) u8
	return u8(i)
end

pub inline def u8(max_value u8)
	mask = max_value
	mask |= (mask >> 1)
	mask |= (mask >> 2)
	mask |= (mask >> 4)
	repeat
		res = _u8(u64) & mask
	until res <= max_value
	this = res
end

# The functions above take an unsigned argument, i.e. none of
# them would be selected in case of a signed argument.
# The functions below are simple wrappers for these cases -
# they take a signed argument 'limit' and
# return a random signed value in the range 0..limit
# or limit..0 (all including).

inline def _i64(u u64) i64
	return i64(u)
end

pub inline def i64(limit i64)
	this = limit >= 0 ? _i64(u64(limit)) : -_i64(u64(-limit))
end

inline def _i32(u u32) i32
	return i32(u)
end

pub inline def i32(limit i32)
	this = limit >= 0 ? _i32(u32(limit)) : -_i32(u32(-limit))
end

inline def _i16(u u16) i16
	return i16(u)
end

pub inline def i16(limit i16)
	this = limit >= 0 ? _i16(u16(limit)) : -_i16(u16(-limit))
end

inline def _i8(u u8) i8
	return i8(u)
end

pub inline def i8(limit i8)
	this = limit >= 0 ? _i8(u8(limit)) : -_i8(u8(-limit))
end

pub inline def i64(min_value i64, max_value i64)
	this = min_value + u64(max_value - min_value)
end

pub inline def i32(min_value i32, max_value i32)
	this = min_value + u32(max_value - min_value)
end

pub inline def i16(min_value i16, max_value i16)
	this = min_value + u16(max_value - min_value)
end

pub inline def i8(min_value i8, max_value i8)
	this = min_value + u8(max_value - min_value)
end
