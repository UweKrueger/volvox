# This is xoshiro256** 1.0, one of our all-purpose, rock-solid
# generators. It has excellent (sub-ns) speed, a state (256 bits) that is
# large enough for any parallel application, and it passes all tests we
# are aware of.

# For generating just floating-point numbers, xoshiro256+ is even faster.

# The state must be seeded so that it is not everywhere zero. If you have
# a 64-bit seed, we suggest to seed a splitmix64 generator and use its
# output to fill s.

import arch.cpu
from limits import *

inline fn rotl(x u64, k int) u64
	return (x << k) | (x >> (64 - k))

type State4 {
	s [4]u64
}

# defaut constructor that is called for every new thread
#
fn State4()
	this.s[0] = splitmix64()
	this.s[1] = splitmix64()
	this.s[2] = splitmix64()
	this.s[3] = splitmix64()
	return

# thread local state
#
global s := State4{}

# function names for random functions are the same as the type they produce but with uppercase
# letter because type names are not allowed for (non-constructor) function names

# main RNG producing 64 bits
#
pub inline fn U64() u64
	result := rotl(s.s[1] + (s.s[1] << 2), 7)
	result += (result << 3)
	t := s.s[1] << 17
	s.s[2] ><= s.s[0]
	s.s[3] ><= s.s[1]
	s.s[1] ><= s.s[2]
	s.s[0] ><= s.s[3]
	s.s[2] ><= t
	s.s[3] = rotl(s.s[3], 45)
	return result

pub inline fn I64() i64
	return i64(U64())

pub inline fn U32() u32
	return u32(U64())

pub inline fn I32() i32
	return i32(U64())

pub inline fn U16() u16
	return u16(U64())

pub inline fn I16() i16
	return i16(U64())

pub inline fn U8() u8
	return u8(U64())

pub inline fn I8() i8
	return i8(U64())

type Fu64 union {
	f f64
	u u64
}

const avoid_multiplication ::= !cpu.isX86_64
const compensate_for_53rd_bit ::= cpu.isX86

# create an equally distributed random real in the range [0; 1)
#
pub inline fn F64() f64
	if avoid_multiplication
		# this code is for CPUs on which multiplications are expensive
		r0 := U64()
		x := Fu64{}
		x.u = r0
		# this code assumes IEEE-754 representation
		x.u &= (1 << 52) - 1 # mask the mantissa
		x.u |= 0x3ff << 52
		x.f -= 1
		if compensate_for_53rd_bit
			# the result only contains 52 bits of information i.e. the "last" bit is always 0
			# we can compensate this by adding epsilon/2 with a probability of 50%
			mask := 0u64 - (r0 >> 63)
			c := Fu64{}
			c.f = 0.5 * epsilon64
			c.u &= mask
			x.f += c.f .
		return x.f
	else
		return u64(U64() & ((1 << 53) - 1)) * 0x1.0p-53
