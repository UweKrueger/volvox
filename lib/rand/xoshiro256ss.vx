# This is xoshiro256** 1.0, one of our all-purpose, rock-solid
# generators. It has excellent (sub-ns) speed, a state (256 bits) that is
# large enough for any parallel application, and it passes all tests we
# are aware of.

# For generating just floating-point numbers, xoshiro256+ is even faster.

# The state must be seeded so that it is not everywhere zero. If you have
# a 64-bit seed, we suggest to seed a splitmix64 generator and use its
# output to fill s.

import arch.cpu
from limits import *

inline fn rotl(x u64, k int) u64
	return (x << k) | (x >> (64 - k))
end

type State4 {
	s [4]u64
}

# defaut constructor that is called for every new thread
#
fn State4
	this.s[0] = splitmix64
	this.s[1] = splitmix64
	this.s[2] = splitmix64
	this.s[3] = splitmix64
end

# thread local state
#
global s = State4{}

# function names for random functions are the same as the type they produce but with uppercase
# letter because type names are not allowed for (non-constructor) function names

# main RNG producing 64 bits
#
pub inline fn U64 u64
	global s
	result = rotl(s.s[1] + (s.s[1] << 2), 7)
	result += (result << 3)
	t = s.s[1] << 17
	s.s[2] ><= s.s[0]
	s.s[3] ><= s.s[1]
	s.s[1] ><= s.s[2]
	s.s[0] ><= s.s[3]
	s.s[2] ><= t
	s.s[3] = rotl(s.s[3], 45)
	return result
end

