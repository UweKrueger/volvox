pub inline fn cbrt(x f64) f64
	return __cbrt(x)

pub inline fn erf(x f64) f64
	return __erf(x)

pub inline fn erfc(x f64) f64
	return __erfc(x)

pub inline fn exp(x f64) f64
	return __exp(x)

pub inline fn exp2(x f64) f64
	return __exp2(x)

pub inline fn expm1(x f64) f64
	return __expm1(x)

pub inline fn hypot(x f64, y f64) f64
	return __hypot(x, y)

pub inline fn ilogb(x f64) i32
	return __ilogb(x)

pub inline fn j0(x f64) f64
	return __j0(x)

pub inline fn j1(x f64) f64
	return __j1(x)

pub inline fn jn(n i32, x f64) f64
