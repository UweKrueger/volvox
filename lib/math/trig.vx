# C functions for "double"
pub cdecl fn sin(x f64) f64
pub cdecl fn cos(x f64) f64
pub cdecl fn tan(x f64) f64
pub cdecl fn asin(x f64) f64
pub cdecl fn acos(x f64) f64
pub cdecl fn atan(x f64) f64
pub cdecl fn atan2(y f64, x f64) f64
pub cdecl fn sinh(x f64) f64
pub cdecl fn cosh(x f64) f64
pub cdecl fn tanh(x f64) f64
pub cdecl fn asinh(x f64) f64
pub cdecl fn acosh(x f64) f64
pub cdecl fn atanh(x f64) f64
# C functions for "float"
pub cdecl(sin) fn sinf(x f32) f32
pub cdecl(cos) fn cosf(x f32) f32
pub cdecl(tan) fn tanf(x f32) f32
pub cdecl(asin) fn asinf(x f32) f32
pub cdecl(acos) fn acosf(x f32) f32
pub cdecl(atan) fn atanf(x f32) f32
pub cdecl(atan2) fn atan2f(y f32, x f32) f32
pub cdecl(sinh) fn sinhf(x f32) f32
pub cdecl(cosh) fn coshf(x f32) f32
pub cdecl(tanh) fn tanhf(x f32) f32
pub cdecl(asinh) fn asinhf(x f32) f32
pub cdecl(acosh) fn acoshf(x f32) f32
pub cdecl(atanh) fn atanhf(x f32) f32
