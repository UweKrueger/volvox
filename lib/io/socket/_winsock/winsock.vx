# Windows specific part of socket library - do not import directly

import arch
import arch.os

if os.isWindows
	__link_extra "Ws2_32"
elif os.isHaiku
	__link_extra "network"
end

const WSADESCRIPTION_LEN := 256
const WSASYS_STATUS_LEN := 128

type WSAData32 {
	wVersion       u16
	wHighVersion   u16
	szDescription  [WSADESCRIPTION_LEN+1]u8
	szSystemStatus [WSASYS_STATUS_LEN+1]u8
	iMaxSockets    u16
	iMaxUdpDg      u16
	lpVendorInfo   cstring
}

type WSAData64 {
	wVersion       u16
	wHighVersion   u16
	iMaxSockets    u16
	iMaxUdpDg      u16
	lpVendorInfo   cstring
	szDescription  [WSADESCRIPTION_LEN+1]u8
	szSystemStatus [WSASYS_STATUS_LEN+1]u8
}

cdecl(WSAStartup) WSAStartup32(wVersionRequested u16, &lpWSAData WSAData32) int
cdecl(WSAStartup) WSAStartup64(wVersionRequested u16, &lpWSAData WSAData64) int
cdecl WSACleanup() int

type WsockProto {
	int
}

inline def WsockProto
	if os.isWindows
		version = 0x0202uH
		if (arch.bitwidth == 64)
			data64 = WSAData64{}
			this.int = WSAStartup64(version, data64)
			version = data64.wVersion
		else
			data32 = WSAData32{}
			this.int = WSAStartup32(version, data32)
			version = data32.wVersion
		end
		if this.int != 0
			eprintn "WSAStartup returned ${this.int}\n"
		elif version != 0x0202
			eprintn "requested WINSock version 2.2 not available - got version ${version >> 8}.${version & 0xff}\n"
		elif _verbose
			eprintn "got WINSock version ${version >> 8}.${version & 0xff}\n"
		end
	else
		this.int = 0
	end
end

inline def ~WsockProto
	if os.isWindows
		WSACleanup
	end
end

# symbol of type 'WsockProto' to trigger constructor/destructor calls that do initialization/clean-up
# '_winsock.status.int' contains 0 or the error status returned by WSAStartup()
#
pub const status = WsockProto
