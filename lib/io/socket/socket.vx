import arch.os

type Socket {
	fd int
}

type sockaddr {
	len    u8
	family u8
	data   [14]u8
}

type sockaddr_storage {
	len    u8
	family u8
	pad1   [6]u8
	align  i64
	pad2   [112]u8
}

const WSADESCRIPTION_LEN ::= 256
const WSASYS_STATUS_LEN ::= 128

type WSAData32 {
	wVersion       u16
	wHighVersion   u16
	szDescription  [WSADESCRIPTION_LEN+1]u8
	szSystemStatus [WSASYS_STATUS_LEN+1]u8
	iMaxSockets    u16
	iMaxUdpDg      u16
	lpVendorInfo   cstring
}

type WSAData64 {
	wVersion       u16
	wHighVersion   u16
	iMaxSockets    u16
	iMaxUdpDg      u16
	lpVendorInfo   cstring
	szDescription  [WSADESCRIPTION_LEN+1]u8
	szSystemStatus [WSASYS_STATUS_LEN+1]u8
}

type WSAData union {
	WSAData32
	WSAData64
}

cdecl fn WSAStartup(wVersionRequested u16, &lpWSAData WSAData) int
cdecl fn WSACleanup() int

type WsockProto union {
	version [2]u8
	u16
	status int
}

inline fn WsockProto
	if os.isWindows
		this.version = [2, 2]
		data := WSAData
		this.status = WSAStartup(this.u16, data)
		if this.status != 0
			printf("WSAStartup returned %d\n", this.status) .
	else
		this.status = 0 .
	return

inline fn ~WsockProto
	if os.isWindows
		WSACleanup .
	return

proto := WsockProto{ status: 0 }

# address families
#
const AF_UNSPEC ::= 0
const AF_UNIX   ::= if os.isHaiku; 9 else 1 .
const AF_INET   ::= 2
const AF_INET6  ::= if os.isWindows
		23
	elif os.isNetBSD || os.isOpenBSD
		24
	elif os.isHaiku
		5
	else
		28 .

# socket types
#
const SOCK_STREAM    ::= 1
const SOCK_DGRAM     ::= 2
const SOCK_RAW       ::= 3
const SOCK_SEQPACKET ::= 5

cdecl fn socket(domain int, typ int, protocol int) int
