struct sockaddr_any union {
	sockaddr
	sockaddr_un
	sockaddr_in
	sockaddr_in6
	sockaddr_storage
}

inline def do_bind(handle ssize_t, &saddr sockaddr_any, size u32) Socket
	s = Socket{ handle: handle }
	if os.isWindows
		res = win_bind(size_t(s.handle), saddr.sockaddr, size)
		if res != 0
			s.handle = -1
			s.err = u32(WSAGetLastError)
		end
	else
		res = bind(int(s.handle), saddr.sockaddr, size)
		if res != 0
			s.handle = -1
			s.err = GetLastError
		end
	end
	return s
end

pub inline def UnixSocket.bind(path string) Socket
	if this.handle == -1
		return Socket{ handle: this.handle, err: this.err }
	end
	if path.len > UNIX_PATH_MAX
		return Socket{ handle: -1, err: ENAMETOOLONG }
	end
	saddr = sockaddr_any{}
	if os.isWindows || os.isLinux
		saddr.sockaddr_un.sun_family = AF_UNIX
	else
		saddr.sockaddr.len = u8(path.len) + 2
		saddr.sockaddr.family = AF_UNIX
	end
	__memcpy(&saddr.sockaddr_un.sun_path, voidptr(path), path.len)
	return do_bind(this.handle, saddr, u32(path.len) + 2)
end

pub inline def IpSocket.bind(ownaddr in_addr, ownport u16) Socket
	saddr = sockaddr_any{
		sockaddr_in: {
			sin_port: htons(ownport)
			sin_addr: ownaddr } }
	if os.isWindows || os.isLinux
		saddr.sockaddr_in.sin_family = AF_INET
	else
		saddr.sockaddr.len = u8(sizeof(sockaddr_in))
		saddr.sockaddr.family = AF_INET
	end
	return do_bind(this.handle, saddr, u32(sizeof(sockaddr_in)))
end

pub inline def IpSocket.bind(ownaddr u32, ownport u16) Socket
	return this.bind(in_addr{ u32: htonl(ownaddr) }, ownport)
end

pub inline def IpSocket.bind(ownaddr [4]u8, ownport u16) Socket
	return this.bind(in_addr{ __s4_addr: ownaddr }, ownport)
end

pub inline def IpSocket.bind(ownport u16) Socket
	return this.bind(in_any, ownport)
end

pub inline def Ip6Socket.bind(ownaddr in6_addr, ownport u16) Socket
	saddr = sockaddr_any{
		sockaddr_in6: {
			sin6_port: htons(ownport)
			sin6_addr: ownaddr } }
	if os.isWindows || os.isLinux
		saddr.sockaddr_in6.sin6_family = AF_INET6
	else
		saddr.sockaddr.len = u8(sizeof(sockaddr_in6))
		saddr.sockaddr.family = AF_INET6
	end
	return do_bind(this.handle, saddr, u32(sizeof(sockaddr_in6)))
end

pub inline def Ip6Socket.bind(ownport u16) Socket
	return this.bind(in6_any, ownport)
end

cdecl listen(s int, backlog int) int
cdecl(listen) win_listen(s size_t, backlog int) int

struct ListeningSocket {
	handle ssize_t
	err int
}

pub inline def Socket.listen(backlog int) ListeningSocket
	if this.handle == -1
		return ListeningSocket{ handle: this.handle, err: this.err }
	end
	if os.isWindows
		success = win_listen(size_t(this.handle), backlog)
	else
		success = listen(int(this.handle), backlog)
	end
	if success == -1
		if os.isWindows
			err = WSAGetLastError
		else
			err = GetLastError
		end
		return ListeningSocket{ handle: -1, err: err }
	end
	return ListeningSocket{ handle: this.handle, err: 0 }
end

const SOMAXCONN := 0x7fffffff

pub inline def Socket.listen ListeningSocket
	return this.listen(SOMAXCONN)
end

pub inline def IpSocket.listen(ownaddr in_addr, ownport u16, backlog int) ListeningSocket
	return this.bind(ownaddr, ownport).listen(backlog)
end

pub inline def IpSocket.listen(ownaddr in_addr, ownport u16) ListeningSocket
	return this.bind(ownaddr, ownport).listen(SOMAXCONN)
end

pub inline def IpSocket.listen(ownaddr u32, ownport u16, backlog int) ListeningSocket
	return this.bind(in_addr{ u32: htonl(ownaddr) }, ownport).listen(backlog)
end

pub inline def IpSocket.listen(ownaddr u32, ownport u16) ListeningSocket
	return this.bind(in_addr{ u32: htonl(ownaddr) }, ownport).listen(SOMAXCONN)
end

pub inline def IpSocket.listen(ownaddr [4]u8, ownport u16, backlog int) ListeningSocket
	return this.bind(in_addr{ __s4_addr: ownaddr }, ownport).listen(backlog)
end

pub inline def IpSocket.listen(ownaddr [4]u8, ownport u16) ListeningSocket
	return this.bind(in_addr{ __s4_addr: ownaddr }, ownport).listen(SOMAXCONN)
end

pub inline def IpSocket.listen(ownport u16, backlog int) ListeningSocket
	return this.bind(in_any, ownport).listen(backlog)
end

pub inline def IpSocket.listen(ownport u16) ListeningSocket
	return this.bind(in_any, ownport).listen(SOMAXCONN)
end

