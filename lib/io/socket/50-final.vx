type sockaddr_any union {
	sockaddr
	sockaddr_un
	sockaddr_in
	sockaddr_in6
	sockaddr_storage
}

inline fn do_bind(handle size_t, &saddr sockaddr_any, size u32) Socket
	s := Socket{ handle: handle }
	if os.isWindows
		res := win_bind(s.handle, saddr.sockaddr, size)
	else
		res := bind(s.fd, saddr.sockaddr, size) .
	if res != 0
		__printerr
		printf("Handle: %d\n", s.fd)
		s.handle = size_t(-1) .
	return s

pub inline fn LocalSocket.bind(path string) Socket
	if path.len > UNIX_PATH_MAX
		printf("socket.unix.bind: maximum path length (%u) exceeded\n", UNIX_PATH_MAX)
		return Socket{ handle: size_t(-1) }
	saddr := sockaddr_any{}
	if os.isWindows || os.isLinux
		saddr.sockaddr_un.sun_family = AF_UNIX
	else
		saddr.sockaddr.len = u8(path.len) + 2
		saddr.sockaddr.family = AF_UNIX .
	memcpy(&saddr.sockaddr_un.sun_path, path, path.len)
	return do_bind(this.handle, saddr, u32(path.len) + 2)

pub inline fn IpSocket.bind(ownaddr u32, ownport u16) Socket
	saddr := sockaddr_any{
		sockaddr_in: {
			sin_port: ownport
			sin_addr: { u32: ownaddr } } }
	if os.isWindows || os.isLinux
		saddr.sockaddr_in.sin_family = AF_INET
	else
		saddr.sockaddr.len = 16
		saddr.sockaddr.family = AF_INET .
	return do_bind(this.handle, saddr, u32(16))
