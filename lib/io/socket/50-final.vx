type sockaddr_any union {
	sockaddr
	sockaddr_un
	sockaddr_in
	sockaddr_in6
	sockaddr_storage
}

inline fn do_bind(handle ssize_t, &saddr sockaddr_any, size u32) Socket
	s := Socket{ handle: handle }
	if os.isWindows
		res := win_bind(u64(s.handle), saddr.sockaddr, size)
		if res != 0
			s.handle = -1
			s.err = WSAGetLastError .
	else
		res := bind(int(s.handle), saddr.sockaddr, size)
		if res != 0
			s.handle = -1
			s.err = GetLastError . .
	return s

pub inline fn UnixSocket.bind(path string) Socket
	if this.handle == -1
		return Socket{ handle: this.handle, err: this.err }
	if path.len > UNIX_PATH_MAX
		return Socket{ handle: -1, err: ENAMETOOLONG }
	saddr := sockaddr_any{}
	if os.isWindows || os.isLinux
		saddr.sockaddr_un.sun_family = AF_UNIX
	else
		saddr.sockaddr.len = u8(path.len) + 2
		saddr.sockaddr.family = AF_UNIX .
	memcpy(&saddr.sockaddr_un.sun_path, path, path.len)
	return do_bind(this.handle, saddr, u32(path.len) + 2)

pub inline fn IpSocket.bind(ownaddr in_addr, ownport u16) Socket
	saddr := sockaddr_any{
		sockaddr_in: {
			sin_port: htons(ownport)
			sin_addr: ownaddr } }
	if os.isWindows || os.isLinux
		saddr.sockaddr_in.sin_family = AF_INET
	else
		saddr.sockaddr.len = u8(sizeof(sockaddr_in))
		saddr.sockaddr.family = AF_INET .
	return do_bind(this.handle, saddr, u32(sizeof(sockaddr_in)))

pub inline fn IpSocket.bind(ownaddr u32, ownport u16) Socket
	return this.bind(in_addr{ u32: htonl(ownaddr) }, ownport)

pub inline fn IpSocket.bind(ownaddr [4]u8, ownport u16) Socket
	return this.bind(in_addr{ __s4_addr: ownaddr }, ownport)

pub inline fn IpSocket.bind(ownport u16) Socket
	return this.bind(in_addr{ __s4_addr: in_any }, ownport)

pub inline fn Ip6Socket.bind(ownaddr in6_addr, ownport u16) Socket
	saddr := sockaddr_any{
		sockaddr_in6: {
			sin6_port: htons(ownport)
			sin6_addr: ownaddr } }
	if os.isWindows || os.isLinux
		saddr.sockaddr_in6.sin6_family = AF_INET6
	else
		saddr.sockaddr.len = u8(sizeof(sockaddr_in6))
		saddr.sockaddr.family = AF_INET6 .
	return do_bind(this.handle, saddr, u32(sizeof(sockaddr_in6)))

pub inline fn Ip6Socket.bind(ownport u16) Socket
	adr := in6_addr{}
	return this.bind(adr, ownport)
