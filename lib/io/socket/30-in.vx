type IpSocket union {
	handle size_t
	fd int
}

type in_addr union {
	__s4_addr [4]u8
	u32
}

type sockaddr_in {
	sin_family u16
	sin_port u16
	sin_addr in_addr
	sin_zero [8]u8
}

pub inline fn tcp IpSocket
	s := IpSocket{}
	if os.isWindows
		s.handle = win_socket(AF_INET, SOCK_STREAM, 0)
	else
		s.fd = socket(AF_INET, SOCK_STREAM, 0) .
	return s

pub inline fn udp IpSocket
	s := IpSocket{}
	if os.isWindows
		s.handle = win_socket(AF_INET, SOCK_DGRAM, 0)
	else
		s.fd = socket(AF_INET, SOCK_DGRAM, 0) .
	return s

pub const INADDR_ANY       ::= 0x00000000
pub const INADDR_BROADCAST ::= 0xffffffff
pub const INADDR_NONE      ::= 0xffffffff
pub const INADDR_LOOPBACK  ::= 0x7f000001
