# Windows specific part of socket library - do not import directly

import arch.os

cdecl fn _volvox_WSAInit() int
cdecl fn _volvox_WSACleanup()

type WsockProto {
	status int
}

fn WsockProto
	if os.isWindows
		this.status = _volvox_WSAInit .
	return

pub fn ~WsockProto()
	if os.isWindows
		_volvox_WSACleanup .
	return

pub proto := WsockProto{}
