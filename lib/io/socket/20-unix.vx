
type UnixSocket union {
	handle ssize_t
	err u32
}

pub const UNIX_PATH_MAX	:= if os.isWindows || os.isLinux
		108
	elif os.isHaiku
		126
	else
		104
	end

type sockaddr_un {
	sun_family u16
	sun_path [UNIX_PATH_MAX]i8
}

pub inline fn unix UnixSocket
	s = UnixSocket{}
	if os.isWindows
		s.handle = win_socket(AF_UNIX, SOCK_STREAM, 0)
		if s.handle == -1
			s.err = u32(WSAGetLastError())
		end
	else
		s.handle = socket(AF_UNIX, SOCK_STREAM, 0)
		if s.handle == -1
			s.err = GetLastError
		end
	end
	return s
end

from error import ENAMETOOLONG

type ucred {
	pid u32
	uid u32
	gid u32
}

const SOL_SOCKET := if os.isLinux
		1
	elif os.isHaiku
		-1
	else
		0xffff
	end

const IOC_VENDOR := 0x18000000
const IOC_OUT    := 0x40000000

const SO_PEERCRED := if os.isLinux
		17
	elif os.isFreeBSD
		1
	elif os.isNetBSD
		3
	elif os.isOpenBSD
		0x1022
	elif os.isHaiku
		0x4000000b
	elif os.isWindows
		IOC_OUT | IOC_VENDOR | 256 # SIO_AF_UNIX_GETPEERPID
	else
		0
	end

cdecl WSAIoctl(s size_t, dwIoControlCode u32, lpvInBuffer voidptr, cbInBuffer u32,
               lpvOutBuffer voidptr, cbOutBuffer u32, &lpcbBytesReturned u32,
			   lpOverlapped voidptr, lpCompletionRoutine voidptr) int

cdecl getsockopt(sockfd int, level int, optname int, optval voidptr, &optlen u32) int

fn UnixSocket.peer ucred
	p = ucred{}
	l = u32
	if os.isWindows
		pid = u32
		r = WSAIoctl(size_t(this.handle), SO_PEERCRED, nil, 0, &pid, u32(sizeof(u32)), l, nil, nil)
		if r != -1
			p.pid = pid
		end
	else
		l = u32
		r = getsockopt(int(this.handle), SOL_SOCKET, SO_PEERCRED, &p, l)
	end
	return p
end
