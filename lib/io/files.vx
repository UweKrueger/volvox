import arch.os
import limits

# There are two kinds of "file" on all systems:
# 1. file descriptors
#   o represented by an integer number called "file descriptor"
#   o implemented in the OS kernel - this is how the OS sees files
#   o sometimes called "unbuffered", however the OS kernel does buffer i/o
#   + suitable for low level operations (select/poll/...)
#   + writes are atomic, i.e. writes from different threads do not interleave
#   + written data is immediately passed to the OS
#   - every single write implies a system call which means so writing
#     a large number of small packets is slow
# 2. represented by a pointer to a FILE struct
#   o implemented in the C runtime library (libc, glibc, ucrt, ...)
#     but uses a file descriptor internally
#   o uses user space buffers to collect small packets before they
#     are passed as a single write to the OS
#   + high performance even with many writes of small packets
#   - passing data to the OS is delayed due to buffering,
#     however there is a special "flush" to write all collected data
#   - writes from different threads may interleave
#
# Remark: Even when using file descriptors or doing "flush", written data
#         is not immediately *physically* written to a device (hard drive,
#         USB-Stick, SD-Card, etc). To ensure this, an additional "sync"
#         is required.

type Fd {
	fd int
}

# flags for file descriptor open
#
pub const APPEND ::= if os.isLinux; 0x0400 else 0x0008 .
pub const RDONLY ::= 0x0000
pub const WRONLY ::= 0x0001
pub const RDWR   ::= 0x0002
pub const CREAT  ::= if os.isWindows; 0x0100 elif os.isLinux; 0x0040 else 0x0200 .
pub const TRUNC  ::= if os.isWindows; 0x0200 elif os.isLinux; 0x0080 else 0x0400 .
pub const EXCL   ::= if os.isWindows; 0x0400 elif os.isLinux; 0x0200 else 0x0800 .
pub const BINARY ::= if os.isWindows; 0x8000 else 0x0000 .
pub const CLOEXEC ::= if os.isLinux
		0x080000
	elif os.isOpenBSD
		0x010000
	elif os.isNetBSD
		0x400000
	elif os.isFreeBSD
		0x100000
	elif os.isDragonFly
		0x020000
	elif os.isWindows
		0x000080 # called _O_NOINHERIT there
	else
		0 .
pub const NOINHERIT ::= CLOEXEC # flag's Windows name as alias

# POSIX systems' open function 
cdecl fn open(filename cstring, flags int, mode int) int
# Windows naming convention
cdecl fn _open(filename cstring, flags int, mode int) int

# general function to open an unbuffered file - essentially the POSIX version
#
pub inline fn openfile(filename cstring, flags int, mode int) Fd
	if os.isWindows
		fd := _open(filename, flags, mode)
	else
		fd := open(filename, flags, mode) .
	return Fd { fd: fd }

# open file for read/write (like '>' in shell scripts)
# - if file name exists truncate it to size 0
# - create new file otherwise
#
pub inline fn create(filename cstring) Fd
	return openfile(filename, CREAT | RDWR | TRUNC | BINARY | CLOEXEC, 0666)

# open existing file for read
# return error otherwise
#
pub inline fn open(filename cstring) Fd
	return openfile(filename, RDONLY | BINARY | CLOEXEC, 0)

# create new file for read/write
# - if file name already exists do nothing and return error
#
pub inline fn newfile(filename cstring) Fd
	return openfile(filename, CREAT | RDWR | EXCL | BINARY | CLOEXEC, 0666)

# open file to append data (like '>>' in shell scripts)
# - if file name exists set file pointer to end
# - create new file otherwise
#
pub inline fn append(filename cstring) Fd
	return openfile(filename, CREAT | WRONLY | APPEND | BINARY | CLOEXEC, 0666)

cdecl fn close(fd int) int
cdecl fn _close(fd int) int

pub inline fn Fd.close int
	fd := this.fd
	this.fd = -1
	if os.isWindows
		return _close(fd)
	else
		return close(fd)

cdecl fn _write(fd int, buf cstring, count u32) int
cdecl fn write(fd int, buf cstring, count size_t) ssize_t

fn win64_write(fd int, buf cstring, count size_t) ssize_t
	# The Windows _write() can only handle max_int bytes but size_t might exceed this value
	# on 64 bit platforms. So we split the operation into several parts in that case
	if os.isWindows && os.bitwidth > 32
		bytes_written := size_t(0)
		written := limits.max_i32
		while count > limits.max_i32 && written == limits.max_i32
			written = _write(fd, buf, u32(limits.max_i32))
			if written >= 0
				bytes_written += u32(written)
				count -= u32(written) . .
		if written == limits.max_i32
			written = _write(fd, buf, u32(count)) .
		if written < 0
			return -1
		else
			return bytes_written + written
	else
		# this function will not be called in other cases - so keep it small
		return 0

# basically the POSIX 'write()' function - do not use this function directly
# unless you know what you are doing...
#
pub inline fn Fd._write(buf cstring, count size_t) ssize_t
	if os.isWindows
		if os.bitwidth > 32
			return win64_write(this.fd, buf, count)
		else
			return _write(this.fd, buf, u32(count))
	else
		return write(this.fd, buf, count)


cdecl fn strlen(s cstring) size_t

pub inline fn Fd.write(buf cstring) ssize_t
	len := strlen(buf)
	return this._write(buf, len)
