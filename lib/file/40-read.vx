cdecl fscanf(file voidptr, fmt cstring, ...) int
cdecl ferror(file voidptr) int

fn File.__scanf(fmt cstring, v voidptr)
	global EOF
	if fscanf(this.voidptr, fmt, v) == EOF
		if ferror(this.voidptr) != 0
			this.err = GetLastError
end end end

# read floating point numbers in decimal representation

pub fn File.readr real
	r = real
	this.__scanf(" %lg", &r)
	return r
end

pub fn File.readf f32
	f = f32
	this.__scanf(" %g", &f)
	return f
end

# read floating point numbers in hexadecimal representation

pub fn File.readrx real
	r = real
	this.__scanf(" %la", &r)
	return r
end

pub fn File.readfx f32
	f = f32
	this.__scanf(" %a", &f)
	return f
end

# read signed integer numbers in any format

pub fn File.readl i64
	n = i64
	# we use 'll' (long long) here because that's 64 bit on all platforms
	this.__scanf(" %lli", &n)
	return n
end

pub fn File.readn i32
	n = i32
	this.__scanf(" %i", &n)
	return n
end

pub fn File.readh i16
	n = i16
	this.__scanf(" %hi", &n)
	return n
end

pub fn File.readhh i8
	n = i8
	this.__scanf(" %hhi", &n)
	return n
end

# read signed integer numbers in decimal format

pub fn File.readdl i64
	n = i64
	# we use 'll' (long long) here because that's 64 bit on all platforms
	this.__scanf(" %lld", &n)
	return n
end

pub fn File.readd i32
	n = i32
	this.__scanf(" %d", &n)
	return n
end

pub fn File.readdh i16
	n = i16
	this.__scanf(" %hd", &n)
	return n
end

pub fn File.readdhh i8
	n = i8
	this.__scanf(" %hhd", &n)
	return n
end

# read unsigned numbers

pub fn File.readul u64
	n = u64
	# we use 'll' (long long) here because that's 64 bit on all platforms
	this.__scanf(" %llu", &n)
	return n
end

pub fn File.readu u32
	n = u32
	this.__scanf(" %u", &n)
	return n
end

pub fn File.readuh u16
	n = u16
	this.__scanf(" %hu", &n)
	return n
end

pub fn File.readuhh u8
	n = u8
	this.__scanf(" %hhu", &n)
	return n
end

cdecl getline(&buf cstring, &sz size_t, file voidptr) ssize_t
cdecl getdelim(&buf cstring, &sz size_t, delim i8, file voidptr) ssize_t
cdecl __transformcstr2volvox_l(s cstring, len ssize_t, cap size_t) string
cdecl __trim_cstring(s cstring, &l ssize_t, delim i8)

pub fn File.getline string
	bufsz = 0UZ
	buf = cstring voidptr 0
	sz = getline(buf, bufsz, this.voidptr)
	if sz > 0
		__trim_cstring(buf, sz, '\n')
		s = __transformcstr2volvox_l(buf, sz, bufsz)
		return s
	else
		if sz < 0
			this.err = GetLastError
		end
		return ""
end end

pub fn File.getdelim(delimiter i8) string
	bufsz = 0UZ
	buf = cstring voidptr 0
	sz = getdelim(buf, bufsz, delimiter, this.voidptr)
	if sz > 0
		__trim_cstring(buf, sz, delimiter)
		s = __transformcstr2volvox_l(buf, sz, bufsz)
		return s
	else
		if sz < 0
			this.err = GetLastError
		end
		return ""
end end

cdecl __purgeline(file voidptr) ssize_t

pub fn File.eatnl
	global EMSGSIZE
	if __purgeline(this.voidptr) != 0
		if this.err = 0
			this.err = EMSGSIZE
end end end

pub fn File.getr real
	x = this.readr
	this.eatnl
	return x
end

pub fn File.getf f32
	x = this.readf
	this.eatnl
	return x
end

pub fn File.getrx real
	x = this.readrx
	this.eatnl
	return x
end

pub fn File.getfx f32
	x = this.readfx
