import arch
import arch.os
import limits

cdecl fopen(filename cstring, mode cstring) voidptr
cdecl fopen64(filename cstring, mode cstring) voidptr
cdecl fclose(f voidptr) int

type File {
	voidptr # FILE*
	err u32
}

pub inline fn ~File
	if size_t(this.voidptr) != 0
	   fclose(this.voidptr)
	end
end

pub inline fn File.is_valid bool
	return size_t(this.voidptr) != 0
end

# open file for read/write (like '>' in shell scripts)
# - if file name exists truncate it to size 0
# - create new file otherwise
#
pub inline fn create(filename cstring) File
	if os.isWindows
		mode = "wb"
	else
		mode = "we"
	end
	f = File{}
	if arch.bitwidth == 32 && os.isLinux
		f.voidptr = fopen64(filename, mode)
	else
		f.voidptr = fopen(filename, mode)
	end
	if !f.is_valid
		f.err = GetLastError
	end
	return f
end

# open existing file for read
# return error otherwise
#
pub inline fn open(filename cstring) File
	if os.isWindows
		mode = "rb"
	else
		mode = "re"
	end
	f = File{}
	if arch.bitwidth == 32 && os.isLinux
		f.voidptr = fopen64(filename, mode)
	else
		f.voidptr = fopen(filename, mode)
	end
	if !f.is_valid
		f.err = GetLastError
	end
	return f
end

# create new file for read/write
# - if file name already exists do nothing and return error
#
pub inline fn new(filename cstring) File
	if os.isWindows
		mode = "wxb"
	else
		mode = "wxe"
	end
	f = File{}
	if arch.bitwidth == 32 && os.isLinux
		f.voidptr = fopen64(filename, mode)
	else
		f.voidptr = fopen(filename, mode)
	end
	if !f.is_valid
		f.err = GetLastError
	end
	return f
end

# open file to append data (like '>>' in shell scripts)
# - if file name exists set file pointer to end
# - create new file otherwise
#
# create new file for read/write
# - if file name already exists do nothing and return error
#
pub inline fn append(filename cstring) File
	if os.isWindows
		mode = "ab"
	else
		mode = "ae"
	end
	f = File{}
	if arch.bitwidth == 32 && os.isLinux
		f.voidptr = fopen64(filename, mode)
	else
		f.voidptr = fopen(filename, mode)
	end
	if !f.is_valid
		f.err = GetLastError
	end
	return f
end

pub inline fn File.close
	if size_t(this.voidptr) != 0
		if fclose(this.voidptr) != 0
			this.err = GetLastError
		end
		this.voidptr = voidptr(0)
end end
