import arch
import arch.os
import limits
from error import EOF, EMSGSIZE

cdecl fopen(filename cstring, mode cstring) voidptr
cdecl fopen64(filename cstring, mode cstring) voidptr
cdecl fclose(f voidptr) int

# We do not currently support C global variables so we call wrappers

cdecl __get_stdin voidptr
cdecl __get_stdout voidptr
cdecl __get_stderr voidptr

pub const autoclose      := 0x01
pub const nolock         := 0x02
const special_files_mask := 0x0c
const flag_stdin         := 0x04
const flag_stdout        := 0x08
const flag_stderr        := 0x0c

# buffered files come in two flavours:
# non-autoclose (default for Volvox):
#   - limited to one object - cannot be copied (but referenced)
#   - limited one thread
#   - I/O is unlocked (very fast)
#   - automatically closed by destructor
# autoclose:
#   - many copies of object may exist
#   - can be used in several threads but I/O is not atomic
#     i.e. file content may become messed up by interleaving
#     (see module io for unbuffered files that support atomic operations)
#   - have to be closed manually
#   - used for stdin, stdout and stderr but not recommended otherwise

type File {
	voidptr    # libc FILE pointer as returned by fopen()
	_flags u32 # to indicate autoclose, stdin/stdout/stderr
	err u32
}

pub def File
	if (this._flags & autoclose) == autoclose
		panic "file.File must not be copied when autoclose is set"
	end
	if size_t(this.voidptr) == 0
		# standard file - get file descriptor from err
		special_file_flags = this._flags & special_files_mask
		if special_file_flags == 0
			panic "file.File is not default constructable"
		else
			# hack to construct std{in,out,err}
			if special_file_flags == flag_stdin
				this.voidptr = __get_stdin
			elif special_file_flags == flag_stdout
				this.voidptr = __get_stdout
			else
				this.voidptr = __get_stderr
			end
end end end

pub def File(c_file voidptr, flags u32)
	this.voidptr = c_file
	if size_t(this.voidptr) == 0
		this.err = GetLastError
	end
	this._flags = flags
end

# The destructor closes the file unless it's flagged as shareable in which
# case the method close() has to be called manually
#
pub inline def ~File
	print "destructor called"
	if bool(this._flags & autoclose) && size_t(this.voidptr) != 0
	   fclose(this.voidptr)
	end
end

pub inline def File.is_valid bool
	return size_t(this.voidptr) != 0
end

# Having std streams available in all threads is somewhat tricky since
# initializers for thread local globals must be constexprs.
#
# We use _flags to code which non-constexpr FILE* from libc should be used.
# The default constructor then assigns the correct file pointer based
# on these flags.

pub global stdin  := File{ _flags: flag_stdin }
pub global stdout := File{ _flags: flag_stdout }
pub global stderr := File{ _flags: flag_stderr }

# open file for read/write (like '>' in shell scripts)
# - if file name exists truncate it to size 0
# - create new file otherwise
#
pub inline def create(filename cstring, flags u32) File
	if os.isWindows
		mode = "wb"
	else
		mode = "we"
	end
	if arch.bitwidth == 32 && os.isLinux
		f = File(fopen64(filename, mode), flags)
	else
		f = File(fopen(filename, mode), flags)
	end
	return f
end

pub inline def create(filename cstring) File
	return create(filename, autoclose)
end

# open existing file for read
# return error otherwise
#
pub inline def open(filename cstring, flags u32) File
	if os.isWindows
		mode = "rb"
	else
		mode = "re"
	end
	if arch.bitwidth == 32 && os.isLinux
		f = File(fopen64(filename, mode), flags)
	else
		f = File(fopen(filename, mode), flags)
	end
	return f
end

pub inline def open(filename cstring) File
	return open(filename, autoclose)
end

# create new file for read/write
# - if file name already exists do nothing and return error
#
pub inline def new(filename cstring, flags u32) File
	if os.isWindows
		mode = "wxb"
	else
		mode = "wxe"
	end
	if arch.bitwidth == 32 && os.isLinux
		f = File(fopen64(filename, mode), flags)
	else
		f = File(fopen(filename, mode), flags)
	end
	return f
end

pub inline def new(filename cstring) File
	return new(filename, autoclose)
end

# open file to append data (like '>>' in shell scripts)
# - if file name exists set file pointer to end
# - create new file otherwise
#
# create new file for read/write
# - if file name already exists do nothing and return error
#
pub inline def append(filename cstring, flags u32) File
	if os.isWindows
		mode = "ab"
	else
		mode = "ae"
	end
	if arch.bitwidth == 32 && os.isLinux
		f = File(fopen64(filename, mode), flags)
	else
		f = File(fopen(filename, mode), flags)
	end
	return f
end

pub inline def append(filename cstring) File
	return append(filename, autoclose)
end

pub inline def File.close
	if size_t(this.voidptr) != 0
		if fclose(this.voidptr) != 0
			this.err = GetLastError
		end
		this.voidptr = voidptr(0)
end end
