import arch
import arch.os
import time

const __MUTEX_ATTR_SIZE ::= if os.isLinux
		4
	else
		arch.bitwidth >> 3 .

type mutex_attr union {
	voidptr
	size_t
	bytes [__MUTEX_ATTR_SIZE]u8
}

cdecl fn pthread_mutexattr_init(&attr mutex_attr) int
cdecl fn pthread_mutexattr_destroy(&attr mutex_attr) int
cdecl fn pthread_mutexattr_setrobust(&attr mutex_attr, robustness int) int

fn get_robust_mutex_attr mutex_attr
	m := mutex_attr{}
	if !os.isWindows
		pthread_mutexattr_init(m)
		if os.isLinux || os.isFreeBSD
			pthread_mutexattr_setrobust(m, 1) . .
	return m

const default_mutex_attr := get_robust_mutex_attr

const __MUTEX_SIZE ::= if os.isLinux
		if arch.bitwidth == 64
			40
		else
			32 .
	else
		arch.bitwidth >> 3 .

type mutex

cdecl fn CreateMutexA(lpMutexAttributes voidptr, bInitialOwner bool, lpName cstring) size_t
cdecl fn CloseHandle(size_t) bool
cdecl fn pthread_mutex_init(&m mutex, &attr mutex_attr) int
cdecl fn pthread_mutex_destroy(&m mutex) int

type mutex union {
	voidptr
	size_t
	bytes [__MUTEX_SIZE]u8
}

pub fn mutex
	if os.isWindows
		this.size_t = CreateMutexA(voidptr(0), false, cstring(0))
	else
		pthread_mutex_init(this, default_mutex_attr) .
	return

pub fn ~mutex
	if os.isWindows
		CloseHandle(this.size_t)
	else
		pthread_mutex_destroy(this) .
	return

cdecl fn WaitForSingleObjectEx(hHandle size_t, dwMilliseconds u32, bAlertable bool) u32
cdecl fn pthread_mutex_timedlock(&m mutex, &abs_timeout time.timespec) int
cdecl fn pthread_mutex_lock(&m mutex) int
cdecl fn pthread_mutex_trylock(&m mutex) int
cdecl fn pthread_mutex_consistent(&m mutex) int
cdecl fn GetLastError() u32

const EOWNERDEAD ::= if os.isFreeBSD
		96
	elif os.isLinux
		130
	elif os.isWindows
		0x00000080 # WAIT_ABANDONED
	else
		0 . # other OSs do not support robust mutexes :-(

pub inline fn mutex.lock int
	if os.isWindows
		res := WaitForSingleObjectEx(this.size_t, u32(-1), true)
		if res != 0
			res = GetLastError() .
	else
		res := pthread_mutex_lock(this) .
	if res == 0
		return 0
	if os.isLinux || os.isFreeBSD || os.isWindows
		if res == EOWNERDEAD
			if !os.isWindows
				pthread_mutex_consistent(this) .
			return 0 . .
	return res

cdecl fn ReleaseMutex(m size_t) bool
cdecl fn pthread_mutex_unlock(&m mutex) int

const ETIMEDOUT ::= if os.isWindows
		0x00000102 # WAIT_TIMEOUT
	elif os.isLinux
		110
	else
		60 .

const EPERM ::= if os.isWindows
		288 # ERROR_NOT_OWNER
	else
		1 .

const EBUSY ::= 16

pub inline fn mutex.unlock int
	if os.isWindows
		if arch.isREPL
			res := WaitForSingleObjectEx(this.size_t, 0, false)
			if res == 0
				ReleaseMutex(this.size_t)
				return EPERM .
			res = GetLastError()
			if res != ETIMEDOUT && res != EOWNERDEAD
				return res . .
		return int(!ReleaseMutex(this.size_t))
	else
		if arch.isREPL && (os.isLinux || os.isFreeBSD)
			res := pthread_mutex_trylock(this)
			if res == 0
				pthread_mutex_unlock(this)
				return EPERM .
			if res != EBUSY && res != EOWNERDEAD
				return res .
			if res == EOWNERDEAD
				pthread_mutex_consistent(this) . .
		return pthread_mutex_unlock(this)
