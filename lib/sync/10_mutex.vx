import arch
import arch.os
import time

const __MUTEX_ATTR_SIZE := if os.isLinux
		4
	else
		arch.bitwidth >> 3
	end

cdecl pthread_mutexattr_destroy(attr voidptr) int

type mutex_attr union {
	voidptr
	size_t
	bytes [__MUTEX_ATTR_SIZE]u8
}

def ~mutex_attr
	if !os.isWindows
		pthread_mutexattr_destroy(&this)
end end

cdecl pthread_mutexattr_init(&attr mutex_attr) int
cdecl pthread_mutexattr_setrobust(&attr mutex_attr, robustness int) int

def get_robust_mutex_attr mutex_attr
	m = mutex_attr{}
	if !os.isWindows
		pthread_mutexattr_init(m)
		if os.isLinux || os.isFreeBSD
			pthread_mutexattr_setrobust(m, 1)
		end
	end
	return m
end

const default_mutex_attr = get_robust_mutex_attr

const __MUTEX_SIZE := if os.isLinux
		if arch.bitwidth == 64
			40
		else
			32
		end
	else
		arch.bitwidth >> 3
	end

type mutex

cdecl CreateMutexA(lpMutexAttributes voidptr, bInitialOwner bool, lpName cstring) size_t
cdecl CloseHandle(size_t) bool
cdecl pthread_mutex_init(&m mutex, &attr mutex_attr) int
cdecl pthread_mutex_destroy(&m mutex) int

type mutex union {
	voidptr
	size_t
	bytes [__MUTEX_SIZE]u8
}

pub def mutex
	if os.isWindows
		this.size_t = CreateMutexA(voidptr(0), false, cstring(0))
	else
		pthread_mutex_init(this, default_mutex_attr)
	end
end

pub def ~mutex
	if os.isWindows
		CloseHandle(this.size_t)
	else
		pthread_mutex_destroy(this)
	end
end

cdecl WaitForSingleObjectEx(hHandle size_t, dwMilliseconds u32, bAlertable bool) u32
cdecl pthread_mutex_timedlock(&m mutex, &abs_timeout time.timespec) int
cdecl pthread_mutex_lock(&m mutex) int
cdecl pthread_mutex_trylock(&m mutex) int
cdecl pthread_mutex_consistent(&m mutex) int
cdecl GetLastError() u32

from error import EOWNERDEAD, ETIMEDOUT, EPERM, EBUSY, EINVAL, EAGAIN, ERROR_TOO_MANY_POSTS

pub inline def mutex.lock int
	if os.isWindows
		res = WaitForSingleObjectEx(this.size_t, u32(-1), true)
		if res != 0
			res = GetLastError()
			if res == EOWNERDEAD
				res = 0
			end
		end
	else
		res = pthread_mutex_lock(this)
	end
	if os.isLinux || os.isFreeBSD || os.isWindows
		if res == EOWNERDEAD
			if !os.isWindows
				pthread_mutex_consistent(this)
			end
			return 0
		end
	end
	return res
end

pub inline def mutex.trylock int
	if os.isWindows
		res = WaitForSingleObjectEx(this.size_t, 0, true)
		if res != 0
			res = GetLastError()
			if res == EOWNERDEAD
				res = 0
			end
		end
	else
		res = pthread_mutex_trylock(this)
	end
	if os.isLinux || os.isFreeBSD || os.isWindows
		if res == EOWNERDEAD
			if !os.isWindows
				pthread_mutex_consistent(this)
			end
			return 0
		end
	end
	return res
end

pub inline def mutex.timedlock(timeout time.Duration) int
	if os.isWindows
		res = WaitForSingleObjectEx(this.size_t, u32(timeout.i64 / 10000), true)
		if res != 0
			res = GetLastError()
			if res == EOWNERDEAD
				res = 0
			end
		end
	else
		ts = timeout.timespec
		res = pthread_mutex_timedlock(this, ts)
	end
	if os.isLinux || os.isFreeBSD || os.isWindows
		if res == EOWNERDEAD
			if !os.isWindows
				pthread_mutex_consistent(this)
			end
			return 0
		end
	end
	return res
end

cdecl ReleaseMutex(m size_t) bool
cdecl pthread_mutex_unlock(&m mutex) int

# In non-REPL case 'mutex.unlock()' is a simple inline wrapper for the OSs function.
# In the REPL case a new thread is created for each top level expression so there is always
# the "owner dead" case and we have to make things consistent first.
#
pub inline def mutex.unlock int
	if os.isWindows
		if arch.isREPL
			res = WaitForSingleObjectEx(this.size_t, 0, true)
			if res == 0
				ReleaseMutex(this.size_t)
				return EPERM
			end
			res = GetLastError()
			if res != ETIMEDOUT && res != EOWNERDEAD
				return res
			end
		end
		return int(!ReleaseMutex(this.size_t))
	else
		if arch.isREPL && (os.isLinux || os.isFreeBSD)
			res = pthread_mutex_trylock(this)
			if res == 0
				pthread_mutex_unlock(this)
				return EPERM
			end
			if res != EBUSY && res != EOWNERDEAD
				return res
			end
			if res == EOWNERDEAD
				pthread_mutex_consistent(this)
			end
		end
		return pthread_mutex_unlock(this)
	end
end
