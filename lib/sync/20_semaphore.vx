import limits

# There are a bunch of semaphore implementations in different operating
# systems:
# - System V Semaphores: available on all Unix systems including MacOSX
#      complicated API but very flexible in terms of features
# - POSIX Semoaphores: available on most modern Unix systems but not on MacOSX
#      simple, straightforward API, but less flexible, in particular lacks
#      the ability to increase the value by other values than 1
# - eventfd: available on Linux, FreeBSD and NetBSD
#      support 'select()' wait, allow increasing the value by other values than 1
# - WinAPI Semaphores: available on Microsoft Windows
#      support 'WaitForMultipleObjects()' and increasing the value by other values than 1
#
cdecl fn eventfd(initval u32, flags int) int
cdecl fn write(fd int, buf cstring, count size_t) ssize_t
cdecl fn read(fd int, buf cstring, count size_t) ssize_t
# key is 'long' on most systems but 'int' on Linux - so declare 32 and 64 bit versions here and decide later
cdecl fn semget(key i32, nsems int, semflg u32) int
cdecl fn semget(key i64, nsems int, semflg u32) int
cdecl fn CreateSemaphoreA(lpSemaphoreAttributes voidptr, lInitialCount int, lMaximumCount int, lpName cstring) size_t

from ..io.flags import CLOEXEC, NONBLOCK, SEMAPHORE, PRIVATE, CREAT

const SEMVMX ::= if os.isWindows
		limits.max_int # Windows allows setting max value separately for each semaphore
	else
		32767 . # System V semaphores - usually fixed (FreeBSD: kern.ipc.semvmx)

# Use union of different representations to make Semaphore type at most 16 bytes in size

type Semaphore {
	handle ssize_t
	err int
	_step_or_max int
}

pub const EINVAL ::= if os.isWindows
		87 # ERROR_INVALID_PARAMETER
	else
		22 .

cdecl fn GetLastError() u32

pub fn semaphore(init_val int, desired_max int) Semaphore
	sem := Semaphore{}
	if desired_max > SEMVMX || desired_max != 0 && init_val > desired_max
		sem.err = EINVAL
		return sem .
	if os.isWindows
		sem.handle = ssize_t(CreateSemaphoreA(voidptr(0), init_val, desired_max, cstring(0)))
		if sem.handle == 0
			sem.err = GetLastError()
			return sem .
		sem._step_or_max = desired_max
	else
		if desired_max == 0
			if os.isLinux || os.isFreeBSD || os.isNetBSD
				sem.handle = eventfd(0, CLOEXEC | NONBLOCK | SEMAPHORE)
				if sem.handle < 0
					sem.err = GetLastError() .
				return sem
			else
				desired_max = SEMVMX . .
		if os.isLinux
			sem.handle = semget(i32(PRIVATE), 1, 0x1ff | CREAT)
		else
			sem.handle = semget(size_t(PRIVATE), 1, 0x1ff | CREAT) .
		if sem.handle < 0
			sem.err = GetLastError()
			return sem .
		sem._step_or_max = SEMVMX / desired_max .
	return sem

pub inline fn Semaphore.is_selectable bool
	if os.isLinux || os.isFreeBSD || os.isNetBSD
		return this._step_or_max == 0
	else
		return false

pub inline fn Semaphore.max_value int
	if os.isWindows
		return this._step_or_max
	elif this._step_or_max == 0
		return 0
	else
		return SEMVMX / this._step_or_max

cdecl fn ReleaseSemaphore(hSemaphore size_t, lReleaseCount int, lpPreviousCount voidptr) bool

type sembuf {
	sem_num u16
	sem_op i16
	sem_flg u32
}

cdecl fn semop(semid i64, &sops sembuf, nsops size_t) int
cdecl fn semop(semid i32, &sops sembuf, nsops size_t) int
cdecl fn write(fd int, buf voidptr, count size_t) ssize_t

const ERROR_TOO_MANY_POSTS ::= 298

pub inline fn Semaphore.post(n int) bool
	if this.err != 0
		return false .
	if os.isWindows
		res := ReleaseSemaphore(size_t(this.handle), n, voidptr(0))
		if !res
			err := GetLastError()
			if err != ERROR_TOO_MANY_POSTS
				this.err = err . .
		return res
	elif !os.isLinux && !os.isFreeBSD && !os.isNetBSD || this._step_or_max != 0
		bufelem := sembuf{
			sem_op: i16(n * this._step_or_max)
			sem_flg: NONBLOCK
		}
		if os.isLinux
			res2 := semop(i32(this.handle), bufelem, size_t(1))
		else
			res2 := semop(size_t(this.handle), bufelem, size_t(1)) .
		if res2 != 0
			printf("error %d\n", GetLastError()) .
		return res2 == 0
	else
		add := u64(n)
		res3 := write(int(this.handle), &add, sizeof(add))
		return res3 == sizeof(add)
