import limits

# There are a bunch of semaphore implementations in different operating
# systems:
# - System V Semaphores: available on all Unix systems including MacOSX
#      complicated API but very flexible in terms of features
# - POSIX Semoaphores: available on most modern Unix systems but not on MacOSX
#      simple, straightforward API, but less flexible, in particular lacks
#      the ability to increase the value by other values than 1
# - eventfd: available on Linux, FreeBSD and NetBSD
#      support 'select()' wait, allow increasing the value by other values than 1
# - WinAPI Semaphores: available on Microsoft Windows
#      support 'WaitForMultipleObjects()' and increasing the value by other values than 1
#
cdecl fn eventfd(initval u32, flags int) int
cdecl fn write(fd int, buf cstring, count size_t) ssize_t
cdecl fn read(fd int, buf cstring, count size_t) ssize_t
# !!! is 'long' on most systems but 'int' on Linux - but since we use eventfd on Linux semget() is not used
cdecl fn semget(key ssize_t, nsems int, semflg int) int
cdecl fn CreateSemaphoreA(lpSemaphoreAttributes voidptr, lInitialCount int, lMaximumCount int, lpName cstring) size_t

from ..io.flags import CLOEXEC, NONBLOCK, SEMAPHORE, PRIVATE, CREAT

const SEMVMX ::= if os.isLinux || os.isFreeBSD || os.isNetBSD
		0xfffffffffffffffe # eventfd() max value
	elif os.isWindows
		limits.max_int # Windows allows setting max value separately for each semaphore
	else
		32767 . # System V semaphores - usually fixed (FreeBSD: kern.ipc.semvmx, but we use eventfd)

# Use union of different representations to make Semaphore type at most 16 bytes in size

type SemaphoreEventfd {
	err int
	handle int
	_step u64
}

type SemaphoreSystemV {
	err int
	_step int
	handle ssize_t
}

type SemaphoreWindows {
	err int
	maxval int
	handle size_t
}

type Semaphore union {
	 SemaphoreEventfd
	 SemaphoreSystemV
	 SemaphoreWindows
}

pub inline fn Semaphore.err(e int) int
	if os.isLinux || os.isFreeBSD || os.isNetBSD
		return this.SemaphoreEventfd.err = e
	elif os.isWindows
		return this.SemaphoreWindows.err = e
	else
		return this.SemaphoreSystemV.err = e

pub inline fn Semaphore.err int
	if os.isWindows
		return this.SemaphoreWindows.err
	elif os.isLinux || os.isFreeBSD || os.isNetBSD
		return this.SemaphoreEventfd.err
	else
		return this.SemaphoreSystemV.err

pub const EINVAL ::= if os.isWindows
		87 # ERROR_INVALID_PARAMETER
	else
		22 .

pub fn semaphore(init int, max int) Semaphore
	sem := Semaphore{}
	if max > SEMVMX || init > max
		sem.err = EINVAL
		return sem .
	if os.isWindows
		sem.SemaphoreWindows.handle = CreateSemaphoreA(voidptr(0), 0, 1000, cstring(0))
	elif os.isLinux || os.isFreeBSD || os.isNetBSD
		sem.SemaphoreEventfd.handle = eventfd(0, CLOEXEC | NONBLOCK | SEMAPHORE)
	else
		sem.SemaphoreSystemV.handle = semget(PRIVATE, 1, 0x1ff | CREAT) .
	return sem

