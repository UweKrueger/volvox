import limits

# There are a bunch of semaphore implementations in different operating
# systems:
# - System V Semaphores: available on all Unix systems including MacOSX
#      complicated API but very flexible in terms of features
# - POSIX Semoaphores: available on most modern Unix systems but not on MacOSX
#      simple, straightforward API, but less flexible, in particular lacks
#      the ability to increase the value by other values than 1
# - eventfd: available on Linux, FreeBSD and NetBSD
#      support 'select()' wait, allow increasing the value by other values than 1
# - WinAPI Semaphores: available on Microsoft Windows
#      support 'WaitForMultipleObjects()' and increasing the value by other values than 1
#
cdecl eventfd(initval u32, flags int) int
cdecl write(fd int, buf voidptr, count ssize_t) ssize_t
cdecl read(fd int, buf voidptr, count ssize_t) ssize_t
# key is 'long' on most systems but 'int' on Linux - so declare 32 and 64 bit versions here and decide later
cdecl semget(key i32, nsems int, semflg u32) int
cdecl semget(key i64, nsems int, semflg u32) int
cdecl CreateSemaphoreA(lpSemaphoreAttributes voidptr, lInitialCount int, lMaximumCount int, lpName cstring) size_t
cdecl create_sem(count i32, name cstring) i32
cdecl delete_sem(id i32) i32
cdecl acquire_sem(id i32) i32
cdecl acquire_sem_etc(id i32, count i32, flags u32, bigtime_t i64) i32
cdecl release_sem(id i32) i32
cdecl release_sem_etc(id i32, count i32, flags u32) i32
cdecl pipe(&filedes [2]int) int
cdecl pipe2(&filedes [2]int, flags u32) int
cdecl fcntl(fd int, op int, ...) int
cdecl close(fd int) int

const SETFD := 0x004 # Haiku: set fd flags

from ..io.flags import CLOEXEC, NONBLOCK, SEMAPHORE, PRIVATE, CREAT, POLLIN

# Normally SEMVMX is is the maximum value of Sytem V semaphores - however we do not use those.
# Instead Volvox Semaphores are based on something that can be *select*ed
#
pub const SEMVMX := if os.isWindows
		# Windows native semaphores
		u64(limits.int_max)
	elif os.isLinux && !environment.isMusl || os.isFreeBSD || os.isNetBSD
		# eventfd
		u64(limits.u64_max - 1)
	else
		# pipe as last resort
		u64(512)
	end

# Use union of different representations to make Semaphore type at most 16 bytes in size

struct Semaphore {
	handle ssize_t
	err u32
}

struct pipehandle_t union {
	fds [2]int
	ssize_t
}

pub def semaphore(init_val int) Semaphore
	sem = Semaphore{}
	if init_val < 0 || u64(init_val) > SEMVMX
		sem.err = EINVAL
		return sem
	end
	if os.isWindows
		sem.handle = ssize_t(CreateSemaphoreA(voidptr(0), init_val, limits.int_max, cstring(0)))
		if sem.handle == 0
			sem.err = GetLastError()
		end
	elif os.isLinux && !environment.isMusl || os.isFreeBSD || os.isNetBSD
		sem.handle = eventfd(u32(init_val), CLOEXEC | NONBLOCK | SEMAPHORE)
		if sem.handle < 0
			sem.err = GetLastError()
		end
	else
		fds = pipehandle_t{}
		if os.isHaiku
			res = pipe(fds.fds)
			if res >= 0
				res = fcntl(fds.fds[0], SETFD, CLOEXEC | NONBLOCK)
				if res >= 0
					res = fcntl(fds.fds[1], SETFD, CLOEXEC | NONBLOCK)
				end
			end
		else
			res = pipe2(fds.fds, CLOEXEC | NONBLOCK)
		end
		if res < 0
			sem.err = GetLastError()
		else
			sem.handle = fds.ssize_t
			if init_val > 0
				buf = [init_val]u8{}
				if write(fds.fds[1], &buf, init_val) != init_val
					sem.err = GetLastError()
				end
			end
		end
	end
	return sem
end

pub def semaphore Semaphore
	return semaphore(0)
end

pub def Semaphore.close
	if os.isWindows
		success = CloseHandle(size_t(this.handle))
	elif os.isLinux && !environment.isMusl || os.isFreeBSD || os.isNetBSD
		success = close(int(this.handle)) == 0
	else
		p = pipehandle_t{ ssize_t: this.handle }
		success = close(p.fds[1]) == 0
		if (success)
			success = close(p.fds[0]) == 0
		end
	end
	if !success
		this.err = GetLastError()
	else
		this.handle = 0
	end
end

pub inline def Semaphore.max u64
	return SEMVMX
end

cdecl ReleaseSemaphore(hSemaphore size_t, lReleaseCount int, lpPreviousCount voidptr) bool

const NOWAIT := 0x800

pub def Semaphore.post(n int) bool
	if this.err != 0
		return false
	end
	if n <= 0 || n > u64(SEMVMX)
		this.err = EINVAL
		return false
	end
	if os.isWindows
		success = ReleaseSemaphore(size_t(this.handle), n, voidptr(0))
	elif os.isLinux && !environment.isMusl || os.isFreeBSD || os.isNetBSD
		add = u64(n)
		success = write(int(this.handle), &add, sizeof(add)) == sizeof(add)
	else
		c = [n]u8{}
		p = pipehandle_t{ ssize_t: this.handle }
		success = write(p.fds[1], &c, n) == n
	end
	if !success
		err = GetLastError()
		if err != ERROR_TOO_MANY_POSTS
			this.err = err
		end
	end
	return success
end

pub inline def Semaphore.post bool
	return this.post(1)
end

struct pollfd {
	fd int
	events i16
	revents i16
}

cdecl ppoll(&fds pollfd, nfds u32, ?timeout time.timespec, sigmask voidptr) int
cdecl ppoll(&fds pollfd, nfds u64, ?timeout time.timespec, sigmask voidptr) int

pub def Semaphore.wait bool
	if this.err != 0
		return false
	end
	if os.isWindows
		success = WaitForSingleObjectEx(size_t(this.handle), u32(-1), true) == 0
	else
		if os.isLinux && !environment.isMusl || os.isFreeBSD || os.isNetBSD
			fd = int(this.handle)
		else
			p = pipehandle_t{ ssize_t: this.handle }
			fd = p.fds[0]
		end
		pfd = pollfd{
			fd: fd
			events: POLLIN
		}
		err = 0U
		repeat
			if os.isLinux
				res = ppoll(pfd, size_t(1), nil, nil)
			else
				res = ppoll(pfd, u32(1), nil, nil)
			end
			if res < 0
				this.err = GetLastError()
				return false
			end
			if pfd.revents & POLLIN
				if os.isLinux && !environment.isMusl || os.isFreeBSD || os.isNetBSD
					get = u64(0)
					success = read(fd, &get, sizeof(get)) == sizeof(get)
				else
					b = u8(0)
					success = read(fd, &b, 1) == 1
				end
			else
				success = false
			end
		until success
	end
	return success
end

pub def Semaphore.timedwait(timeout time.Duration) bool
	if this.err != 0
		return false
	end
	if timeout.i64 < 0
		timeout.i64 = 0
	end
	if os.isWindows
		success = WaitForSingleObjectEx(size_t(this.handle), u32(timeout.i64 / 10000), true) == 0
	else
		timeo = timeout.timespec
		if os.isLinux && !environment.isMusl || os.isFreeBSD || os.isNetBSD
			fd = int(this.handle)
		else
			p = pipehandle_t{ ssize_t: this.handle }
			fd = p.fds[0]
		end
		pfd = pollfd{
			fd: fd
			events: POLLIN
		}
		get = u64(0)
		start_time = time.timespec{}
		time.clock_gettime(time.CLOCK_MONOTONIC, start_time)
		end_time = time.timespec_sum(start_time, timeo)
		repeat
			if os.isLinux
				res = ppoll(pfd, size_t(1), timeo, nil)
			else
				res = ppoll(pfd, u32(1), timeo, nil)
			end
			if res <= 0
				if res < 0
					this.err = GetLastError()
				end
				return false
			end
			if pfd.revents & POLLIN
				if os.isLinux && !environment.isMusl || os.isFreeBSD || os.isNetBSD
					get = u64(0)
					success = read(fd, &get, sizeof(get)) == sizeof(get)
				else
					b = u8(0)
					success = read(fd, &b, 1) == 1
				end
				if !success
					err = GetLastError()
					if err == EAGAIN
						# semaphore has been consumed by another thread so we recalculate
						# timeo and retry - TODO: on Linux use epoll() and EPOLLEXCLUSIVE
						# to make this case unlikely
						cur_time = time.timespec{}
						time.clock_gettime(time.CLOCK_MONOTONIC, cur_time)
						timeo = time.timespec_diff(end_time, cur_time)
						if timeo.sec < 0
							res = 0 # time has already elapsed
						end
					else
						this.err = err
						return false
					end
				end
			else
				success = false
			end
		until success || res == 0
	end
	return success
end

pub def Semaphore.timedwait(timeout f64) bool
	return this.timedwait(time.Duration(timeout))
end

pub def Semaphore.trywait bool
	if this.err != 0
		return false
	end
	if os.isWindows
		success = WaitForSingleObjectEx(size_t(this.handle), 0, true) == 0
	else
		if os.isLinux && !environment.isMusl || os.isFreeBSD || os.isNetBSD
			fd = int(this.handle)
		else
			p = pipehandle_t{ ssize_t: this.handle }
			fd = p.fds[0]
		end
		pfd = pollfd{
			fd: fd
			events: POLLIN
		}
		get = u64(0)
		timeo = time.timespec{}
		if os.isLinux
			res = ppoll(pfd, size_t(1), timeo, nil)
		else
			res = ppoll(pfd, u32(1), timeo, nil)
		end
		if res <= 0
			if res < 0
				this.err = GetLastError()
			end
			return false
		end
		if pfd.revents & POLLIN
			if os.isLinux && !environment.isMusl || os.isFreeBSD || os.isNetBSD
				get = u64(0)
				success = read(fd, &get, sizeof(get)) == sizeof(get)
			else
				b = u8(0)
				success = read(fd, &b, 1) == 1
			end
			if !success
				err = GetLastError()
				if err != EAGAIN
					this.err = err
				end
			end
		else
			success = false
		end
	end
	return success
end
