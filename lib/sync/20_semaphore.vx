import limits

# There are a bunch of semaphore implementations in different operating
# systems:
# - System V Semaphores: available on all Unix systems including MacOSX
#      complicated API but very flexible in terms of features
# - POSIX Semoaphores: available on most modern Unix systems but not on MacOSX
#      simple, straightforward API, but less flexible, in particular lacks
#      the ability to increase the value by other values than 1
# - eventfd: available on Linux, FreeBSD and NetBSD
#      support 'select()' wait, allow increasing the value by other values than 1
# - WinAPI Semaphores: available on Microsoft Windows
#      support 'WaitForMultipleObjects()' and increasing the value by other values than 1
#
cdecl fn eventfd(initval u32, flags int) int
cdecl fn write(fd int, buf cstring, count size_t) ssize_t
cdecl fn read(fd int, buf cstring, count size_t) ssize_t
# key is 'long' on most systems but 'int' on Linux - so declare 32 and 64 bit versions here and decide later
cdecl fn semget(key i32, nsems int, semflg u32) int
cdecl fn semget(key i64, nsems int, semflg u32) int
cdecl fn CreateSemaphoreA(lpSemaphoreAttributes voidptr, lInitialCount int, lMaximumCount int, lpName cstring) size_t
cdecl fn create_sem(count i32, name cstring) i32
cdecl fn delete_sem(id i32) i32
cdecl fn acquire_sem(id i32) i32
cdecl fn acquire_sem_etc(id i32, count i32, flags u32, bigtime_t i64) i32
cdecl fn release_sem(id i32) i32
cdecl fn release_sem_etc(id i32, count i32, flags u32) i32

from ..io.flags import CLOEXEC, NONBLOCK, SEMAPHORE, PRIVATE, CREAT, POLLIN

const SEMVMX ::= if os.isWindows || os.isHaiku
		limits.max_int # Windows allows setting max value separately for each semaphore
	else
		32767 . # System V semaphores - usually fixed (FreeBSD: kern.ipc.semvmx)

# Use union of different representations to make Semaphore type at most 16 bytes in size

type Semaphore {
	handle ssize_t
	err u32
	_step_or_max u32
}

pub const EINVAL ::= if os.isWindows
		87 # ERROR_INVALID_PARAMETER
	else
		22 .

cdecl fn GetLastError() u32

pub fn semaphore(init_val int, desired_max int) Semaphore
	sem := Semaphore{}
	if desired_max > SEMVMX || desired_max != 0 && init_val > desired_max
		sem.err = EINVAL
		return sem .
	if os.isWindows || os.isHaiku
		if desired_max == 0
			desired_max = SEMVMX . .
	if os.isWindows
		sem.handle = ssize_t(CreateSemaphoreA(voidptr(0), init_val, desired_max, cstring(0)))
		if sem.handle == 0
			sem.err = GetLastError()
			return sem .
		sem._step_or_max = u32(desired_max)
	else
		if os.isHaiku
			sem.handle = create_sem(init_val, cstring(0))
		else
			if desired_max == 0
				if os.isLinux || os.isFreeBSD || os.isNetBSD
					sem.handle = eventfd(0, CLOEXEC | NONBLOCK | SEMAPHORE)
					if sem.handle < 0
						sem.err = GetLastError() .
					return sem
				else
					desired_max = SEMVMX . .
			if os.isLinux
				sem.handle = semget(i32(PRIVATE), 1, 0x180)
			else
				sem.handle = semget(size_t(PRIVATE), 1, 0x180) . .
		if sem.handle < 0
			sem.err = GetLastError()
			return sem .
		sem._step_or_max = u32(SEMVMX) / u32(desired_max) .
	return sem

pub fn semaphore(init_val int) Semaphore
	return semaphore(init_val, 0)

pub fn semaphore Semaphore
	return semaphore(0, 0)

pub inline fn Semaphore.is_selectable bool
	if os.isWindows || os.isHaiku
		return true
	if os.isLinux || os.isFreeBSD || os.isNetBSD
		return this._step_or_max == 0
	else
		return false

pub inline fn Semaphore.max u64
	if os.isWindows || os.isHaiku
		return this._step_or_max
	elif this._step_or_max == 0
		return 0xfffffffffffffffe # eventfd max value
	else
		return SEMVMX / this._step_or_max

cdecl fn ReleaseSemaphore(hSemaphore size_t, lReleaseCount int, lpPreviousCount voidptr) bool

type sembuf {
	sem_num u16
	sem_op i16
	sem_flg u32
}

cdecl fn semop(semid int, &sops sembuf, nsops size_t) int
cdecl fn write(fd int, buf voidptr, count size_t) ssize_t

const ERANGE ::= if os.isWindows
		298 # ERROR_TOO_MANY_POSTS
	else
		34 .

const NOWAIT ::= 0x800

pub fn Semaphore.post(n int) bool
	if this.err != 0
		return false .
	if n <= 0
		this.err = EINVAL
		return false .
	if os.isWindows
		success := ReleaseSemaphore(size_t(this.handle), n, voidptr(0))
	elif os.isHaiku
		this.err = u32(release_sem(i32(this.handle)))
		success := this.err == 0
	elif !os.isLinux && !os.isFreeBSD && !os.isNetBSD || this._step_or_max != 0
		count := n * this._step_or_max
		if count > SEMVMX
			this.err = ERANGE
			return false .
		bufelem := sembuf{
			sem_op: i16(count)
			sem_flg: NOWAIT
		}
		printf("adding %d\n", bufelem.sem_op)
		success := semop(int(this.handle), bufelem, size_t(1)) == 0
	else
		add := u64(n)
		success := write(int(this.handle), &add, sizeof(add)) == sizeof(add) .
	if !success
		err := GetLastError()
		if err != ERANGE
			this.err = err . .
	return success

pub inline fn Semaphore.post bool
	return this.post(1)

type pollfd {
	fd int
	events i16
	revents i16
}

cdecl fn ppoll(&fds pollfd, nfds u32, ?timeout time.timespec, sigmask voidptr) int
cdecl fn ppoll(&fds pollfd, nfds u64, ?timeout time.timespec, sigmask voidptr) int
cdecl fn read(fd int, buf voidptr, count size_t) ssize_t

pub fn Semaphore.wait bool
	if this.err != 0
		return false .
	if os.isWindows
		success := WaitForSingleObjectEx(size_t(this.handle), u32(-1), true) != 0
	elif os.isHaiku
		this.err = u32(acquire_sem(i32(this.handle)))
		success := this.err == 0
	elif !os.isLinux && !os.isFreeBSD && !os.isNetBSD || this._step_or_max != 0
		bufelem := sembuf{
			sem_op: -i16(this._step_or_max)
		}
		success := semop(int(this.handle), bufelem, 1) == 0
		if !success
			this.err = GetLastError() .
	else
		get := u64(0)
		pfd := pollfd{
			fd: int(this.handle)
			events: POLLIN
		}
		err := 0u32
		repeat
			if os.isLinux
				res := ppoll(pfd, size_t(1), nil, nil)
			else
				res := ppoll(pfd, u32(1), nil, nil) .
			if res < 0
				this.err = GetLastError()
				return false .
			if pfd.revents & POLLIN
				success := read(int(this.handle), &get, sizeof(get)) == sizeof(get)
			else
				success := false .
		until success .
	return success

type object_wait_info {
	object i32 # ID of the object
	typ    u16 # type of the object
	events u16 # events mask
}

const B_OBJECT_TYPE_SEMAPHORE ::= 1
const B_EVENT_ACQUIRE_SEMAPHORE ::= 0x0001 # semaphore can be acquired

cdecl fn wait_for_objects_etc(&infos object_wait_info, numInfos int, flags u32, timeout i64) ssize_t

pub fn Semaphore.timedwait(timeout time.Duration) bool
	if this.err != 0
		return false .
	if timeout.i64 < 0
		timeout.i64 = 0 .
	if os.isWindows
		success := WaitForSingleObjectEx(size_t(this.handle), u32(timeout.i64 / 10000), true) != 0
	elif os.isHaiku
		# this does not work - maybe a bug in Haiku
		this.err = u32(acquire_sem_etc(i32(this.handle), 1, 0, timeout.i64 / 10))
		# info := object_wait_info{
		# 	object : i32(this.handle)
		# 	typ: B_OBJECT_TYPE_SEMAPHORE
		# 	events: B_EVENT_ACQUIRE_SEMAPHORE
		# }
		# n := wait_for_objects_etc(info, 1, 0, timeout.i64 / 10)
		success := this.err == 0
		this.err = 0
	elif !os.isLinux && !os.isFreeBSD && !os.isNetBSD || this._step_or_max != 0
		bufelem := sembuf{
			sem_op: -i16(this._step_or_max)
		}
		success := semop(int(this.handle), bufelem, 1) == 0
		if !success
			this.err = GetLastError() .
	else
		get := u64(0)
		pfd := pollfd{
			fd: int(this.handle)
			events: POLLIN
		}
		err := 0u32
		repeat
			if os.isLinux
				res := ppoll(pfd, size_t(1), nil, nil)
			else
				res := ppoll(pfd, u32(1), nil, nil) .
			if res < 0
				this.err = GetLastError()
				return false .
			if pfd.revents & POLLIN
				success := read(int(this.handle), &get, sizeof(get)) == sizeof(get)
			else
				success := false .
		until success .
	return success

