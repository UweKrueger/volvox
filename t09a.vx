def test_vec_iter_up_2 bool
	gQ = vec{ "SdRt", "-3.125", "p_Qrt" }
	sum = " "
	for vLkM in gQ
		sum += vLkM + " "
	end
	return sum == " SdRt -3.125 p_Qrt "
end

def test_vec_iter_down_1 bool
	gQ = vec{ "SdRt", "-3.125", "p_Qrt", "56ffg" }
	sum = " "
	for vLkM ~in gQ
		sum += vLkM + " "
	end
	return sum == " p_Qrt -3.125 SdRt "
end
