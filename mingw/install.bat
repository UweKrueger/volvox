@echo off
setlocal
set LLVM_VER=23.1.3
set MINGW_VER=v14.0.0
set GCC_VER=16.2.0
set ZLIB_VERSION=1.3.2
set ZSTD_VERSION=1.5.7
set VOLVOX_VER=0.02

set EXITCODE=0

rem files that have been alredy downloaded by prepare.bat (as needed)
set CLANGLLVM=clang+llvm-%LLVM_VER%-x86_64-pc-windows-msvc
set CLANGLLVMPKG=%CLANGLLVM%.tar.zst
set MINGWPKG=mingw-%MINGW_VER%-stdc++-%GCC_VER%-ucrt.txz
set GCCPKG=gcc-%GCC_VER%-mingw-%MINGW_VER%-ucrt.txz
set VOLVOXPKG=volvox-Windows-%VOLVOX_VER%.txz

rem compression libs generated by build-z.bat here
set ZLIB_DLL=zlib-%ZLIB_VERSION%\zlib1.dll
set ZLIB_DLLLIB=zlib-%ZLIB_VERSION%\zdll.lib
set ZSTD_DLL=zstd-%ZSTD_VERSION%\build\VS_scripts\bin\Release\x64\libzstd.dll
set ZSTD_DLLLIB=zstd-%ZSTD_VERSION%\build\VS_scripts\bin\Release\x64\libzstd.lib
set ZSTD_EXE=zstd-%ZSTD_VERSION%\build\VS_scripts\bin\Release\x64\zstd.exe

rem compression libs downloaded as part of %VOLVOXPKG%
set ZLIB_DLL_PKG=bin\zlib1.dll
set ZLIB_DLLLIB_PKG=lib\volvox\zdll.lib
set ZSTD_DLL_PKG=bin\libzstd.dll
set ZSTD_DLLLIB_PKG=lib\volvox\libzstd.lib
set ZSTD_EXE_PKG=bin\zstd.exe

rem clang/llvm should have been installed already by prepare.bat
rem we only need LLVM headers and libs to develop Volvox
set INSTALL_CLANGLLVM=false

rem gcc/mingw is preferred over mingw alone since gcc is needed to
rem generate debugging information for mingw TLS globals (LLVM-23)
set INSTALL_MINGW=false
set INSTALL_GCC_MINGW=true

rem by default Volvox is installed to LLVM - including z components
set INSTALL_VOLVOX=true
set INSTALL_Z_TO_LLVM=false
set INSTALL_Z_LOCAL=false

rem find out if we are running with Administrator privileges
set RUNNING_AS_ADMIN=false
net session >nul 2>&1
if ERRORLEVEL 1 goto no_admin
set RUNNING_AS_ADMIN=true
:no_admin

if "%~1"=="" goto start_install
if not "%~1"=="devel" goto no_devel_1
set INSTALL_CLANGLLVM=true
set INSTALL_Z_TO_LLVM=true
set INSTALL_VOLVOX=false
goto arg1_ok_2
:no_devel_1
if not "%~1"=="no_gcc" goto gcc_1
set INSTALL_MINGW=true
set INSTALL_GCC_MINGW=false
goto arg1_ok
:gcc_1
if not "%~1"=="z" goto z_1
set INSTALL_Z_LOCAL=true
set INSTALL_GCC_MINGW=false
set INSTALL_VOLVOX=false
goto compresslibs

:z_1
goto opterr

:arg1_ok
if "%~2"=="" goto start_install
if not "%~2"=="devel" goto gcc_2
set INSTALL_CLANGLLVM=true
set INSTALL_Z_TO_LLVM=true
set INSTALL_VOLVOX=false
goto arg2_ok
:arg1_ok_2
if "%~2"=="" goto start_install
if not "%~2"=="no_gcc" goto gcc_2
set INSTALL_MINGW=true
set INSTALL_GCC_MINGW=false
set INSTALL_VOLVOX=false
goto arg2_ok
:gcc_2
goto opterr2

:arg2_ok
if "%~3"=="" goto start_install
echo invalid 3rd option "%~3" 1>&2
goto opterr

:compresslibs
if "%~2"=="" goto check_admin_z
echo unexpected option "%~2" - "z" does not allow other options
goto opterr

:check_admin_z
if "%RUNNING_AS_ADMIN%"=="false" goto admin_status_valid
echo Option "z" should not be used as Administrator
exit /b 1

:start_install
if "%RUNNING_AS_ADMIN%"=="true" goto admin_status_valid
echo This script should be run as Administrator unless "z" Option is used
exit /b 1

:admin_status_valid
echo INSTALL_CLANGLLVM: %INSTALL_CLANGLLVM%
echo INSTALL_MINGW: %INSTALL_MINGW%
echo INSTALL_GCC_MINGW: %INSTALL_GCC_MINGW%
echo INSTALL_VOLVOX: %INSTALL_VOLVOX%
echo INSTALL_Z_TO_LLVM: %INSTALL_Z_TO_LLVM%
echo INSTALL_Z_LOCAL: %INSTALL_Z_LOCAL%
echo RUNNING_AS_ADMIN: %RUNNING_AS_ADMIN%

if exist "C:\Program Files\LLVM\" goto llvm_dir_avail
echo directory "C:\Program Files\LLVM\" does not exists
echo please run `prepare.bat` / LLVM installer first
exit /b 1

:llvm_dir_avail
rem set NEED_Z = %INSTALL_Z_LOCAL%" || %INSTALL_Z_TO_LLVM%
set NEED_Z=false
if not "%INSTALL_Z_LOCAL%"=="true" goto no_z_local
set NEED_Z=true
goto no_z_llvm
:no_z_local
if not "%INSTALL_Z_TO_LLVM%"=="true" goto no_z_llvm
set NEED_Z=true
:no_z_llvm
if not "%NEED_Z%"=="true" goto end_z_install
if exist %ZSTD_EXE% goto z_not_missing
echo file "%ZSTD_EXE%" is missing
echo please run `build-z.bat` as normal user
exit /b 1

:z_not_missing
if not "%INSTALL_Z_TO_LLVM%"=="true" goto maybe_z_local
echo on
copy %ZLIB_DLL% "C:\Program Files\LLVM\bin\"
copy %ZSTD_DLL% "C:\Program Files\LLVM\bin\"
copy %ZSTD_EXE% "C:\Program Files\LLVM\bin\"
copy %ZLIB_DLLLIB% "C:\Program Files\LLVM\lib\"
copy %ZSTD_DLLLIB% "C:\Program Files\LLVM\lib\"
@echo off

:maybe_z_local
if not "%INSTALL_Z_TO_LLVM%"=="true" goto end_z_install
echo on
copy %ZLIB_DLL% ..\bin
copy %ZSTD_DLL% ..\bin
copy %ZSTD_EXE% ..\bin
copy %ZLIB_DLLLIB% ..\lib\volvox
copy %ZSTD_DLLLIB% ..\lib\volvox
@echo off

:end_z_install

if not "%INSTALL_CLANGLLVM%"=="true" goto end_clangllvm
if exist "%CLANGLLVMPKG%" goto clangllvm_not_missing
echo package file "%CLANGLLVMPKG%" is missing
echo please download from https://github.com/llvm/llvm-project/releases/
exit /b 1

:clangllvm_not_missing
echo extracting llvm+clang devel components to "C:\Program Files" ...
rem Windows tar does not support zstd --max compressed files
rem so use a pipe with zstd (from "C:\Program Files\LLVM\bin", see above)
zstd -d --long=31 --stdout "%CLANGLLVMPKG%" | tar -x -f - -C "C:\Program Files\LLVM" --strip-components=1 %CLANGLLVM%/bin/llvm-config.exe %CLANGLLVM%/include/ %CLANGLLVM%/lib/LLVM[A-Z]*.lib %CLANGLLVM%/include/ %CLANGLLVM%/lib/LLVM[a-z]*.lib %CLANGLLVM%/lib/lld*.lib
if ERRORLEVEL 1 exit /b %ERRORLEVEL%
echo ... done

:end_clangllvm
if not "%INSTALL_MINGW%"=="true" goto end_mingw
if exist %MINGWPKG% goto mingw_not_missing
echo package file "%MINGWPKG%" is missing
echo please run `prepare.bat` first
exit /b 1

:mingw_not_missing
echo extracting MINGW to "C:\Program Files\LLVM" ...
tar -x -z -f %MINGWPKG% -C "C:\Program Files\LLVM"
if ERRORLEVEL 1 exit /b %ERRORLEVEL%
echo ... done
echo.
echo setting often used LLVM binary utilities as default
for %%F in (ar nm objdump ranlib size strings strip) do mklink "C:\Program Files\LLVM\bin\%%F.exe" llvm-%%F.exe
mklink "C:\Program Files\LLVM\bin\cc.exe" clang.exe
mklink "C:\Program Files\LLVM\bin\c++.exe" clang++.exe
mklink "C:\Program Files\LLVM\bin\ld.exe" ld.lld.exe

:end_mingw
if not "%INSTALL_GCC_MINGW%"=="true" goto end_gcc
if exist %GCCPKG% goto gcc_not_missing
echo package file "%GCCPKG%" is missing
echo please run `prepare.bat` first
exit /b 1

:gcc_not_missing
echo extracting GCC+MINGW to "C:\Program Files\LLVM" ...
tar -x -z -f %GCCPKG% -C "C:\Program Files\LLVM"
if ERRORLEVEL 1 exit /b %ERRORLEVEL%
echo ... done

:end_gcc
if not "%INSTALL_VOLVOX%"=="true" goto end_volvox
if exist %VOLVOXPKG% goto volvox_not_missing
echo package file "%VOLVOXPKG%" is missing
echo please run `prepare.bat` first
exit /b 1

:volvox_not_missing
echo extracting Volvox compiler to "C:\Program Files\LLVM" ...
tar -x -z -f %VOLVOXPKG% -C "C:\Program Files\LLVM"
if ERRORLEVEL 1 exit /b %ERRORLEVEL%
echo ... all done

:end_volvox
exit /b 0

:opterr2
echo unknown option: "%~2" 1>&2
set EXITCODE=1
goto usage
:opterr
if "%~1"=="-h" goto usage
set EXITCODE=1
echo unknown option: "%~1" 1>&2
:usage
echo usage:
echo     %0 [-h^|z^|[devel] [no_gcc]]
echo.
echo     -h ...... print this help message
echo     z ....... install zlib and zstd components locally
echo     devel ... install components to build Volvox compiler
echo     no_gcc .. install MINGW components but not GCC
echo.
echo default: install Volvox, GCC, MINGW and compression components system wide
exit /b %EXITCODE%
