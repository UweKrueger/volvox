# emutls uses memory blocks that contain "EXTRA_ALIGN_PTR_BYTES"
# below the region pointed to, to emulate aligned malloc() - unless
# EMUTLS_USE_POSIX_MEMALIGN is set. The latter is not the default
# on most platforms but we can safely suppress the corresponding
# valgrind warning using "--suppressions=valgrind/emutls.supp"
{
   emutls/aligned_malloc
   Memcheck:Leak
   match-leak-kinds: possible
   fun:malloc
   fun:emutls_alloc
   fun:__emutls_get_address
   obj:*
   fun:_Z21GetTopLevelExpressionj
   fun:_ZL8MainLoopv
   fun:main
}
