TOKEN(pow) /* ^ */ \
TOKEN(unary) /* +, -, !, ~, <- */ \
TOKEN(invisible) /* invisible operator in `sin x` or `2a` or `sin 2x` = `sin(2x)` - right binding */ \
TOKEN(mult) /* *, /, %, <<, >> */ \
TOKEN(add) /* +, -, ~ */ \
TOKEN(cmp) /* >=, >, ==, !=, <, <=, <=> */ \
TOKEN(bitand) /* & */ \
TOKEN(xor) /* >< (bitwise between bool or int) */ \
TOKEN(bitor) /* | */ \
TOKEN(and) /* && (between bool or unsigned, result: bool) */ \
TOKEN(or) /* || (between bool or unsigned, result: bool) */ \
TOKEN(arrow) /* <- */ \
TOKEN(range) /* .. */ \
TOKEN(colon) \
TOKEN(ternary) /* binary ? as part of ternary 'cond ? val_true : val_false' */ \
TOKEN(comma) \
