fn call_by_ref_1(x &f64) f64
	a := x
	x = a / 2
	return a

p32 := -12.25

fn test_call_by_ref_1() bool
	rrq := call_by_ref_1(p32)
	return rrq == -12.25 & p32 == -6.125

fn mod_val_array(qq4 [7]f64) f64
	qq4[2] = qq4[3] + qq4[1]
	return 2 * qq4[2]

fn test_array_call_by_value_1() bool
	ma := [7]f64{2.25, 3.5, -12.125, 13.75, 0.5, -0.75, 0.125}
	s78 := mod_val_array(ma)
	return ma[2] == -12.125 & s78 == 34.5

fn mod_val_array_2(qq5 [7]f64) f64
	ri := mod_val_array(qq5)
	return ri + qq5[2]

fn test_array_call_by_value_2() bool
	ma := [7]f64{1.5, -2.25, 2.5, -3.125, -0.0625, 0.5, -0.25}
	s79 := mod_val_array_2(ma)
	return ma[2] == 2.5 & s79 == -8.25

fn mod_val_array_3(qq4 &[7]f64) f64
	qq4[2] = qq4[3] + qq4[1]
	return 2 * qq4[2]

fn test_array_call_by_ref_2() bool
	ma := [7]f64{2.25, 3.5, -12.125, 13.75, 0.5, -0.75, 0.125}
	s78 := mod_val_array_3(ma)
	return ma[2] == 17.25 & s78 == 34.5

fn mod_val_array_4(qq5 &[7]f64) f64
	ri := mod_val_array_3(qq5)
	return ri + qq5[2]

fn test_array_call_by_ref_3() bool
	ma := [7]f64{1.5, -2.25, 2.5, -3.125, -0.0625, 0.5, -0.25}
	s79 := mod_val_array_4(ma)
	return ma[2] == -5.375 & s79 == -16.125
