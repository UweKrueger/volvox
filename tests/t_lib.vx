import rand

const n_pi = 10000000

fn test_rand_f64 bool
	n = 0
	s = 0
	global n_pi
	while n < n_pi
		x = rand.f64
		y = rand.f64
		if x*x + y*y < 1.0
			s++
		end
		n++
	end
	p = 4. * s / n_pi
	# printf("approximation for pi: %.5f\n", p)
	return p > 3.139 && p < 3.144
end

const n_pi_2 = 1000000

fn test_rand_f32 bool
	s = 0
	global n_pi_2
	for n in 1 .. n_pi_2
		x = rand.f32
		y = rand.f32
		if x*x + y*y < 1.0f
			s++
		end
	end
	p = 4f * f32(s) / f32(n_pi_2)
	# printf("approximation for pi: %.5f\n", p)
	return p > 3.138f && p < 3.145f
end

import time

fn test_sleep bool
	s = time.StopWatch{}
	time.sleep(0.35)
	s.stop
	e = s.elapsed
	# printf("elapsed time: %.5f\n", e)
	return e >= 0.35 && e < 0.38
end

import sync

fn test_semaphore_1 bool
	s = sync.semaphore(3)
	success = s.wait && s.wait && s.wait
	s.close
	return success
end

fn test_semaphore_2 bool
	s = sync.semaphore
	s.post
	s.post
	a = s.timedwait(0.0)
	b = s.timedwait(1.0)
	c = s.timedwait(0.05)
	success = a && b && !c && s.err == 0
	s.close
	return success
end

