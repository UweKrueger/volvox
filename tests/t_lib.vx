import time

def test_sleep bool
	s = time.StopWatch{}
	time.sleep(0.35)
	s.stop
	e = s.elapsed
	# _printf("elapsed time: %.5f\n", e)
	return e >= 0.35 && e < 0.38
end

import sync

def test_semaphore_1 bool
	s = sync.semaphore(3)
	success = s.wait && s.wait && s.wait
	s.close
	return success
end

def test_semaphore_2 bool
	s = sync.semaphore
	s.post
	s.post
	a = s.timedwait(0.0)
	b = s.timedwait(1.0)
	c = s.timedwait(0.05)
	success = a && b && !c && s.err == 0
	s.close
	return success
end

def test_virtual_field bool
	z = time.now.gm
	m = rand.int(12) + 1
	z.mon = m
	return z.mon == m && z._mon == m-1
end

