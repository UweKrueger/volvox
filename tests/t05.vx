struct XX {
	a i32
	b f64
}

global cntd = 10

struct YY {
	r i32
	w XX
}

def ~YY
	cntd = cntd - this.r
	this.r = 79
end

# def YY
# 	return
# end

def YY bool
	return this.r == -13
end

def hhwe i32
	llk3e = YY{ r: 17 }
	return llk3e.r
end

def test_destructor_1 bool
	z = hhwe
	return z == 17 && cntd == -7
end

def hhwe2(n i32) i32
	if n<=0
		llk3e = YY{ r: n-8 }
		return llk3e.r
	end
	return 5
end

def test_destructor_2 bool
	z = hhwe2(-5)
	return cntd == 6 && z == -13
end

def hhwe3(n i32) i32
	if n>7
		x = YY{ r: n, w: XX{ a: -71 }}
		n = n + x.w.a
	else
		n = n - 1
	end
	return n
end

def test_destructor_then_branch_1 bool
	k = hhwe3(8)
	return cntd == -2 && k == -63
end

def hhwe4(n i32) i32
	w = n
	repeat
		x = YY{ r: n, w: XX{ a: 13 }}
		n = n - 1
		w = w + n
	until n <= 2
	x.r = -25
	return w
end

def test_destructor_repeat_stack_restore_1 bool
	p = hhwe4(7)
	return cntd == 1 && p == 27
end

struct LL {
	a i32
	p YY
}

def test_auto_destructor_1 bool
	if cntd > 0
		p = LL{ a: 3, p: YY{ r: 5 }}
		p.p.r = p.p.r - 1
	end
	return cntd == -3
end

cntd = 100

def test_array_destructor_1 bool
	if cntd > 99
		iorrt = 34.5
		prtz = [2][cntd-95][2]LL{ 0: { 0: { 0: LL{ a: 3, p: YY{ r: 2 }}}}, 1: { 4: { 1: LL{ p: YY{ r: 3 }}}}}
		prtz[1][4][0].p.r = 7
	end
	return cntd == 88
end

def call_array_destructor f64
	iorrt = 34.5
	prtz = [2][5][2]LL{ 0: { 0: { 0: LL{ a: 3, p: YY{ r: 7 }}}}, 1: { 3: { 1: LL{ p: YY{ r: 31 }}}}}
	prtz[1][1][1].p.r = -13
	return iorrt + prtz[1][4][0].p.r
end

def test_array_destructor_2 bool
	call_array_destructor
	return cntd == 63
end

struct QQ {
	a [5]YY
}

cntd = 200

def test_array_destructor_3 bool
	if cntd > 100
		rr = QQ{ a: [ YY{ r: 3 }, YY{ r: 10 }, YY{ r: -7 }, YY{}, YY{ r: 23 } ] }
	end
	return cntd == 171
end

struct RR {
	z f64
	a [5]YY
}

def ~RR
	this.z = 45.8
end

cntd = 150

def call_array_destr2 i32
	rr = RR{ a: [ YY{ r: 3 }, YY{ r: 10 }, YY{ r: -7 }, YY{}, YY{ r: 23 } ] }
	return rr.a[2].r
end

def test_array_destructor_4 bool
	x = call_array_destr2
	return x == -7 && cntd == 121
end

