fn fib(x u64) u64
	t := if x < 3 then
	    1u64
	else
	    fib(x - 2) + fib(x - 1)
	end
	return t

fn test_fibonacci() bool
	return fib(39) == 63245986

fn factorial(n i64) i64
	return if n > 1 then
		n * factorial(n - 1)
	else
		1
	end

fn test_factorial() bool
	return factorial(15) == 1307674368000i64

if true then 4 else 5 end

fn loo(x f64) f64
	sum := 0.
	xx := x
	while xx < 12 do
		sum = sum + xx
		xx = xx + 1
		end
	return sum

fn test_while() bool
   return loo(3.25) == 65.25
