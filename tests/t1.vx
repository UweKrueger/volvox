fn fib(x u64) u64
	t = if x < 3
	    1u64
	else
	    fib(x - 2) + fib(x - 1)
	end
	return t

fn test_fibonacci bool
	return fib(39) == 63245986

fn factorial(n i64) i64
	return if n > 1
		n * factorial(n - 1)
	else
		1
	end

fn test_factorial bool
	return factorial(15) == 1307674368000i64

const r6zer ::= if false || true; 4 else 5 end
const r7zrr ::= if true && false; 7.5 else -3.75 end

fn test_const_condition bool
	global r6zer, r7zrr
	return r6zer == 4 && r7zrr == -3.75

cdecl fn function_that_does_not_exist(x f64) f64

fn test_branch_elimination_1 bool
	if 4 > 5
		a = 13
		if function_that_does_not_exist(1.2) > 7.5
			a += 4
		end
	else
		a = -4
	end
	return a < 0

fn test_branch_elimination_2 bool
	if 4 < 5
		b = 89.0625
	else
		b = function_that_does_not_exist(1.2)
		b += 4
	end
	return b == 89.0625

fn loo(x f64) f64
	sum = 0.
	xx = x
	while xx < 12
		sum = sum + xx
		xx = xx + 1
	end
	return sum

fn test_while bool
   return loo(3.25) == 65.25

fn loo2(x f64) f64
	sum = 0.
	xx = x
	while xx >= -11.25
		sum = sum + xx
		xx = xx - 1.5
	else
		sum = -55.0625
	end
	return sum

fn test_while_2 bool
   return loo2(-11.3) == -55.0625

fn test_while_3 bool
   return loo2(-9.5) == -20.5

fn gwhel(r f64) f64
	n = 2.25
	while r < 2557.5
		r = r + 1
		aaap = r + n
		n = aaap + 1
	else
		aaap = -13.0625
	end
	return aaap

fn test_while_else_const_alloc_1 bool
	return gwhel(6.75) == 3274847.5

fn test_while_else_const_alloc_2 bool
	return gwhel(2557.5) == -13.0625

fn ghjj(wwj i32, rtt f64) f64
	n = 12.75
	p = 10
	while rtt < 23.75
		aaaq = [wwj+p]f64{200: 34.5, 300: -17.25}
		aaaq[wwj+p-1] = 1.125 + rtt
		n = n + 1.125
		aaaq[wwj/3] = aaaq[wwj/3] + n + aaaq[wwj/2] + aaaq[wwj+p-1]
		rtt = aaaq[wwj+p-1]
		p = p + 20
	else
		aaaq = [wwj+7]f64{}
		aaaq[wwj+6] = 67.25
		aaaq[wwj+3] = -13.125
		aaaq[wwj/3] = aaaq[wwj+6] + aaaq[wwj+3]
	end
	return aaaq[wwj/3]

fn test_while_else_dyn_alloc_1 bool
	return ghjj(600, -125.75) == 203.5

fn test_while_else_dyn_alloc_2 bool
	return ghjj(600, 25) == 54.125

fn dorep f64
	a7 = 0
	bpp = 1.25
	repeat
		a7 = a7 + 1
		bpp = bpp + a7
	until a7 > 10
	return bpp

fn test_repeat_1 bool
	return dorep == 67.25

fn vecrep(a7 int) f64
	bpp = -7.25
	repeat
		vd = [a7]f64{5: 13.75}
		vd[a7-1] = vd[5] + bpp
		bpp = .5 + vd[a7-1]
		a7 = a7 + 873
	until a7 >= 100000
	return vd[a7-874]

fn test_repeat_dyn_array bool
	return vecrep(1000) == 1616.75

fn merge_array(i int) real
	if i > 3
		L = [3][i+1][i+2]real{1: {2: {3: -23.75}}}
	else
		L = [i+5][5][i+7]real{1: {2: {3: 7.25}}}
	end
	return L[1][2][3]

fn test_merge_different_but_compatible_arrays_1 bool
	return merge_array(3) == 7.25

fn test_merge_different_but_compatible_arrays_2 bool
	return merge_array(4) == -23.75

fn merge_array_2(i int) real
	while i > 3
		L = [4][7][4]real{1: {2: {3: i+12}}}
		i = i - 1
		L[0][0][0] = i * L[1][2][3]
	else
		L = [5][5][4+i]real{{{-17}}, 1: {2: {3: 7.25}}}
	end
	return L[0][0][0] + L[1][2][3]

fn test_merge_different_but_compatible_arrays_3 bool
	return merge_array_2(15) == 64

fn test_merge_different_but_compatible_arrays_4 bool
	return merge_array_2(2) == -9.75

# TODO: fixed but diffent dimensions

fn merge_array_3(i int) real
	L = if i > 3
		S = [4]real{1: i+12}
		S
	else
		T = [4]real{-17, 1: 7.25}
		T
	end
	return L[0] + L[1]

fn test_merge_if_else_1 bool
	return merge_array_3(2) == -9.75

fn test_merge_if_else_2 bool
	return merge_array_3(4) == 16

fn merge_array_4(i int) real
	L = while i > 4
		i = i - 1
		[4]real{2: i+11}
	else
		[i+7]real{-17, 2: 7.25}
	end
	return L[0] + L[2]

fn test_merge_if_else_3 bool
	return merge_array_4(2) == -9.75

fn test_merge_if_else_4 bool
	return merge_array_4(7) == 15

fn merge_array_5(i int) real
	L = if i > 3
		S = [4][7][4]real{1: {2: {3: i+12}}}
		S
	else
		T = [4][7][4]real{{{-17}}, 1: {2: {3: 7.25}}}
		T
	end
	return L[0][0][0] + L[1][2][3]

fn test_merge_if_else_5 bool
	return merge_array_5(7) == 19

fn test_merge_if_else_6 bool
	return merge_array_5(3) == -9.75

fn merge_array_6(i int) real
	L = if i > 3
		[4][7+i][4]real{1: {2: {3: i+13}}}
	else
		[8][7][4+i]real{{{-18}}, 1: {2: {3: 7.25}}}
	end
	return L[0][0][0] + L[1][2][3]

fn test_merge_if_else_7 bool
	return merge_array_6(7) == 20

fn test_merge_if_else_8 bool
	return merge_array_6(3) == -10.75

fn merge_array_7(i int) real
	if i > 3
		L = [4]real{1: i+12}
	else
		L = [5]real{-17, 1: 7.25}
	end
	return L[0] + L[1]

fn test_merge_if_else_9 bool
	return merge_array_7(4) == 16

fn test_merge_if_else_10 bool
	return merge_array_7(2) == -9.75

fn merge_array_8(i int) real
	L = if i > 3
		[4]real{1: i+12}
	else
		[5]real{-17, 1: 7.25, 3: -17}
	end
	return L[0] + L[1]

fn test_merge_if_else_11 bool
	return merge_array_8(4) == 16

fn test_merge_if_else_12 bool
	return merge_array_8(2) == -9.75

fn merge_array_9(i int) real
	L = if i > 3
		S = [4]real{1: i+12}
		S
	else
		T = [5]real{-17, 1: 7.25}
		T
	end
	return L[0] + L[1]

fn test_merge_if_else_13 bool
	return merge_array_9(3) == -9.75

fn test_merge_if_else_14 bool
	return merge_array_9(5) == 17
