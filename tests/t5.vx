import tests.testmod.subb
import tests.testmod.suba

global hjggd := subb.CCv{
	w: suba.QQrt{
		q: [1.25, -6.75, 0.0625, 1.5, -3.75]
		pp: 67.0625
	}
}

fn test_multi_level_type_import() bool
	return hjggd.w.q[1] == -6.75 & hjggd.w.pp == 67.0625 & hjggd.z.q.e == 0.

global oolt := 12.125

oolt = oolt + 3

rrwe := 78.5 + oolt

oolt = oolt + rrwe

fn test_non_global_main_var_1() bool
	return oolt == 108.75

kkq93 := 6
pp372 := 5

xpps29 := [kkq93][7][pp372]f64{2: {1: {3: 8.25}}, 5: {6: {4: -3.5}}}

global jjf04 := 0.

jjf04 = xpps29[0][0][0] + xpps29[2][1][3] + xpps29[5][6][4]

fn test_non_const_size_main_array() bool
	return jjf04 == 4.75

type XX {
	a i32
	b f64
}

global cntd := 10

type YY {
	r i32
	w XX
}

fn ~YY()
	cntd = cntd - this.r
	this.r = 79
	return

fn YY()
	this.r = -23
	return

fn hhwe() i32
   llk3e := YY{ r: 17 }
   return llk3e.r

fn test_destructor_1() bool
	z := hhwe()
	return z == 17 & cntd == -7

fn hhwe2(n i32) i32
	if n<=0
		llk3e := YY{ r: n-8 }
		return llk3e.r .
	return 5

fn test_destructor_2() bool
	z := hhwe2(-5)
	return cntd == 6 & z == -13

fn hhwe3(n i32) i32
	if n>7
		x := YY{ r: n, w: XX{ a: -71 }}
		n = n + x.w.a
	else
		n = n - 1 .
	return n

fn test_destructor_then_branch_1() bool
	k := hhwe3(8)
	return cntd == -2 & k == -63

fn hhwe4(n i32) i32
	w := n
	repeat
		x := YY{ r: n, w: XX{ a: 13 }}
		n = n - 1
		w = w + n
	until n <= 2
	x.r = -25
	return w

fn test_destructor_repeat_stack_restore_1() bool
	p := hhwe4(7)
	return cntd == 1 & p == 27

type LL {
	a i32
	p YY
}

fn test_auto_destructor_1() bool
	if cntd > 0
		p := LL{ a: 3, p: YY{ r: 5 }}
		p.p.r = p.p.r - 1 .
	return cntd == -3

cntd = 100

fn test_array_destructor_1() bool
	if cntd > 99
		iorrt := 34.5
		prtz := [5][cntd][2]LL{ 0: { 0: { 0: LL{ a: 3, p: YY{ r: 2 }}}}, 4: { 99: { 1: LL{ p: YY{ r: 3 }}}}}
		prtz[3][4][0].p.r = 7 .
	return cntd == 88

fn call_array_destructor() f64
	iorrt := 34.5
	n := 7
	prtz := [82][5][n]LL{ 0: { 0: { 0: LL{ a: 3, p: YY{ r: 7 }}}}, 80: { 3: { 6: LL{ p: YY{ r: 31 }}}}}
	prtz[1][1][1].p.r = -13
	return iorrt + prtz[3][4][0].p.r

fn test_array_destructor_2() bool
	call_array_destructor()
	return cntd == 63
