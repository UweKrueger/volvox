type XX {
	a i32
	b f64
}

global cntd := 10

type YY {
	r i32
	w XX
}

fn ~YY()
	cntd = cntd - this.r
	this.r = 79
	return

# fn YY()
# 	return

fn YY() bool
	return this.r == -13

fn hhwe() i32
   llk3e := YY{ r: 17 }
   return llk3e.r

fn test_local_shadow_of_global() bool
	hjggd := 34.125
	subb := 1.25
	hhwe := -3.5
	z := hjggd + subb - hhwe
	return z == 38.875

fn test_destructor_1() bool
	z := hhwe()
	return z == 17 && cntd == -7

fn hhwe2(n i32) i32
	if n<=0
		llk3e := YY{ r: n-8 }
		return llk3e.r
	return 5

fn test_destructor_2() bool
	z := hhwe2(-5)
	return cntd == 6 && z == -13

fn hhwe3(n i32) i32
	if n>7
		x := YY{ r: n, w: XX{ a: -71 }}
		n = n + x.w.a
	else
		n = n - 1 .
	return n

fn test_destructor_then_branch_1() bool
	k := hhwe3(8)
	return cntd == -2 && k == -63

fn hhwe4(n i32) i32
	w := n
	repeat
		x := YY{ r: n, w: XX{ a: 13 }}
		n = n - 1
		w = w + n
	until n <= 2
	x.r = -25
	return w

fn test_destructor_repeat_stack_restore_1() bool
	p := hhwe4(7)
	return cntd == 1 && p == 27

type LL {
	a i32
	p YY
}

fn test_auto_destructor_1() bool
	if cntd > 0
		p := LL{ a: 3, p: YY{ r: 5 }}
		p.p.r = p.p.r - 1 .
	return cntd == -3

cntd = 100

fn test_array_destructor_1() bool
	if cntd > 99
		iorrt := 34.5
		prtz := [2][cntd-95][2]LL{ 0: { 0: { 0: LL{ a: 3, p: YY{ r: 2 }}}}, 1: { 4: { 1: LL{ p: YY{ r: 3 }}}}}
		prtz[1][4][0].p.r = 7 .
	return cntd == 88

fn call_array_destructor() f64
	iorrt := 34.5
	prtz := [2][5][2]LL{ 0: { 0: { 0: LL{ a: 3, p: YY{ r: 7 }}}}, 1: { 3: { 1: LL{ p: YY{ r: 31 }}}}}
	prtz[1][1][1].p.r = -13
	return iorrt + prtz[1][4][0].p.r

fn test_array_destructor_2() bool
	call_array_destructor()
	return cntd == 63

