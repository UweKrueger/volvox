from time import sleep

struct AALL {
	r f64
	x f64
}

def AALL
	this.x += 5
end

# The destructor should be called 4 times (aa, bb for each thread)
def ~AALL
	_printf("Destructor called for AALL.x = %f\n", this.x)
end

# this should be initialized as aa.x=12 (RHS is constexpr)
global aa := AALL{ x: 7 }


# this should be initialized as bb.x=22 in main thread and as
# bb.x = 5 in other threads
global bb = AALL{ x: 17 }

def do_print(x f64, n i32) f64
	while n>0
		sleep 0.25
		_printf("x: %f, Round %d; aa.x: %f, bb.x: %f\n", x, n, aa.x, bb.x)
		sleep(0.07+x/5)
		n--
		aa.x = x + n
	end
	return x*x+100.001
end

w = thread do_print(3.34, 5)

# expect 108.8219
_printf("Result from main thread: %.4f\n", do_print(2.97, 4))

_printf("Waiting for w\n")

# expect 111.1566
_printf("Result from spawned thread: %.4f\n", w.wait)
