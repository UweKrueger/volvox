interface QQwMYx {
	oper(x f64) i32
	ttz(a f64, b i32) f64
	oper(p string) f64
}

struct HHnMYx {
	n i32
	p f64
	z f64
}

def HHnMYx.oper(x f64) i32
	return 2 * this.n + 3 * int(x)
end

def HHnMYx.oper(p string) f64
	return 20 * this.n
end

def HHnMYx.ttz(a f64, b i32) f64
	return a * this.n + b
end

struct P4MYx {
	m i32
}

def P4MYx.oper(x f64) i32
	return i32(17 + x)
end

def P4MYx.oper(p string) f64
	return 19.0625
end

def P4MYx.ttz(a f64, b i32) f64
	return a * a - this.m + b
end

def g(x QQwMYx, m f64) f64
	uwq = x.ttz(m, 4)
	echo x
	return 12.5 + uwq
end

def t_interface_1 bool
	r = HHnMYx{ n: 56, p: -33.5 }
	a = g(r, 34.25)
	return a == 1934.5
end

def t_interface_2 bool
	r = P4MYx{ m: 3 }
	a = g(r, 7.5)
	return a == 69.75
end

def ooo(i int, x QQwMYx) f64
	p = x.oper(i + 12.7)
	echo(i, x)
	return p * 2.5
end

def t_interface_3 bool
	yc = HHnMYx{ n: 10, p: -1.5 }
	dd = ooo(7, yc)
	return dd == 192.5
end

t_interface_1
t_interface_2
t_interface_3
