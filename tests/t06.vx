global qrret2 = 37

def do_q_1 bool
	qrret2 += 7
	return true
end

def do_q_2 bool
	qrret2 += 13
	return false
end

def test_bitwise_or_1 bool
	x = do_q_1 | do_q_2
	return x && qrret2 == 57
end

qrret2 = -5

def test_logical_or_1 bool
	x = do_q_1 || do_q_2
	return x && qrret2 == 2
end

qrret2 = 27

def test_bitwise_and_1 bool
	x = do_q_2 & do_q_1
	return !x && qrret2 == 47
end

qrret2 = 14

def test_logical_and_1 bool
	x = do_q_2 && do_q_1
	return !x && qrret2 == 27
end

def test_mod_assign_1 bool
	z = 12.5
	ff = z += 3
	z *= 2.5
	return ff == 12.5 && z == 38.75
end

def test_postfix_1 bool
	a = 13
	b = a++
	return a == 14 && b == 13
end

def test_postfix_2 bool
	a = -34.75
	b = a--
	return a == -35.75 && b == -34.75
end

def test_rotate bool
	a = 23
	b = -17
	c = 11
	a = b = c = a
	return a == -17 && b == 11 && c == 23
end

def test_f32_exponentiation_f32_exp_1 bool
	a = 1.25f
	b = a^2.5
	a = b
	return a > 1.746927 && a < 1.746929
end

def test_f32_exponentiation_int_exp_1 bool
	a = 1.0625f
	b = a^5
	a = b
	return a > 1.354080 && a < 1.354082
end

def test_f32_exponentiation_int_exp_2 bool
	a = -3.75f
	b = a^10uhh
	a = b
	return a > 549936.63 && a < 549936.72
end

def test_f32_exponentiation_int_exp_3 bool
	a = -2.25f
	b = a^7L
	a = b
	return a < -291.9292 && a > -291.9293
end

def test_f64_exponentiation_f64_exp_1 bool
	a = 17.375
	b = a^2.625
	a = b
	return a > 1798.0536037224490 && a < 1798.0536037224495
end

def test_f64_exponentiation_int_exp_1 bool
	a = 1.0625
	b = a^5
	a = b
	return a > 1.3540811538696285 && a < 1.3540811538696295
end

def test_f64_exponentiation_int_exp_2 bool
	a = -3.75
	b = a^6UHH
	a = b
	return a == 2780.914306640625
end

def test_f64_exponentiation_int_exp_3 bool
	a = -2.253674432345796
	b = a^7L
	a = b
	return a > -295.2828636106025 && a < -295.2828636106015
end

def test_f64_exponentiation_int_exp_4 bool
	a = -0.0625
	b = a^-7
	a = b
	return a == -268435456.
end

def test_int_int_exponentiation_1 bool
	a = 17
	b = 3
	c = a^b
	return c == 4913
end

def test_int_int_exponentiation_2 bool
	a = -17L
	b = 13hh
	c = a^b
	return c == -9904578032905937
end

def test_int_int_exponentiation_3 bool
	a = 7
	return a^0 == 1 && a^1 == 7 && a^2 == 49 && a^3 == 343 && a^4 == 2401
end

def test_int_int_exponentiation_4 bool
	a = -7532L
	return a^0 == 1 && a^1 == -7532 && a^2 == 56731024 &&
		a^3 == -427298072768L && a^4 == 3218409084088576L
end

def test_int_int_exponentiation_5 bool
	a = -5
	b = -7L
	c = 17
	d = 23
	return a^-1 == 0 && b^-1 == 0 && c^-1 == 0 && d^-1 ==0 && a^-2 == 0 &&
		b^-3 ==0 && c^-4 == 0 && d^-7 == 0
end

def test_int_int_exponentiation_6 bool
	a = -1
	b = -1L
	c = 1
	d = 1L
	return a^-1 == -1 && b^-1 == -1 && c^-1 == 1 && d^-1 == 1 && a^-2 == 1 &&
		b^-3 == -1 && a^-7 == -1 && b^-4 == 1 && c^-7 == 1 && d^-9 == 1
end

def test_int_frac_exponentiation_1 bool
	z = 3.125^(1+1/3)
	return z > 4.568777715957600 && z < 4.568777715957606
end

import testmod

def fqq(x i32) i32
	return x+x
end

def fqq(x u32) i32
	return 3 * x
end

def fqq(z testmod.KKljh) f64
	return z.d + z.e
end

def fqq(po [5][7]testmod.KKljh) f64
	return po[0][0].d + po[1][2].e
end

def fqq(x f64) f64
	return x*x
end

def test_overloaded_call_float bool
	pp = 7.5
	return fqq(pp) == 56.25 && fqq(-3.25) == 10.5625
end

def test_overloaded_call_int bool
	pp = 3
	return fqq(pp) == 6 && fqq(-7) == -14
end

def test_overloaded_call_array_1 bool
	pp7 = [5][7]testmod.KKljh{
		{testmod.KKljh{ d: 7, e: -12.25 }}
		{2: testmod.KKljh{ d: 17, e: -112.625 }}}
	return fqq(pp7)	 == -105.625
end

def test_nested_overloaded_call_1 bool
	return fqq(fqq(4.5)) == 410.0625
end

def test_nested_overloaded_call_2 bool
	return fqq(fqq(-7.)) == 2401
end

def test_nested_overloaded_call_3 bool
	return fqq(fqq(-7)) == -28
end

def test_nested_overloaded_call_4 bool
	return fqq(fqq(- 7u)) == -42
end

