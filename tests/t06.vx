global qqgga = 0

qqgga = kkff.j

def test_imported_constructor_2 bool
	return qqgga == 11
end

def test_imported_constructor_3 bool
	x = testmod.Olgj(-3.25)
	return x.s == -6.5
end

type QwER {
	h i32
	w i32
}

def QwER
	this.h += 3
	this.w = (this.w + 3) * 7
end

def ~QwER
end

global eewc := QwER{ w: 2 }

def test_constructor_for_global bool
	return eewc.h == 3 && eewc.w == 35
end

global eewc2 = QwER{ w: 2 }

def test_constructor_for_global_2 bool
	return eewc2.h == 3 && eewc2.w == 35
end

