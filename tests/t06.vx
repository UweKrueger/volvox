global f33h7 = 3

inline def gfR2 f64
	if 4 > 3
		return 34.25
	else
		return 2.5
end end

def nested_if_return_1(a int, b int) f64
	if a > b
		if a >= 5
			return 12.0625
		else
			return -7.5
		end
	else
		if b > 7
			return 9.125
		else
			return -2.75
end end end

def test_nested_if_1 bool
	return nested_if_return_1(7, 6) == 12.0625
end

def test_nested_if_2 bool
	return nested_if_return_1(3, 2) == -7.5
end

def test_nested_if_3 bool
	return nested_if_return_1(9, 12) == 9.125
end

def test_nested_if_4 bool
	return nested_if_return_1(1, 2) == -2.75
end

def nested_if_return_2(a int, b int) f64
	if a >= b
		if a < -2
			return 1.5625
		end
	else
		if b <=2
			return -89.375
		else
			return 0.75
	end end
	return 55.375
end

def test_nested_if_5 bool
	return nested_if_return_2(-4, -5) == 1.5625
end

def test_nested_if_6 bool
	return nested_if_return_2(8, 5) == 55.375
end

def test_nested_if_7 bool
	return nested_if_return_2(-6, -3) == -89.375
end

def test_nested_if_8 bool
	return nested_if_return_2(7, 9) == 0.75
end
