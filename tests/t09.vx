def test_ternary_1 bool
	o = true ? 7 : 9
	p = false ? 5.3 : -17
	return o == 7 && p == -17 && sizeof(p) == 8
end

def lkceg(r int, a f64, b f32) f64
	q = r > 7 ? r + b : a
	return q
end

def test_ternary_2 bool
	x = lkceg(8, 12.3, -6.2)
	return x > 1.7999 && x < 1.8001
end

def test_ternary_3 bool
	x = lkceg(7, 12.0625, 17.3f)
	return x == 12.0625
end

def test_min_max_abs_1 bool
	a = 13.75
	b = -17.25
	c = min(a, b)
	d = max(a, b)
	e = abs a
	f = abs b
	return c == -17.25 && d == 13.75 && e == 13.75 && f == 17.25
end

def test_min_max_abs_2 bool
	a = 1389
	b = -1725
	c = min(a, b)
	d = max(a, b)
	e = abs a
	f = abs b
	return c == -1725 && d == 1389 && e == 1389 && f == 1725
end

def test_min_max_abs_3 bool
	a = 1389U
	b = 1725U
	c = min(a, b)
	d = max(a, b)
	return c == 1389 && d == 1725
end

interface QQwMYx {
	oper(x f64) i32
	ttz(a f64, b i32) f64
	oper(p string) f64
}

struct HHnMYx {
	n i32
	p f64
	z f64
}

def HHnMYx.oper(x f64) i32
	return 2 * this.n + 3 * int(x)
end

def HHnMYx.oper(p string) f64
	return 20 * this.n
end

def HHnMYx.ttz(a f64, b i32) f64
	return a * this.n + b
end

struct P4MYx {
	m i32
}

def P4MYx.oper(x f64) i32
	return i32(17 + x)
end

def P4MYx.oper(p string) f64
	return 19.0625
end

def P4MYx.ttz(a f64, b i32) f64
	return a * a - this.m + b
end

def g(x QQwMYx, m f64) f64
	uwq = x.ttz(m, 4)
	return 12.5 + uwq
end

def test_interface_1 bool
	r = HHnMYx{ n: 56, p: -33.5 }
	a = g(r, 34.25)
	return a == 1934.5
end

def test_interface_2 bool
	r = P4MYx{ m: 3 }
	a = g(r, 7.5)
	return a == 69.75
end

def ooo(i int, x QQwMYx) f64
	p = x.oper(i + 12.7)
	return p * 2.5
end

def test_interface_3 bool
	yc = HHnMYx{ n: 10, p: -1.5 }
	dd = ooo(7, yc)
	return dd == 192.5
end

interface QQwOi {
	oper i32
	ppt=f64
	ttz(ap f64, xx i32) f64
}

struct HHnOi {
	n i32
	p f64
	z f64
}

def HHnOi.oper i32
	return 2 * this.n
end

def HHnOi.ttz(a f64, b i32) f64
	return a * this.p + b
end

def HHnOi.ppt f64
	return this.p + 1.25 + 0.125 * this.z
end

def HHnOi.ppt=(x f64) f64
	ret = this.p + this.z
	this.z = x - 0.5
	return ret
end

def gLgT(x QQwOi) bool
	p = x.ppt = 6.25
	q = x.ppt
	x.ppt = -3.5
	r = x.ppt
	#echo(p,q,r)
	#oooo = "$p $q $r"
	return p == 3.25 && q == 5.46875 && r == 4.25
end

def test_interface_4 bool
	r = HHnOi{ n: 13, p: 3.5, z: -0.25 }
	return gLgT(r)
end

struct HPnOi {
	u f64
	ppt f64
}

def HPnOi.oper i32
	return i32(2 * this.u)
end

def HPnOi.ttz(a f64, b i32) f64
	return this.ppt + 2.75
end

def g2LgT(x QQwOi) bool
	p = x.ppt = 6.25
	q = x.ppt
	x.ppt = -3.5
	r = x.ppt
	s = 7.3
	#oopp = "$s $p $q $r"
	#echo(p,q,r)
	return p == 13.25 && q == 6.25 && r == -3.5
end

def test_interface_5 bool
	r44 = HPnOi{ u: -7.0625, ppt: 13.25 }
	return g2LgT(r44)
end

def klghju(x real, b real) real
	while x>b
		b += 1.0625
	brk b >= 5
		b += 0.25
	end
	return b
end

def test_1level_break_1 bool
	return klghju(25, 11) == 12.062500
end

def test_1level_break_2 bool
	return klghju(25, 0.5) == 5.5
end

def ttqwl(a int, b int) int
	if a >= 5
		if a > b
			a += 5
		elif a > 9
			b += 3
	brk brk a > 10
			return b
		else
			return 0
		end
		b += 13
	end
	return -857 + b
end

def test_2level_break_1 bool
	return ttqwl(11, 23) == -831
end

def test_2level_break_2 bool
	return ttqwl(10, 17) == 20
end

global sum_factors = 0UL

def getdiv_repeat(a u64)
	b = a
	repeat
		d = 2UL
		repeat
			r = b % d
			if r == 0
				sum_factors += d
				b /= d
			else
				d++
			end
	brk brk b == 1
		until false
	until false
end

def test_2level_break_3 bool
	getdiv_repeat(124)
	return sum_factors == 35
end

sum_factors = 0UL

def getdiv_while(a u64) u64
	b = a
	c = 0UL
	while true
		d = 2UL
		while true
			r = b % d
			if r == 0
				sum_factors += d
				b /= d
			else
				d++
			end
	brk brk b == 1
			c++
		end
	end
	return c
end

def test_2level_break_4 bool
	p = getdiv_while(124)
	return sum_factors == 35 && p == 31
end

global wwqgh9 = 0

struct LLMJ {
	x int
}

def ~LLMJ
	wwqgh9 += 3 + 2*this.x
	# echo "Destuctor ${this.x}"
end

def nmntr(y int) int
	if y > 6
		if y > 10
			r = LLMJ{ x: 17 }
			# echo "created ${r.x}"
		brk y > 12
			q = LLMJ{ x: 23 }
			# echo "created ${q.x}"
		else
			r = LLMJ{ x: 19 }
			# echo "created ${r.x}"
	brk brk y < 8
			# echo "no brk"
			wwqgh9 += 100
			return 7
		end
		# echo "intermediate"
		wwqgh9 += 1000
	end
	# echo "Finish"
	wwqgh9 *= 2
	return 9
end

def test_multi_level_brk_destructors_1 bool
	t = nmntr 7
	return wwqgh9 == 82
end

wwqgh9 = 0

def test_multi_level_brk_destructors_2 bool
	t = nmntr 11
	return wwqgh9 == 2172 && t == 9
end

wwqgh9 = 0

def lwege(n int) LLMJ
	if n > 0
		Q = LLMJ{ x: 33 }
	else
		Q = LLMJ{ x: 47 }
	end
	return Q
end

def test_multi_level_brk_destructors_3 bool
	R = lwege(-6)
	res = wwqgh9 == 0
	return res
end

wwqgh9 = 0

def lwege2(n int) bool
	if n > 0
		Q = LLMJ{ x: 33 }
	else
		Q = LLMJ{ x: 47 }
	end
	res = wwqgh9 == 0
	return res
end

def test_multi_level_brk_destructors_4 bool
	R = lwege2(-6)
	return R
end

wwqgh9 = 0

def test_multi_level_brk_destructors_5 bool
	R = lwege2(7)
	return R
end

