global zpQjb6 = vec{ 4, 7.75, -2.25, 78.0625 }
global Pfgvvd2e = vec[int]{ 8, -98, 11, 17, 67 }

def test_global_vec_1 bool
	a = zpQjb6[3]
	b = Pfgvvd2e[1]
	return a == 78.0625 && b == -98
end

def test_global_vec_2 bool
	uP = zpQjb6[2] = 9.125
	return uP == -2.25 && zpQjb6[2] == 9.125
end

def test_global_vec_3 bool
	hQ = vec{ 9.25, 78.125, -7.0625, 89 }
	return hQ[0] + hQ[1] == 87.375
end

def test_vec_push_1 bool
	hQ = vec{ 9.25, 78.125, -7.0625, 89 }
	a = 99.5
	hQ.push a
	a = -78.25
	hQ.push a
	hQ.push(12.25)
	hQ.push(2.25)
	hQ.push(-15.75)
	hQ.push(6.0625)
	hQ.push(1.125)
	hQ.push(0.0625)
	hQ.push(11.5)
	return hQ.size == 13 && hQ.cap >= 13 && hQ[4] == 99.5 && hQ[12] == 11.5
end

def test_vec_insert_1 bool
	hQ = vec{ 9.25, 78.125, -7.0625, 89 }
	hQ.insert(2, 99.5)
	return hQ.size == 5 && hQ[2] == 99.5 && hQ[1] == 78.125 && hQ[3] == -7.0625
end

def test_vec_pop_1 bool
	hQ = vec{ 9.25, 78.125, -7.0625, 89 }
	hQ.pop
	return hQ.size == 3 && hQ[2] == -7.0625
end

def test_vec_remove_1 bool
	hQ = vec{ 9.25, 78.125, -7.0625, 89 }
	hQ.remove 1
	return hQ.size == 3 && hQ[0] == 9.25 && hQ[1] == -7.0625 && hQ[2] == 89
end

def test_vec_iter_up_1 bool
	gQ = vec{ 12.0625, -3.125, 5.25 }
	factor = 1
	sum = 0.
	for vLkM in gQ
		sum += factor * vLkM
		factor++
	end
	return sum == 21.5625
end

def test_vec_iter_up_2 bool
	gQ = vec{ "SdRt", "-3.125", "p_Qrt" }
	sum = " "
	for vLkM in gQ
		sum += vLkM + " "
	end
	return sum == " SdRt -3.125 p_Qrt "
end

def test_vec_iter_down_1 bool
	gQ = vec{ "SdRt", "-3.125", "p_Qrt" }
	sum = " "
	for vLkM ~in gQ
		sum += vLkM + " "
	end
	return sum == " p_Qrt -3.125 SdRt "
end

def test_ptr_bool_conv bool
	gw = __malloc 100000
	qu = voidptr(0)
	mmm = bool gw
	nnn = bool qu
	__free gw
	return bool(gw) && !bool(qu) && mmm && !nnn
end

def named_return_example(a f64, b f64) (dfg f64)
	dfg = a + 2 * b
end

def test_named_return_1 bool
	z = named_return_example(2.5, 3.75)
	return z == 10
end

struct ___big_dummy { # sz > sret_limit - used as return type to enforce sret
	d0 f64
	d1 f64
	d2 f64
	d3 f64
	d4 f64
}

def named_return_example2(a f64, b f64) (dfg ___big_dummy)
	if a > b
		dfg.d4 = a + 2 * b
		return
	end
	dfg.d4 = b - a
end

def test_named_return_2 bool
	y = named_return_example2(2.5, 3.75)
	z = named_return_example2(3.75, 2.5)
	return y.d4 == 1.25 && z.d4 == 8.75
end
