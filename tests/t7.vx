type RtzRi {
	x f64
	y int
	z f64
}

def ggg(a [4]u64) u64
	s = 0uL
	s += a[0]
	s += 3*a[2]
	return s
end

def ggg(b f64, a RtzRi) f64
	s = 0.
	s += a.x
	s *= a.y
	s += b + a.z
	return s
end

def ggg(a int) int
	return a*a
end

def test_anonynous_array_1 bool
	return ggg({2,5,7,13}) == 23
end

def test_anonynous_struct_1 bool
	return ggg(5, {y: 3, x: 23.75, z: 10}) == 86.25
end

def test_unsigned_from_untyped_1 bool
	b = 0x7fffffff
	return u64(b) < 0xfffffffffffffffe
end

pub const SEMVMX1 := 0xfffffffffffffffd
const ppeer := false
pub const SEMVMX2 := if ppeer
		17
	else
		SEMVMX1 + 1
	end

def test_unsigned_from_untyped_2 bool
	b = 511
	return !(b < 0 || u64(b) > SEMVMX2)
end

import limits

pub const SEMVMX := if os.isWindows
		u64(limits.i32_max)
	elif os.isLinux || os.isFreeBSD || os.isNetBSD
		u64(limits.u64_max - 1)
	else
		u64(512)
	end

def test_unsigned_from_untyped_3 bool
	b = 511
	return !(b < 0 || u64(b) > SEMVMX)
end

