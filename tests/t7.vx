const b5532 := 0x57fffffe

global a3297t5 = b5532

def test_int_from_untyped_1 bool
	return a3297t5 == 0x57fffffe
end

def for_loop_1 int
	k = 2
	for n in 5
		k += (n + 1)
	end
	return k
end

def test_int_for_1 bool
	return for_loop_1 == 17
end

def for_loop_2(mx int) int
	z := 10
	for n in mx
		z += (n+1)
	else
		n = -19
	end
	return z + 100 * n
end

def test_int_for_2 bool
	res = for_loop_2(3)
	return res == 216
end

def test_int_for_3 bool
	res = for_loop_2(-5)
	return res == -1890
end

