import arch.os
import arch.cpu

fn test_built_in_consts bool
	x := __OS_Idx
	return x > 0 && __CPU_Idx > 0

fn test_exactly_one_os_is_defined bool
	n := 0
	if os.isFreeBSD
		n++ .
	if os.isNetBSD
		n++ .
	if os.isOpenBSD
		n++ .
	if os.isWindows
		n++ .
	if os.isLinux
		n++ .
	if os.isHaiku
		n++ .
	if os.isMacOSX
		n++ .
	return n == 1

fn test_exactly_one_cpu_is_defined bool
	m := 0
	if cpu.isARM
		m++ .
	if cpu.isAArch64
		m++ .
	if cpu.isAVR
		m++ .
	if cpu.isX86
		m++ .
	if cpu.isX86_64
		m++ .
	return m == 1

fn p7_1 string
	return "Hallo"

fn q7_1 int
	return 7

global x7_1 := 2

fn test_incompatible_branches_1 bool
	if x7_1 > 3
		p7_1
	else
		q7_1 .
	return true

fn test_incompatible_branches_2 bool
	if x7_1 > 1
		p7_1
	else
		q7_1 .
	return true

fn test_incompatible_branches_3 bool
	if 2 > 3
		p7_1
	else
		q7_1 .
	return true

fn test_incompatible_branches_4 bool
	if 2 > 1
		p7_1
	else
		q7_1 .
	return true

fn test_array_value_attrib_1 bool
	a := [[4,5,6],[2,3,6]].order
	return a == 2

fn test_array_value_attrib_2 bool
	a := [[4,5,6],[2,3,6]].size
	return a == 6

fn test_array_value_attrib_3 bool
	a := [3][4]f64{}.size
	return a == 12

fn test_array_value_attrib_4 bool
	a := [3][4]f64{}.order
	return a == 2

fn test_array_value_attrib_5 bool
	f := 7
	a := [3][f][4]f64{}.order
	return a == 3

fn test_array_value_attrib_6 bool
	f := 13
	g := 5
	a := [f][7][g]f64{}.size
	return a == 455

fn test_array_dim_1 bool
	return [3][7][5]f64{}.dim(1) == 7

fn test_array_dim_2 bool
	f := 13
	return [3][f][5]f64{}.dim(1) == 13

fn test_array_dim_3 bool
	f := 13
	n := 1
	return [3][f][5]f64{}.dim(n) == 13

global ffddff ::= [3][13][5]f64{}

fn test_array_dim_4 bool
	n := 1
	return ffddff.dim(n) == 13

asd99 := 17

ffkld3 := [3][asd99][5]f64{}

global eqwef3 := ffkld3.dim(1) + 4

fn test_array_dim_5 bool
	return eqwef3 == 21

fn test_string_size_1 bool
	return "hjdrt56".size == 8

fn test_string_len_1 bool
	return "hjdrt56".len == 7

fn test_string_len_2 bool
	a := "vbhgf"
	return a.len == 5

fn test_string_len_3 bool
	a := "vbhgf" + "c543"
	return a.len == 9

fn test_string_len_4 bool
	return ("fgjhhgf" + "12").len == 9

type RtzRi {
	x f64
	y int
	z f64
}

fn ggg(a [4]u64) u64
	s := 0u64
	s += a[0]
	s += 3*a[2]
	return s

fn ggg(b f64, a RtzRi) f64
	s := 0.
	s += a.x
	s *= a.y
	s += b + a.z
	return s

fn ggg(a int) int
	return a*a

fn test_anonynous_array_1 bool
	return ggg({2,5,7,13}) == 23

fn test_anonynous_struct_1 bool
	return ggg(5, {y: 3, x: 23.75, z: 10}) == 86.25

fn test_unsigned_from_untyped_1 bool
	b := 0x7fffffff
	return u64(b) < 0xfffffffffffffffe

pub const SEMVMX1 ::= 0xfffffffffffffffd
const ppeer ::= false
pub const SEMVMX2 ::= if ppeer
		17
	else
		SEMVMX1 + 1 .

fn test_unsigned_from_untyped_2 bool
	b := 511
	return !(b < 0 || u64(b) > SEMVMX2)

import limits

pub const SEMVMX ::= if os.isWindows
		u64(limits.max_i32)
	elif os.isLinux || os.isFreeBSD || os.isNetBSD
		limits.max_u64 - 1
	else
		u64(512) .

fn test_unsigned_from_untyped_3 bool
	b := 511
	return !(b < 0 || u64(b) > SEMVMX)

#const b5532 ::= 0xfffffaff57fffffe
const b5532 ::= 0x57fffffe

global a3297t5 := b5532

fn test_int_from_untyped_1 bool
	return a3297t5 == 0x57fffffe
