type Qhddf {
	s int
}

def Qhddf.min int
	return this.s / 2
end

def Qhddf.max int
	return this.s + this.s
end

def test_int_for_9 bool
	res = 0
	q = Qhddf{ s: 6 }
	for t in q
		res += t
	else
		t = -17
	end
	return res == 75 && t == 12
end

# for iteration with float ranges should run up to approximately the max value
# so we test this with two versions...

def test_int_for_10 bool
	res = 0.
	for q in 2.25..7.24
		res += q
	else
		q = -17.3
	end
	return res == 28.5 && q == 7.25
end

def test_int_for_11 bool
	res = 0.
	for q in 2.25..7.26
		res += q
	else
		q = -17.3
	end
	return res == 28.5 && q == 7.25
end

