import arch.os
import arch.cpu

def test_built_in_consts bool
	x = __OS_Idx
	return x > 0 && __CPU_Idx > 0
end

def test_exactly_one_os_is_defined bool
	n = 0
	if os.isFreeBSD
		n++
	end
	if os.isNetBSD
		n++
	end
	if os.isOpenBSD
		n++
	end
	if os.isWindows
		n++
	end
	if os.isLinux
		n++
	end
	if os.isHaiku
		n++
	end
	if os.isMacOSX
		n++
	end
	return n == 1
end

def test_exactly_one_cpu_is_defined bool
	m = 0
	if cpu.isARM
		m++
	end
	if cpu.isAArch64
		m++
	end
	if cpu.isAVR
		m++
	end
	if cpu.isX86
		m++
	end
	if cpu.isX86_64
		m++
	end
	if cpu.isPPC
		m++
	end
	if cpu.isRISCV32
		m++
	end
	if cpu.isRISCV64
		m++
	end
	if cpu.isSystemZ
		m++
	end
	return m == 1
end

