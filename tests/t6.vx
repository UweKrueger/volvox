global qrret2 := 37

fn do_q_1() bool
	qrret2 += 7
	return true

fn do_q_2() bool
	qrret2 += 13
	return false

fn test_bitwise_or_1() bool
	x := do_q_1() | do_q_2()
	return x && qrret2 == 57

qrret2 = -5

fn test_logical_or_1() bool
	x := do_q_1() || do_q_2()
	return x && qrret2 == 2

qrret2 = 27

fn test_bitwise_and_1() bool
	x := do_q_2() & do_q_1()
	return !x && qrret2 == 47

qrret2 = 14

fn test_logical_and_1() bool
	x := do_q_2() && do_q_1()
	return !x && qrret2 == 27

fn test_mod_assign_1() bool
	z := 12.5
	ff := z += 3
	z *= 2.5
	return ff == 12.5 && z == 38.75

fn test_postfix_1() bool
	a := 13
	b := a++
	return a == 14 && b == 13

fn test_postfix_2() bool
	a := -34.75
	b := a--
	return a == -35.75 && b == -34.75

fn test_rotate() bool
	a := 23
	b := -17
	c := 11
	a = b = c = a
	return a == -17 && b == 11 && c == 23

fn test_f32_exponentiation_f32_exp_1() bool
	a := 1.25f32
	b := a^2.5
	a = b
	return a > 1.746927 && a < 1.746929

fn test_f32_exponentiation_int_exp_1() bool
	a := 1.0625f32
	b := a^5
	a = b
	return a > 1.354080 && a < 1.354082

fn test_f32_exponentiation_int_exp_2() bool
	a := -3.75f32
	b := a^10u8
	a = b
	return a > 549936.63 && a < 549936.72

fn test_f32_exponentiation_int_exp_3() bool
	a := -2.25f32
	b := a^7i64
	a = b
	return a < -291.9292 && a > -291.9293

fn test_f64_exponentiation_f64_exp_1() bool
	a := 17.375
	b := a^2.625
	a = b
	return a > 1798.0536037224490 && a < 1798.0536037224495

fn test_f64_exponentiation_int_exp_1() bool
	a := 1.0625
	b := a^5
	a = b
	return a > 1.3540811538696285 && a < 1.3540811538696295

fn test_f64_exponentiation_int_exp_2() bool
	a := -3.75
	b := a^6u8
	a = b
	return a == 2780.914306640625

fn test_f64_exponentiation_int_exp_3() bool
	a := -2.253674432345796
	b := a^7i64
	a = b
	return a > -295.2828636106025 && a < -295.2828636106015

