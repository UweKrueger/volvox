	c := 1
	d := 1i64
	return a^-1 == -1 && b^-1 == -1 && c^-1 == 1 && d^-1 == 1 && a^-2 == 1 && b^-3 == -1 && a^-7 == -1 && b^-4 == 1 && c^-7 == 1 && d^-9 == 1

fn test_int_frac_exponentiation_1() bool
	z := 3.125^(1+1/3)
	return z > 4.568777715957600 && z < 4.568777715957606

import tests.testmod

fn fqq(x i32) i32
    return x+x

fn fqq(x u32) i32
    return 3 * x

fn fqq(z testmod.KKljh) f64
	return z.d + z.e

fn fqq(po [5][7]testmod.KKljh) f64
	return po[0][0].d + po[1][2].e

fn fqq(x f64) f64
    return x*x

fn test_overloaded_call_float() bool
	pp := 7.5
	return fqq(pp) == 56.25 && fqq(-3.25) == 10.5625

fn test_overloaded_call_int() bool
	pp := 3
	return fqq(pp) == 6 && fqq(-7) == -14

fn test_overloaded_call_array_1() bool
	pp7 := [5][7]testmod.KKljh{
		{testmod.KKljh{ d: 7, e: -12.25 }}
		{2: testmod.KKljh{ d: 17, e: -112.625 }}}
	return fqq(pp7)  == -105.625

fn test_nested_overloaded_call_1() bool
	return fqq(fqq(4.5)) == 410.0625

fn test_nested_overloaded_call_2() bool
	return fqq(fqq(-7.)) == 2401

fn test_nested_overloaded_call_3() bool
	return fqq(fqq(-7)) == -28

fn test_nested_overloaded_call_4() bool
	return fqq(fqq(-7u32)) == -42

alp := testmod.Olgj(7.0625)

global qqggf := 0.

qqggf = alp.s

fn test_imported_constructor_1() bool
	return qqggf == 14.125

kkff := testmod.Olgj(4)

global qqgga := 0

qqgga = kkff.j

fn test_imported_constructor_2() bool
	return qqgga == 11

fn test_imported_constructor_3() bool
	x := testmod.Olgj(-3.25)
	return x.s == -6.5

type QwER {
	h i32
	w i32
}

fn QwER()
	this.h += 3
	this.w = (this.w + 3) * 7
	return

fn ~QwER()
	return

global eewc := QwER{ w: 2 }

fn test_constructor_for_global() bool
	return eewc.h == 3 && eewc.w == 35

global wef53 := YYt{ rz: 1, w: XXt{ a: 9, b: 66.5 }}

fn big_struct_arg_3(lk YYt) f64
	lk.w.b = 33.75
	llqr := big_struct_arg(lk)
	return llqr

lkt := YYt{ rz: 1, w: XXt{ a: 9, b: 66.5 }}

big_struct_arg_3(lkt)

lkt

type GFds {
	n i32
	m i32
}

type OOWq union {
	x i32
	y f64
	z [18]u8
	q GFds
	t i64
}

fn test_union_1() bool
	lk := OOWq{ y: -55435476.0625 }
	return lk.x == -1602224128 && lk.y == -55435476.0625 && lk.z[5] == 111

fn test_union_2() bool
	return OOWq{ y: 45.125 }.t == 4631547596471533568

fn test_union_3() bool
	fww := OOWq{ t: 23136026754243021 }
	return fww.q.n == 3365325 && fww.q.m == 5386776

fn test_union_4() bool
	fww := OOWq{ q: GFds{ n: 3365325, m: 5386776 }}
	return fww.t == 23136026754243021

