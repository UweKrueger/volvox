	a = b
	return a == -268435456.

fn test_int_int_exponentiation_1() bool
	a := 17
	b := 3
	c := a^b
	return c == 4913

fn test_int_int_exponentiation_2() bool
	a := -17i64
	b := 13i8
	c := a^b
	return c == -9904578032905937

fn test_int_int_exponentiation_3() bool
	a := 7
	return a^0 == 1 && a^1 == 7 && a^2 == 49 && a^3 == 343 && a^4 == 2401

fn test_int_int_exponentiation_4() bool
	a := -7532i64
	return a^0 == 1 && a^1 == -7532 && a^2 == 56731024 && a^3 == -427298072768i64 && a^4 == 3218409084088576i64

