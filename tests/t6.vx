	a := -3.75f32
	b := a^10u8
	a = b
	return a > 549936.63 && a < 549936.72

fn test_f32_exponentiation_int_exp_3() bool
	a := -2.25f32
	b := a^7i64
	a = b
	return a < -291.9292 && a > -291.9293

fn test_f64_exponentiation_f64_exp_1() bool
	a := 17.375
	b := a^2.625
	a = b
	return a > 1798.0536037224490 && a < 1798.0536037224495

fn test_f64_exponentiation_int_exp_1() bool
	a := 1.0625
	b := a^5
	a = b
	return a > 1.3540811538696285 && a < 1.3540811538696295

fn test_f64_exponentiation_int_exp_2() bool
	a := -3.75
	b := a^6u8
	a = b
	return a == 2780.914306640625

fn test_f64_exponentiation_int_exp_3() bool
	a := -2.253674432345796
	b := a^7i64
	a = b
	return a > -295.2828636106025 && a < -295.2828636106015

fn test_f64_exponentiation_int_exp_4() bool
	a := -0.0625
