d := [1, -7, 3, 4]

fn test_simple_fixed_array_lit() bool
	return d[0] == 1 & d[1] == -7 & d[2] == 3 & d[3] == 4

c := [7, 2: -2, 5: 19]

c

fn test_array_lit_with_keys_and_holes() bool
	return c[0] == 7 & c[1] == 0 & c[2] == -2 & c[3] == 0 &
		c[4] == 0 & c[5] == 19

b := [1 + 2, 4 * 5, 1 + 2: 9 + 10, 2 * 2 + 1: 7 + 8]

fn test_array_lit_with_expr_keys_and_values() bool
	return b[0] == 3 & b[1] == 20 & b[2] == 0 & b[3] == 19 &
		b[4] == 0 & b[5] == 15

b

fn fc(w i32, x i32, y i32, z i32) i32
	return w + x + y + z

fn test_fn_call_with_exprs() bool
	return fc(1 + 2, 4 * 5, 7 + 8, 9 + 10) == 57

fn test_array_elem_type_1() bool
	ar1 := [-2, 9, 67, 7: 5.25]
	ar1[2] = ar1[2] + 0.75
	ar1[7] = ar1[7] + 0.125
	return ar1[2] == 67.75 & ar1[7] == 5.375

fn test_explicit_array_type() bool
	ar2 := [12]f64{2, 5, 7}
	ar2[1] = ar2[2] / ar2[0]
	return ar2[1] == 3.5

fn test_explicit_array_len() bool
	ar3 := [1.25, 2.75, len: 200]
	return ar3[0] == 1.25 & ar3[1] == 2.75 & ar3[2] == 0. & ar3[101] == 0 & ar3[199] == 0.

yy := 17
je := 5

fn test_array_lit_var_len_var_idx() bool
	return [yy]f64{1.2, 3.5, 5: 17.625, 3.1}[je] == 17.625

fn test_array_lit_var_len_fixed_idx() bool
	return [yy]f64{1.2, 3.5, 5: 17.625, 3.125}[6] == 3.125

fn test_array_lit_zero_initialization() bool
	return [yy]f64{1.2, 3.5, 5: 17.625, 3.125}[12] == 0.0

fn test_array_lit_fixed_len_fixed_idx() bool
	return [7]f64{1.2, -3.5, 5: 17.625, 3.1}[1] == -3.5

fn test_array_lit_fixed_len_var_idx() bool
	return [9]f64{1.2, 3.5, 5: -27.0625, 3.1}[je] == -27.0625

yn := 4
zn := 5
wn := 3

fn test_var_array_multi_level_index_direct() bool
	vv := [yn][zn][wn]f64{2: {1: {2: -17.125}}}
	x := vv[2][1][2]
	return x == -17.125

fn test_var_array_multi_level_index_indirect1() bool
	vv := [4][5][3]f64{2: {1: {2: 41.25}}}
	x := vv[2][1]
	return x[2] == 41.25

fn test_var_array_multi_level_cp() bool
	vv := [zn][wn]f64{1: {2: -17.125}}
	x := vv
	return x[1][2] == -17.125

fn test_var_array_multi_level_index_indirect() bool
	vv := [yn][zn][wn]f64{2: {1: {2: -17.125}}}
	x := vv[2][1]
	return x[2] == -17.125
