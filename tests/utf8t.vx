union utf8_sequence {
	byte [8]u8 # we would only need 4 for UTF-8 but at least 5 to add '\0' as terminator
	err u64
}

def pr_seq(t u32)
	s = utf8_sequence{ err: t }
	_printf("%02x %02x %02x %02x >%.4s<\n", s.byte[0], s.byte[1], s.byte[2], s.byte[3], &s)
end

cdecl utf8_encode(cp u32) u32

o0 = 'Q'
o = utf8_encode(o0)

pr_seq(o)

oo0 = 'ä'
oo = utf8_encode(oo0)

pr_seq(oo)

ooo0 = '€'
ooo = utf8_encode(ooo0)

pr_seq(ooo)

oop0 = '𝄞'
oop = utf8_encode(oop0)

pr_seq(oop)
