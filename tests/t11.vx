def test_struct_map_1 bool
	a = __map
	a.__insert_64("Kbtr", 436542354367UL)
	a.__insert_64("llsas", 12UL)
	x = a.__get_64("Kbtr")
	y = a.__get_64("llsas")
	z = a.__get_64("Kscv")
	return x == 436542354367UL && y == 12 && z == 0
end

def test_struct_map_2 bool
	a = __map
	a.__insert_float("Kbtr", -23.0625f)
	a.__insert_float("llsas", 672.25f)
	x = a.__get_float("Kbtr")
	y = a.__get_float("llsas")
	z = a.__get_float("Kscv")
	return x == -23.0625f && y == 672.25f && z == 0
end
