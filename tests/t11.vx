global n_KlamP_constructor = 0
global n_KlamP_destructor = 0

struct KlamP {
    a f64
    b int
}

def KlamP
    this.b++
	n_KlamP_constructor += this.b
	# echo "KlamP constructor called ${this.a} ${this.b}"
end

def ~KlamP
	n_KlamP_destructor += this.b
    # echo "KlamP destructor called ${this.a} ${this.b}"
end

# modify by-val function argument, i.e. take ownership and call destructor
def own_KlamP(x KlamP) int
	y = KlamP{ a: 12.3, b: 7 }
	r = y.b
	x.b += 5
	# echo("own_KlamP() called", r, x.b)
	return r
end

def test_copy_constructor_1 bool
	x = KlamP
	r = own_KlamP(x)
	# echo (r, n_KlamP_constructor, n_KlamP_destructor)
	return r == 8 && n_KlamP_constructor == 9 && n_KlamP_destructor == 14
end

n_KlamP_constructor = 0
n_KlamP_destructor = 0

global x_KlamP1 = KlamP
global r_KlamP1 = own_KlamP(x_KlamP1)

def test_copy_constructor_2 bool
	return r_KlamP1 == 8 && n_KlamP_constructor == 11 && n_KlamP_destructor == 15
end

n_KlamP_constructor = 0
n_KlamP_destructor = 0

# read by-val function argument -> caller keeps ownership 
def borrow_KlamP(x KlamP) int
	y = KlamP{ a: 12.3, b: x.b+7 }
	r = y.b
	# echo("borrow_KlamP called", r, x.b)
	return r
end

global x_KlamP2 = KlamP
global r_KlamP2 = borrow_KlamP(x_KlamP2)

def test_copy_constructor_3 bool
	return r_KlamP2 == 9
end

n_KlamP_constructor = 0
n_KlamP_destructor = 0

def test_copy_constructor_4 bool
	x = KlamP{ a: 1.5, b: 0 }
	r = borrow_KlamP(x)
	return r == 9 && n_KlamP_constructor == 10 && n_KlamP_destructor == 9
end

# use x after passing ownership -> make a valid copy
def k_copy_KlamP_own(x KlamP) int
	# echo("k called1", x.b)
	x.b = 55
	r = own_KlamP x
	x.b += 23
	# echo("k called", r, x.b)
	return r
end

n_KlamP_constructor = 0
n_KlamP_destructor = 0

def test_copy_constructor_5 bool
	x = KlamP
	r = k_copy_KlamP_own x
	# echo (r, n_KlamP_constructor, n_KlamP_destructor)
	return r == 8 && n_KlamP_constructor == 65 && n_KlamP_destructor == 147
end

# don't use after passing ownership -> move, i.e invalidate own object
def k_move_KlamP_borrow(x KlamP) int
	# echo("k called2", x.b)
	x.b = 55
	r = borrow_KlamP x
	# echo("k called3", r)
	return r
end

n_KlamP_constructor = 0
n_KlamP_destructor = 0

def test_copy_constructor_6 bool
	x = KlamP
	r = k_move_KlamP_borrow x
	return r == 63 && n_KlamP_constructor == 64 && n_KlamP_destructor == 118
end

# use x after borrowing -> modify and call destructor ourself
def k_move_KlamP_borrow2(x KlamP) int
	# echo("k called4", x.b)
	x.b = 55
	r = borrow_KlamP x
	x.b++
	# echo("k called5", r)
	return r
end

n_KlamP_constructor = 0
n_KlamP_destructor = 0

def test_copy_constructor_7 bool
	x = KlamP
	r = k_move_KlamP_borrow2 x
	return r == 63 && n_KlamP_constructor == 64 && n_KlamP_destructor == 119
end
# don't use x after passing ownership -> move
def k_copy_KlamP_own2(x KlamP) int
	# echo("k called6", x.b)
	x.b = 55
	r = own_KlamP x
	# echo("k called7", r)
	return r
end

n_KlamP_constructor = 0
n_KlamP_destructor = 0

def test_copy_constructor_8 bool
	x = KlamP
	r = k_copy_KlamP_own2 x
	return r == 8 && n_KlamP_constructor == 9 && n_KlamP_destructor == 68
end

n_KlamP_constructor = 0
n_KlamP_destructor = 0

struct KlaQ {
	x KlamP
	y f64
}

def test_copy_to_struct_1 bool
	a = KlamP { b: 5 }
	v1 = n_KlamP_constructor
	b = KlaQ { x: a, y: -7.25 }
	c = a.a
	# echo("constructor calls:", v1, n_KlamP_constructor, a.b, b.x.b)
	return v1 == 6 && n_KlamP_constructor == 13
end

n_KlamP_constructor = 0
n_KlamP_destructor = 0

def test_move_to_struct_1 bool
	a = KlamP { b: 5 }
	v1 = n_KlamP_constructor
	b = KlaQ { x: a, y: -7.25 }
	# echo(v1, n_KlamP_constructor)
	return v1 == 6 && n_KlamP_constructor == 6
end

struct KlamP2 {
    a f64
    b int
}

def KlamP2
	this.a += 0.125
	n_KlamP_constructor++
	# echo "KlamP2 constructor called ${this.a} ${this.b}"
end

def ~KlamP2
	if this.a != 0 || this.b != 0
		n_KlamP_destructor++
		# echo "KlamP2 destructor called ${this.a} ${this.b}"
end end

struct KlamQ {
	x KlamP2
	y f64
}

def KlamQ+(b KlamQ) KlamQ
	r = KlamQ{ x: KlamP2{ a: this.x.a + b.x.a, b: 34 }, y: this.y * b.y }
	return r
end

n_KlamP_constructor = 0
n_KlamP_destructor = 0

def do_KlamQ_calculations f64
	w = KlamQ{ x: KlamP2{ a: 3.5, b: 15 }, y: -5.0625 }
	q = KlamQ{ x: KlamP2{ a: -1.5, b: 13 }, y: 2.25 }
	r = KlamQ{ x: KlamP2{ a: 1.75, b: -9 }, y: -1.5 }
	vfh = r + (w + q)
	return vfh.x.a
end

def test_substruct_constructors_destructors_1 bool
	x = do_KlamQ_calculations
	return x == 4.375 && n_KlamP_constructor == 5 && n_KlamP_destructor == 5
end

global n_KlamQ_constructor = 0
global n_KlamQ_destructor = 0

struct KlamQ2 {
	x KlamP2
	y f64
}

def KlamQ2
	n_KlamQ_constructor++
	# echo "KlamQ2 constructor called ${this.x.a} ${this.x.b} ${this.y}"
end

def ~KlamQ2
	n_KlamQ_destructor++
	# echo "KlamQ2 destructor called ${this.x.a} ${this.x.b} ${this.y}"
end

def KlamQ2+(b KlamQ2) KlamQ2
	r = KlamQ2{ x: KlamP2{ a: this.x.a + b.x.a, b: 34 }, y: this.y * b.y }
	return r
end

def do_KlamQ2_calculations f64
	w = KlamQ2{ x: KlamP2{ a: 3.5, b: 15 }, y: -5.0625 }
	q = KlamQ2{ x: KlamP2{ a: -1.5, b: 13 }, y: 2.25 }
	r = KlamQ2{ x: KlamP2{ a: 1.75, b: -9 }, y: -1.5 }
	vfg = r + (w + q)
	# echo vfg
	return vfg.x.a
end

n_KlamP_constructor = 0
n_KlamP_destructor = 0

def test_substruct_constructors_destructors_2 bool
	x = do_KlamQ2_calculations
	return x == 4.375 && n_KlamQ_constructor == 5 && n_KlamQ_destructor == 5 && n_KlamP_constructor == 5 && n_KlamP_destructor == 5
end

