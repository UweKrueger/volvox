def get_substruct_constructors_destructors_1 f64
	r = KlamQ2{ x: KlamP2{ a: 1.75, b: -9 }, y: -1.5 }
	n_KlamP_constructor = 0
	n_KlamP_destructor = 0
	n_KlamQ_constructor = 0
	n_KlamQ_destructor = 0
	q = r.x
	return q.a
end

def test_get_substruct_constructors_destructors_1 bool
	w = get_substruct_constructors_destructors_1
	return w == 2. && n_KlamP_constructor == 1 && n_KlamQ_constructor == 0 && n_KlamP_destructor == 2 && n_KlamQ_destructor == 1
end

def get_field_elem_owned(k KlamP2) f64
	u = k.a
	k.b = 1
	return u
end

def get_substruct_constructors_destructors_2 f64
	r = KlamQ2{ x: KlamP2{ a: 1.75, b: -9 }, y: -1.5 }
	n_KlamP_constructor = 0
	n_KlamP_destructor = 0
	n_KlamQ_constructor = 0
	n_KlamQ_destructor = 0
	q = get_field_elem_owned r.x
	r.x.a += 0.5
	return q
end

