global yn210 = 15
global wn2 = 7

def test_var_array_multi_level_ref bool
	vv = [yn210][13][wn2]f64{1: {12: {0: 78.25}}, 2: {5: {2: -17.125}}}
	# vv = [yn210][13][wn2]f64{2: {5: {2: -17.125}}, 1: {12: {0: 78.25}}}
	&pph = vv
	x = pph[2][5][2]
	y = pph[1][12][0]
	return x == -17.125 && y == 78.25 && pph.dim(1) == 13 && pph.dim(2) == 7
end

def test_for_over_float_array_lit bool
	s = 0.
	for x in [1.25, 3.5, -7.125, 13.75]
		s += x
	end
	return s == 11.375
end

def test_for_over_int_array_lit bool
	s = 0
	for x in [1, 3, -7, 13]
		s += x
	end
	return s == 10
end

global uugf94 = 7

def test_ref_for_over_f64_array bool
	s = 0.
	a = [uugf94]f64{ 1, 7, 9.5, 6: 45.75 }
	for &t in a
		s += t
		t += s
		# _printf("%f\n", t)
	end
	return s == 63.25 && a[2] == 27
end

def test_val_for_over_f64_array bool
	s = 0.
	a = [uugf94]f64{ 1, 7, 9.5, 6: 45.75 }
	for t in a
		s += t
		t += s
		# _printf("%f\n", t)
	end
	return s == 63.25 && a[2] == 9.5
end

def test_existing_val_for_over_f64_array bool
	s = 0.
	t = 3.2
	a = [uugf94]f64{ 1, 7, 9.5, 6: 45.75 }
	for t ~in a
		s += t
		# _printf("%f\n", t)
		t += s
	end
	return s == 63.25 && a[2] == 9.5
end

global sjj2 = 0.
bjj2 = 27.3
ajj2 = [4, 8, 9, 2.5, 4.25]

for bjj2 in ajj2
	sjj2 += bjj2
	# _printf("%g\n", bjj2)
end

def test_global_scope_for_1 bool
	return sjj2 == 27.75
end

sjj2 = 0.

for cjj3, bjj2 in ajj2
	sjj2 += (cjj3+1) * bjj2
	# _printf("%g\n", sjj2)
end

def test_global_scope_for_2 bool
	return sjj2 == 78.25
end

cjj3a = 263
sjj2a = 0

for cjj3a in 5 .. 8
	sjj2a += cjj3a
	# _printf("%d\n", sjj2a)
end

global sjj2ag = sjj2a
global cjj3ag = cjj3a

def test_global_scope_for_3 bool
	return sjj2ag == 26 && cjj3ag == 8
end

def test_map_iteration_1 bool
	hjhg7 = map[string]f64{ "ggs": 12, "ABd": -1.0625, "doDe": 2.25 }
	s = 0.
	for i ~in hjhg7
		# _printf("Value: >%g<\n", i)
		s += i
	end
	return s == 13.1875
end

def test_map_iteration_1a bool
	hjhg7 = map[string]f64{}
	s = 0.
	for i ~in hjhg7
		s += i
		_printf("Value: >%g<\n", i)
	end
	return s == 0
end

global ffsd93 = 0
hjhg9 = map[string]int{ "ggs": 12, "ABd": -123, "doDe": 2, "kkqw": 1000 }

for zew78 in hjhg9
	ffsd93 += zew78
	# _printf("Value: >%d<\n", zwe78)
end

def test_map_iteration_2 bool
	return ffsd93 == 891
end

def test_map_iteration_3 bool
	hjhg7 = map[string]f64{ "ggs": 12, "ABd": -1.0625, "doDe": 2.25 }
	s = 0.
	for i in hjhg7
		s += i
		# _printf("Value: >%g<\n", i)
	else
		i = 0.
	end
	# i should be the greatest value
	return s == 13.1875 && i == 12
end

def test_map_iteration_4 bool
	hjhg7 = map[string]f64{ "ggs": 12, "ABd": -1.0625, "doDe": 2.25 }
	s = 0.
	for i ~in hjhg7
		s += i
		# _printf("Value: >%g<\n", i)
	else
		i = 0.
	end
	# i should be the least value
	return s == 13.1875 && i == -1.0625
end

def test_map_string_string_1 bool
	hjhg17 = map[string]string{ "ggs": "abc", "ABd": "3.456", "doDe": "gheew" }
	x = hjhg17["ABd"]
	y = hjhg17["ggs"]
	z = hjhg17["Bmssde"]
	return x == "3.456" && y == "abc" && z == ""
end

global hjhg18 = map[string]string{ "ggq": "abc", "Abd": "3.456", "doDe": "gheew" }

def test_map_string_string_2 bool
	hjhg18["ABdt"] = "m.jdfd"
	return hjhg18["doDe"] == "gheew" && hjhg18["ABdt"] == "m.jdfd"
end

def test_map_string_string_3 bool
	keys = " "
	values = " "
	dummy = hjhg18["Bdt_kl"]
	for i, j in hjhg18
		keys = keys + i + " "
		values = values + j + " "
	end
	return keys == " ABdt Abd doDe ggq " && values == " m.jdfd 3.456 gheew abc "
end

def test_map_string_string_4 bool
	keys = " "
	values = " "
	for i, j ~in hjhg18
		keys = keys + i + " "
		values = values + j + " "
	end
	return keys == " ggq doDe Abd ABdt " && values == " abc gheew 3.456 m.jdfd "
end

def test_map_string_string_5 bool
	keys = " "
	values = " "
	hjhg18.delete("Abd")
	for i, j ~in hjhg18
		keys = keys + i + " "
		values = values + j + " "
	end
	return keys == " ggq doDe ABdt " && values == " abc gheew m.jdfd "
end

def test_map_float_real_1 bool
	hjhg19 = map[float]real{ 12.0625: 34.5, -3.125: 3.625, 5.25: -4.5 }
	a = hjhg19.count
	b = hjhg19[-3.125f]
	x = hjhg19[4.75f]
	c = hjhg19.count
	hjhg19[17.625f] = -23.5625
	d = hjhg19.count
	e = hjhg19[12.0625f]
	f = hjhg19[17.625f]
	return a == 3 && b == 3.625 && x == 0 && c == 3 && d == 4 && e == 34.5 && f == -23.5625
end

def test_map_real_float_1 bool
	hjhg19 = map[real]float{ 12.0625: 34.5, -3.125: 3.625, 5.25: -4.5 }
	a = hjhg19.count
	b = hjhg19[-3.125]
	x = hjhg19[4.75]
	c = hjhg19.count
	hjhg19[17.625] = -23.5625
	d0 = hjhg19.count
	hjhg19.delete(-3.125)
	d = hjhg19.count
	e = hjhg19[12.0625]
	f = hjhg19[17.625]
	return a == 3 && b == 3.625 && x == 0 && c == 3 && d0 == 4 && d == 3 && e == 34.5 && f == -23.5625
end

def test_map_int_string_1 bool
	hjhg20 = map[int]string{ 12: "abc", -3: "3.456", 5: "gheew" }
	a = hjhg20[4]
	b0 = hjhg20.count
	hjhg20[-2] = "KlErt"
	b = hjhg20.count
	c = hjhg20[5]
	d = hjhg20[-2]
	return a == "" && b0 == 3 && b == 4 && c == "gheew" && d == "KlErt"
end

def test_set_insert_1 bool
	ggdf16 = set[float]{ 12.0625, -3.125, 5.25 }
	a = ggdf16[-3.125f]
	b = ggdf16.count
	c = ggdf16[4.75f]
	d = ggdf16.count
	ggdf16.insert 45.375f
	e = ggdf16.count
	f = ggdf16[12.0625f]
	g45 = ggdf16[45.375f]
	return true a && b == 3 && !c && d == 3 && e == 4 && f && g45
end

def test_set_iteration_1 bool
	ggdf16 = set[string]{ "dkker", "34.234", "D65l_hj", "CaFFe_gh" }
	ggdf16.insert "Agh3"
	q = ggdf16.delete "D65l_hj"
	l = ggdf16.delete "Fewsd"
	s = " "
	for k in ggdf16
		s = s + k + " "
	end
	return s == " 34.234 Agh3 CaFFe_gh dkker " && q && !l
end

def string_by_ref(&s string) f64
	d = strtod(s, voidptr(0))
	s = "done"
	return d
end

def test_string_by_ref bool
	a = "-45.625"
	d = string_by_ref(a)
	return d == -45.625 && a == "done"
end

def string_by_val(s string) f64
	d = strtod(s, 0)
	return d
end

def test_string_by_val bool
	a = "3.57e3"
	d = string_by_val(a)
	return d == 3570 && a == "3.57e3"
end

