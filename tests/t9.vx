def QzztrP(k int) int
	if k < 0
		if k > 10
			p = 15
		else
			p = -13
		end
	else
		p = 23
	end
	return p
end

def test_nested_if_9 bool
	return QzztrP(3) == 23 && QzztrP(-43) == -13
end

def QzztrQ(k int) int
	if k < 0
		if k > -10
			p = 15
		else
			p = -13
		end
		return p
	else
		p = 23
		return p
	end
end

def test_nested_if_10 bool
	return QzztrQ(3) == 23 && QzztrQ(-5) == 15 && QzztrQ(-17) == -13
end

def dFkkL(n int, a []f64) f64
	# a[2] = 6 # this should trigger "variable 'a' is immutable"
	return n * a[n]
end

ukkL = 5

gggKl = [ukkL]f64{ 1.25, 2.5, 13.75, -4.0625, 5.125}

global LkfdS = dFkkL(3, gggKl)

def test_var_array_call_1 bool
	return LkfdS == -12.1875
end

def dFmmJ(n int, &c []f64) f64
	c[3] = 7.5
	return n * c[n]
end

global qHgDF = dFmmJ(2, gggKl)
global qHgDG = gggKl[3]

def test_var_array_call_2 bool
	return qHgDF == 27.5 && qHgDG == 7.5
end

pL2E = [ 2.625, 7.0625, -23.75 ]

def dFkkL2(n int, a []f64) f64
	z = dFkkL(4, a)
	# a[2] = 6 # this should trigger "variable 'a' is immutable"
	return n * z
end

global rrw3tz = -89.0625f
global lfdswe = 152.3 / 7
const kppo = 75234
const hjsq34 := 89.7 / 13

def test_string_interpolation_1 bool
	b = "abc->$rrw3tz<- j${lfdswe,0,7}"
	c = "$.{lfdswe,12,5}<-"
	return b == "abc->-89.0625<- j21.75714" && c == "    21.75714<-"
end

def test_string_interpolation_2 bool
	x = "op$%kppo, ${hjsq34,0,5}+"
	return x == "op0x125e2, 6.9+"
end
