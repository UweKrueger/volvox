def QzztrP(k int) int
	if k < 0
		if k > 10
			p = 15
		else
			p = -13
		end
	else
		p = 23
	end
	return p
end

def test_nested_if_9 bool
	return QzztrP(3) == 23 && QzztrP(-43) == -13
end

def QzztrQ(k int) int
	if k < 0
		if k > -10
			p = 15
		else
			p = -13
		end
		return p
	else
		p = 23
		return p
	end
end

def test_nested_if_10 bool
	return QzztrQ(3) == 23 && QzztrQ(-5) == 15 && QzztrQ(-17) == -13
end

def dFkkL(n int, a []f64) f64
	# a[2] = 6 # this should trigger "variable 'a' is immutable"
	return n * a[n]
end

ukkL = 5

gggKl = [ukkL]f64{ 1.25, 2.5, 13.75, -4.0625, 5.125}

global LkfdS = dFkkL(3, gggKl)

def test_var_array_call_1 bool
	return LkfdS == -12.1875
end

def dFmmJ(n int, &c []f64) f64
	c[3] = 7.5
	return n * c[n]
end

global qHgDF = dFmmJ(2, gggKl)
global qHgDG = gggKl[3]

def test_var_array_call_2 bool
	return qHgDF == 27.5 && qHgDG == 7.5
end

pL2E = [ 2.625, 7.0625, -23.75 ]

def dFkkL2(n int, a []f64) f64
	z = dFkkL(4, a)
	# a[2] = 6 # this should trigger "variable 'a' is immutable"
	return n * z
end

global rrw3tz = -89.0625f
global lfdswe = 152.3 / 7
const kppo = 75234
const hjsq34 := 89.7 / 13

def test_string_interpolation_1 bool
	b = "abc->$rrw3tz<- j${lfdswe,0,7}"
	c = "$.{lfdswe,12,5}<-"
	return b == "abc->-89.0625<- j21.75714" && c == "    21.75714<-"
end

def test_string_interpolation_2 bool
	x = "op$#%kppo, ${hjsq34,0,5}+"
	return x == "op0x125e2, 6.9+"
end

def test_signed_unsigned_comparison_1 bool
	gg = 0xa0000000U
	b = -17
	return gg > b
end

def test_signed_unsigned_comparison_2 bool
	gg = 3U
	b = 17
	return gg < b
end

def test_ternary_1 bool
	o = true ? 7 : 9
	p = false ? 5.3 : -17
	return o == 7 && p == -17 && sizeof p == 8
end

def lkceg(r int, a f64, b f32) f64
	q = r > 7 ? r + b : a
	return q
end

def test_ternary_2 bool
	x = lkceg(8, 12.3, -6.2)
	return x > 1.7999 && x < 1.8001
end

def test_ternary_3 bool
	x = lkceg(7, 12.0625, 17.3f)
	return x == 12.0625
end

def test_min_max_abs_1 bool
	a = 13.75
	b = -17.25
	c = min(a, b)
	d = max(a, b)
	e = abs a
	f = abs b
	return c == -17.25 && d == 13.75 && e == 13.75 && f == 17.25
end

def test_min_max_abs_2 bool
	a = 1389
	b = -1725
	c = min(a, b)
	d = max(a, b)
	e = abs a
	f = abs b
	return c == -1725 && d == 1389 && e == 1389 && f == 1725
end

def test_min_max_abs_3 bool
	a = 1389U
	b = 1725U
	c = min(a, b)
	d = max(a, b)
	return c == 1389 && d == 1725
end

interface QQwMYx {
	oper(x f64) i32
	ttz(a f64, b i32) f64
	oper(p string) f64
}

type HHnMYx {
	n i32
	p f64
	z f64
}

def HHnMYx.oper(x f64) i32
	return 2 * this.n + 3 * int(x)
end

def HHnMYx.oper(p string) f64
	return 20 * this.n
end

def HHnMYx.ttz(a f64, b i32) f64
	return a * this.n + b
end

type P4MYx {
	m i32
}

def P4MYx.oper(x f64) i32
	return i32(17 + x)
end

def P4MYx.oper(p string) f64
	return 19.0625
end

def P4MYx.ttz(a f64, b i32) f64
	return a * a - this.m + b
end

def g(x QQwMYx, m f64) f64
	uwq = x.ttz(m, 4)
	return 12.5 + uwq
end

def test_interface_1 bool
	r = HHnMYx{ n: 56, p: -33.5 }
	a = g(r, 34.25)
	return a == 1934.5
end

def test_interface_2 bool
	r = P4MYx{ m: 3 }
	a = g(r, 7.5)
	return a == 69.75
end

def ooo(i int, x QQwMYx) f64
	p = x.oper(i + 12.7)
	return p * 2.5
end

def test_interface_3 bool
	yc = HHnMYx{ n: 10, p: -1.5 }
	dd = ooo(7, yc)
	return dd == 192.5
end

interface QQwOi {
	oper i32
	ppt=f64
	ttz(ap f64, xx i32) f64
}

type HHnOi {
	n i32
	p f64
	z f64
}

def HHnOi.oper i32
	return 2 * this.n
end

def HHnOi.ttz(a f64, b i32) f64
	return a * this.p + b
end

def HHnOi.ppt f64
	return this.p + 1.25 + 0.125 * this.z
end

def HHnOi.ppt=(x f64) f64
	ret = this.p + this.z
	this.z = x - 0.5
	return ret
end

def gLgT(x QQwOi) bool
	p = x.ppt = 6.25
	q = x.ppt
	x.ppt = -3.5
	r = x.ppt
	#print(p,q,r)
	#oooo = "$p $q $r"
	return p == 3.25 && q == 5.46875 && r == 4.25
end

def test_interface_4 bool
	r = HHnOi{ n: 13, p: 3.5, z: -0.25 }
	return gLgT(r)
end

type HPnOi {
	u f64
	ppt f64
}

def HPnOi.oper i32
	return i32(2 * this.u)
end

def HPnOi.ttz(a f64, b i32) f64
	return this.ppt + 2.75
end

def g2LgT(x QQwOi) bool
	p = x.ppt = 6.25
	q = x.ppt
	x.ppt = -3.5
	r = x.ppt
	s = 7.3
	#oopp = "$s $p $q $r"
	#print(p,q,r)
	return p == 13.25 && q == 6.25 && r == -3.5
end

def test_interface_5 bool
	r44 = HPnOi{ u: -7.0625, ppt: 13.25 }
	return g2LgT(r44)
end

def klghju(x real, b real) real
	while x>b
		b += 1.0625
	brk b >= 5
		b += 0.25
	end
	return b
end

def test_1level_break_1 bool
	return klghju(25, 11) == 12.062500
end

def test_1level_break_2 bool
	return klghju(25, 0.5) == 5.5
end

def ttqwl(a int, b int) int
	if a >= 5
		if a > b
			a += 5
		elif a > 9
			b += 3
	brk brk a > 10
			return b
		else
			return 0
		end
		b += 13
	end
	return -857 + b
end

def test_2level_break_1 bool
	return ttqwl(11, 23) == -831
end

def test_2level_break_2 bool
	return ttqwl(10, 17) == 20
end

global wwqgh9 = 0

type LLMJ {
	x int
}

def ~LLMJ
	wwqgh9 += 3 + 2*this.x
	# print "Destuctor ${this.x}"
end

def nmntr(y int) int
	if y > 6
		if y > 10
			r = LLMJ{ x: 17 }
			# print "created ${r.x}"
		brk y > 12
			q = LLMJ{ x: 23 }
			# print "created ${q.x}"
		else
			r = LLMJ{ x: 19 }
			# print "created ${r.x}"
	brk brk y < 8
			# print "no brk"
			wwqgh9 += 100
			return 7
		end
		# print "intermediate"
		wwqgh9 += 1000
	end
	# print "Finish"
	wwqgh9 *= 2
	return 9
end

def test_multi_level_brk_destructors_1 bool
	t = nmntr 7
	return wwqgh9 == 82
end

wwqgh9 = 0

def test_multi_level_brk_destructors_2 bool
	t = nmntr 11
	return wwqgh9 == 2172 && t == 9
end

wwqgh9 = 0

def lwege(n int) LLMJ
	if n > 0
		Q = LLMJ{ x: 33 }
	else
		Q = LLMJ{ x: 47 }
	end
	return Q
end

def test_multi_level_brk_destructors_3 bool
	R = lwege(-6)
	res = wwqgh9 == 0
	return res
end

wwqgh9 = 0

def lwege2(n int) bool
	if n > 0
		Q = LLMJ{ x: 33 }
	else
		Q = LLMJ{ x: 47 }
	end
	res = wwqgh9 == 0
	return res
end

def test_multi_level_brk_destructors_4 bool
	R = lwege2(-6)
	return R
end

wwqgh9 = 0

def test_multi_level_brk_destructors_5 bool
	R = lwege2(7)
	return R
end
