ggwqljj = 7.3

if ggwqljj > 9
	uttw2 = 45u16
else
	uttw2 = 13u16
end

# printf("%hu\n", uttw2)

global uttw2_val = uttw2
global uttw2_sz = sizeof(uttw2)

fn test_outer_scope_branch_declaration_1 bool
	global uttw2_val, uttw2_sz
	return uttw2_val == 13 && uttw2_sz == 2

i93 = 7

if ggwqljj > 7.5
	LPPO = [5][i93+1][i93+2]real{1: {2: {3: -23.75}}}
else
	LPPO = [5][5][i93+7]real{1: {2: {3: 7.25}}}
end

# printf("%zu %zu %zu %f\n", LPPO.dim(0), LPPO.dim(1), LPPO.dim(2), LPPO[1][2][3])

