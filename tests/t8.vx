ggwqljj = 7.3

if ggwqljj > 9
	uttw2 = 45uH
else
	uttw2 = 13uH
end

# printf("%hu\n", uttw2)

global uttw2_val = uttw2
global uttw2_sz = sizeof(uttw2)

fn test_outer_scope_branch_declaration_1 bool
	global uttw2_val, uttw2_sz
	return uttw2_val == 13 && uttw2_sz == 2
end

i93 = 7

