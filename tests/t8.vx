ggwqljj = 7.3

if ggwqljj > 9
	uttw2 = 45u16
else
	uttw2 = 13u16
end

# printf("%hu\n", uttw2)

global uttw2_val = uttw2
global uttw2_sz = sizeof(uttw2)

fn test_outer_scope_branch_declaration_1 bool
	global uttw2_val, uttw2_sz
	return uttw2_val == 13 && uttw2_sz == 2

i93 = 7

if ggwqljj > 7.5
	LPPO = [5][i93+1][i93+2]real{1: {2: {3: -23.75}}}
else
	LPPO = [5][5][i93+7]real{1: {2: {3: 7.25}}}
end

# printf("%zu %zu %zu %f\n", LPPO.dim(0), LPPO.dim(1), LPPO.dim(2), LPPO[1][2][3])

if ggwqljj > 7
	LPPQ = [3][i93+1][8]real{1: {2: {3: -23.75}}}
else
	LPPQ = [i93+5][5][9]real{1: {2: {3: 7.25}}}
end

# printf("%zu %zu %zu %f\n", LPPQ.dim(0), LPPQ.dim(1), LPPQ.dim(2), LPPQ[1][2][3])

global LPPG1 = LPPO[1][2][3]
global LPPG2 = LPPQ[1][2][3]

fn test_outer_scope_branch_declaration_2 bool
	global LPPG1, LPPG2
	return LPPG1 == 7.25 && LPPG2 == -23.75

global yn210 = 15
global wn2 = 7

fn test_var_array_multi_level_ref bool
	global yn210, wn2
	vv = [yn210][13][wn2]f64{1: {12: {0: 78.25}}, 2: {5: {2: -17.125}}}
	# vv = [yn210][13][wn2]f64{2: {5: {2: -17.125}}, 1: {12: {0: 78.25}}}
	&pph = vv
	x = pph[2][5][2]
	y = pph[1][12][0]
	return x == -17.125 && y == 78.25 && pph.dim(1) == 13 && pph.dim(2) == 7

