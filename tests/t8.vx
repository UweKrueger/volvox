global yn210 = 15
global wn2 = 7

fn test_var_array_multi_level_ref bool
	global yn210, wn2
	vv = [yn210][13][wn2]f64{1: {12: {0: 78.25}}, 2: {5: {2: -17.125}}}
	# vv = [yn210][13][wn2]f64{2: {5: {2: -17.125}}, 1: {12: {0: 78.25}}}
	&pph = vv
	x = pph[2][5][2]
	y = pph[1][12][0]
	return x == -17.125 && y == 78.25 && pph.dim(1) == 13 && pph.dim(2) == 7
end

fn test_for_over_float_array_lit bool
	s = 0.
	for x in [1.25, 3.5, -7.125, 13.75]
		s += x
	end
	return s == 11.375
end

fn test_for_over_int_array_lit bool
	s = 0
	for x in [1, 3, -7, 13]
		s += x
	end
	return s == 10
end

global uugf94 = 7

fn test_ref_for_over_f64_array bool
	global uugf94
	s = 0.
	a = [uugf94]f64{ 1, 7, 9.5, 6: 45.75 }
	for &t in a
		s += t
		t += s
		# printf("%f\n", t)
	end
	return s == 63.25 && a[2] == 27
end

fn test_val_for_over_f64_array bool
	global uugf94
	s = 0.
	a = [uugf94]f64{ 1, 7, 9.5, 6: 45.75 }
	for t in a
		s += t
		t += s
		# printf("%f\n", t)
	end
	return s == 63.25 && a[2] == 9.5
end

fn test_existing_val_for_over_f64_array bool
	global uugf94
	s = 0.
	t = 3.2
	a = [uugf94]f64{ 1, 7, 9.5, 6: 45.75 }
	for t ~in a
		s += t
		# printf("%f\n", t)
		t += s
	end
	return s == 63.25 && a[2] == 9.5
end

global sjj2 = 0.
bjj2 = 27.3
ajj2 = [4, 8, 9, 2.5, 4.25]

for bjj2 in ajj2
	sjj2 += bjj2
	# printf("%g\n", bjj2)
end

fn test_global_scope_for_1 bool
	global sjj2
	return sjj2 == 27.75
end

fn test_map_iteration_1 bool
	hjhg7 = map[string]f64{ "ggs": 12, "ABd": -1.0625, "doDe": 2.25 }
	s = 0.
	for i ~in hjhg7
		s += i
		# printf("Value: >%g<\n", i)
	end
	return s == 13.1875
end

global ffsd93 = 0
hjhg9 = map[string]int{ "ggs": 12, "ABd": -123, "doDe": 2, "kkqw": 1000 }

for zew78 in hjhg9
	ffsd93 += zew78
	# printf("Value: >%d<\n", zwe78)
end

fn test_map_iteration_2 bool
	global ffsd93
	return ffsd93 == 891
end

fn test_map_iteration_3 bool
	hjhg7 = map[string]f64{ "ggs": 12, "ABd": -1.0625, "doDe": 2.25 }
	s = 0.
	for i in hjhg7
		s += i
		# printf("Value: >%g<\n", i)
	else
		i = 0.
	end
	# i should be the greatest value
	return s == 13.1875 && i == 12
end

fn test_map_iteration_4 bool
	hjhg7 = map[string]f64{ "ggs": 12, "ABd": -1.0625, "doDe": 2.25 }
	s = 0.
	for i ~in hjhg7
		s += i
		# printf("Value: >%g<\n", i)
	else
		i = 0.
	end
	# i should be the least value
	return s == 13.1875 && i == -1.0625
end

fn string_by_ref(&s string) f64
	d = strtod(s, voidptr(0))
	s = "done"
	return d
end

fn test_string_by_ref bool
	a = "-45.625"
	d = string_by_ref(a)
	return d == -45.625 && a == "done"
end

fn string_by_val(s string) f64
	d = strtod(s, 0)
	return d
end

fn test_string_by_val bool
	a = "3.57e3"
	d = string_by_val(a)
	return d == 3570 && a == "3.57e3"
end

pfhl4 = 4

xkj56 = [pfhl4]f64{3.75, 6.25, 8, 7.125}

oxgh4 = xkj56

oxgh4[1] = -17.25

global uuzzt67 = xkj56[1] == 6.25 && oxgh4[1] == -17.25 && oxgh4[3] == 7.125

fn test_main_array_copy_constructor bool
	global uuzzt67
	return uuzzt67
end

fn test_char_literal bool
	c1 = '@'
	c2 = '\n'
	return c1 == 64 && c2 == 10 && sizeof(c1) == 1 && sizeof(c2) == 1
end
