<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE language>
<language name="Volvox" version="1" kateversion="5.53" indenter="volvox" style="volvox"
          section="Sources" extensions="*.vx;" mimetype="text/x-volvox"
          author="Uwe Krüger (uwe_debbug@arcor.de)" license="MIT">

  <highlighting>

    <list name="keywords">
      <item>chan</item>
      <item>set</item>
      <item>map</item>
      <item>self</item>
      <item>packed</item>
      <item>union</item>
      <item>const</item>
      <item>unique</item>
      <item>obj</item>
      <item>shared</item>
      <item>atomic</item>
      <item>global</item>
      <item>pub</item>
      <item>as</item>
      <item>from</item>
      <item>import</item>
      <item>struct</item>
      <item>cstruct</item>
      <item>interface</item>
      <item>decl</item>
      <item>cdecl</item>
      <item>delete</item>
      <item>inline</item>
      <item>thread</item>
      <item>clone</item>
      <item>init</item>
    </list>

    <list name="startcontrol">
      <item>def</item>
      <item>cdef</item>
      <item>for</item>
      <item>if</item>
      <item>while</item>
      <item>repeat</item>
      <item>lock</item>
    </list>

    <list name="elsecontrol">
      <item>else</item>
      <item>elif</item>
      <item>brk</item>
    </list>

    <list name="endcontrol">
      <item>until</item>
      <item>end</item>
    </list>

    <list name="operators">
      <item>in</item>
      <item>return</item>
    </list>

    <list name="types">
      <item>int</item>
      <item>unsigned</item>
      <item>size_t</item>
      <item>ssize_t</item>
      <item>real</item>
      <item>bool</item>
      <item>i8</item>
      <item>i16</item>
      <item>i32</item>
      <item>i64</item>
      <item>u8</item>
      <item>u16</item>
      <item>u32</item>
      <item>u64</item>
      <item>f16</item>
      <item>f32</item>
      <item>f64</item>
      <item>string</item>
      <item>cstring</item>
      <item>voidptr</item>
    </list>

    <list name="constants">
      <item>true</item>
      <item>false</item>
      <item>nil</item>
    </list>

    <list name="builtinfuncs">
      <item>dim</item>
      <item>order</item>
      <item>abs</item>
      <item>min</item>
      <item>max</item>
      <item>exit</item>
      <item>sizeof</item>
      <item>panic</item>
    </list>

    <contexts>
      <context name="Normal" attribute="Normal Text" lineEndContext="#stay">
        <DetectSpaces/>
        <DetectChar attribute="Comment" context="HashComment" char="#"/>
        <DetectChar attribute="String" context="String" char="&quot;"/>
        <HlCChar attribute="Character" context="#stay"/>
        <keyword attribute="Operator" context="#stay" String="operators"/>
        <keyword attribute="Keyword" context="#stay" String="keywords"/>
        <keyword attribute="Type" context="#stay" String="types"/>
        <keyword attribute="Constant" context="#stay" String="constants"/>
        <keyword attribute="BuiltinFunction" context="#stay" String="builtinfuncs"/>
        <keyword attribute="Keyword" context="#stay" beginRegion="CondRegion" String="startcontrol"/>
        <keyword attribute="Keyword" context="#stay" endRegion="CondRegion" String="endcontrol"/>
        <keyword attribute="Keyword" context="#stay" endRegion="CondRegion" beginRegion="CondRegion" String="elsecontrol"/>
        <DetectChar attribute="Symbols" context="#stay" beginRegion="data" char="{"/>
        <DetectChar attribute="Symbols" context="#stay" endRegion="data" char="}"/>
        <HlCHex attribute="Hex" context="#stay"/>
        <Float attribute="Real" context="#stay"/>
        <HlCOct attribute="Oct" context="#stay"/>
        <Int attribute="Integer" context="#stay"/>
      </context>

      <context attribute="String" lineEndContext="#stay" name="String">
        <DetectChar attribute="String" context="#pop" char="&quot;"/>
      </context>

      <context attribute="Character" lineEndContext="#stay" name="Character">
        <DetectChar attribute="Character" context="#pop" char="'"/>
      </context>

      <context attribute="Comment" lineEndContext="#pop" name="HashComment">
      </context>
    </contexts>

    <itemDatas>
      <itemData name="Normal Text" defStyleNum="dsNormal"/>
      <itemData name="Keyword" defStyleNum="dsKeyword"/>
      <itemData name="Operator" defStyleNum="dsOperator"/>
      <itemData name="Type" defStyleNum="dsDataType"/>
      <itemData name="Integer" defStyleNum="dsDecVal"/>
      <itemData name="Real" defStyleNum="dsFloat"/>
      <itemData name="Oct" defStyleNum="dsBaseN"/>
      <itemData name="Hex" defStyleNum="dsBaseN"/>
      <itemData name="Constant" defStyleNum="dsDecVal"/>
      <itemData name="String" defStyleNum="dsString"/>
      <itemData name="Character" defStyleNum="dsChar"/>
      <itemData name="BuiltinFunction" defStyleNum="dsBuiltIn"/>
      <itemData name="Comment" defStyleNum="dsComment"/>
    </itemDatas>
  </highlighting>
  
  <general>
    <comments>
      <comment name="singleLine" start="#"/>
    </comments>
    <keywords casesensitive="1"/>
  </general>
  
</language>
<!-- kate: replace-tabs off; tab-width 4; indent-width 4; -->
